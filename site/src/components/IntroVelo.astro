---
/**
 * Intro di apertura: il logo si COSTRUISCE sul velo scuro, poi il velo
 * sale e scopre l'hero (docs/DECISIONI-DESIGN-gaia.md + richiesta 15/10).
 *
 * Sequenza (GSAP, totale ~4,5-5 s; tutti i tempi nell'oggetto TEMPI):
 *  1. il ghirigoro si disegna come tracciato a penna: maschera con i path
 *     guida (scheletro del tratto) animati in stroke-dashoffset;
 *  2. "EVENTS" lettera per lettera, dall'80% del ghirigoro;
 *  3. "Gaia Crognale" in dissolvenza;
 *  4. riga di prestigio + sottoriga sfalsata;
 *  5. pausa con il logo completo fermo, poi il velo sale.
 *
 * Regole: solo prima visita della sessione (sessionStorage), saltabile con
 * clic/tasto, spenta con prefers-reduced-motion, overlay che non blocca il
 * rendering dell'hero sottostante (LCP compreso).
 *
 * Confronto varianti: ?velo=notte|bordeaux|grigio|salvia forza la tinta da
 * URL (serve alla styleguide; innocuo altrove).
 */
import type { Lang } from '../config/site';
import LogoGaia from './LogoGaia.astro';

interface Props {
  /** Colore del velo: salvia (default, scelta del 15/10), inchiostro
      profondo, bordeaux profondo o grigio caldo — tutti token di
      global.css. Le altre tinte restano per il confronto via ?velo=. */
  tinta?: 'notte' | 'bordeaux' | 'grigio' | 'salvia';
  lang?: Lang;
}

const { tinta = 'salvia', lang = 'it' } = Astro.props;

const RIGA: Record<Lang, string> = {
  it: 'Wedding & Event Planner · Roma',
  en: 'Wedding & Event Planner · Rome, Italy',
};
const SOTTORIGA = 'Italia · Destination Weddings';
---

<div id="intro-velo" data-tinta={tinta} aria-hidden="true">
  <div class="velo-scena">
    <span class="velo-logo"><LogoGaia animabile /></span>
    <p class="velo-riga">{RIGA[lang]}</p>
    <p class="velo-sottoriga">{SOTTORIGA}</p>
  </div>
</div>

{/* Inline e subito dopo il velo: decide PRIMA del primo paint se mostrarlo,
    così chi l'ha già visto non vede neanche un frame di velo. */}
<script is:inline>
  (() => {
    var velo = document.getElementById('intro-velo');
    if (!velo) return;
    var vista = false;
    try {
      vista = sessionStorage.getItem('gaia-intro-vista') === '1';
    } catch (e) {
      /* storage bloccato: l'intro parte, ma senza memoria */
    }
    var riduci = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (vista || riduci) {
      velo.remove();
      return;
    }
    var forzata = new URLSearchParams(location.search).get('velo');
    if (['notte', 'bordeaux', 'grigio', 'salvia'].indexOf(forzata) !== -1) {
      velo.setAttribute('data-tinta', forzata);
    }
    velo.setAttribute('data-attivo', '');
  })();
</script>

<script>
  import { gsap } from 'gsap';

  const velo = document.getElementById('intro-velo');

  function ricorda(): void {
    try {
      sessionStorage.setItem('gaia-intro-vista', '1');
    } catch {
      /* niente storage, pazienza */
    }
  }

  if (velo && !velo.hasAttribute('data-attivo')) {
    // L'inline script non l'ha attivato (e non l'ha rimosso): via subito.
    velo.remove();
  } else if (velo) {
    const fine = (): void => {
      ricorda();
      velo.remove();
    };

    const guide = [...velo.querySelectorAll<SVGPathElement>('.velo-guida')];
    const copertura = velo.querySelector<SVGRectElement>('.velo-copertura');
    const lettere = velo.querySelectorAll<SVGPathElement>('.logo-lettera');
    const firma = velo.querySelector<SVGGElement>('.logo-firma');
    const ghirigoro = velo.querySelector<SVGGElement>('.logo-ghirigoro');
    const riga = velo.querySelector<HTMLElement>('.velo-riga');
    const sottoriga = velo.querySelector<HTMLElement>('.velo-sottoriga');

    // Tutti i tempi dell'intro in un punto solo (secondi, salvo nota).
    const TEMPI = {
      avvio: 0.05,
      ghirigoro: 1.8, // disegno completo del tratto
      lettereAvvioFrazione: 0.8, // EVENTS parte all'80% del ghirigoro
      lettera: 0.6,
      lettereStagger: 0.12,
      firma: 0.8,
      riga: 0.8,
      sottorigaSfalso: 0.2,
      pausa: 0.8, // logo completo, fermo
      velo: 1.1, // salita del velo
      sicurezzaMs: 7000, // rete di sicurezza
    };

    // Posizioni derivate: la firma entra sulla coda delle lettere, la riga
    // subito dopo, e la pausa parte quando anche la sottoriga è a posto.
    const tLettere = TEMPI.avvio + TEMPI.ghirigoro * TEMPI.lettereAvvioFrazione;
    const tFirma = tLettere + TEMPI.lettera * 0.5;
    const tRiga = tFirma + 0.15;
    const tSottoriga = tRiga + TEMPI.sottorigaSfalso;
    const tVelo = tSottoriga + TEMPI.riga + TEMPI.pausa;

    const tl = gsap.timeline({ onComplete: fine, defaults: { ease: 'power2.out' } });

    // 1 — il ghirigoro si disegna (dashoffset sui path guida della maschera):
    // prima il cammino principale, poi i rami residui, tutto dentro
    // TEMPI.ghirigoro; la copertura chiude la maschera sugli ultimi residui.
    for (const guida of guide) {
      const lunghezza = guida.getTotalLength();
      gsap.set(guida, { strokeDasharray: lunghezza, strokeDashoffset: lunghezza });
    }
    if (ghirigoro) tl.set(ghirigoro, { opacity: 1 }, 0);
    if (guide.length > 0) {
      tl.to(
        guide[0],
        { strokeDashoffset: 0, duration: TEMPI.ghirigoro * 0.75, ease: 'power2.inOut' },
        TEMPI.avvio,
      );
      tl.to(
        guide.slice(1),
        {
          strokeDashoffset: 0,
          duration: TEMPI.ghirigoro * 0.2,
          ease: 'power2.out',
          stagger: 0.06,
        },
        TEMPI.avvio + TEMPI.ghirigoro * 0.7,
      );
    }
    if (copertura) {
      tl.to(copertura, { opacity: 1, duration: 0.25 }, TEMPI.avvio + TEMPI.ghirigoro * 0.85);
    }

    // 2 — EVENTS lettera per lettera. I path hanno già un translate proprio
    // (è la loro posizione): i tween devono essere RELATIVI, altrimenti GSAP
    // sostituisce quel translate e le lettere saltano via.
    tl.to(
      lettere,
      { opacity: 1, y: '-=80', duration: TEMPI.lettera, stagger: TEMPI.lettereStagger },
      tLettere,
    );

    // 3 — la firma in dissolvenza
    if (firma) tl.to(firma, { opacity: 1, duration: TEMPI.firma }, tFirma);

    // 4 — riga di prestigio e sottoriga, sfalsate
    if (riga) tl.to(riga, { opacity: 1, y: 0, duration: TEMPI.riga }, tRiga);
    // Su salvia la sottoriga è bianca a ~0.85, non piena: il tween deve
    // fermarsi lì, altrimenti lo stile inline vince sul CSS.
    const opacitaSottoriga = velo.getAttribute('data-tinta') === 'salvia' ? 0.85 : 1;
    if (sottoriga) {
      tl.to(sottoriga, { opacity: opacitaSottoriga, duration: TEMPI.riga }, tSottoriga);
    }

    // 5 — pausa con il logo completo fermo, poi il velo sale
    tl.to(velo, { yPercent: -101, duration: TEMPI.velo, ease: 'power3.inOut' }, tVelo);

    // GSAP parte dopo il primo paint: gli stati iniziali nascosti li mette
    // il CSS sotto [data-attivo], qui si aggiunge solo l'offset di partenza
    // (~13px visivi, relativo al translate che ogni lettera già porta).
    gsap.set(lettere, { y: '+=80' });

    // Un clic o un tasto qualsiasi salta tutto.
    const salta = (): void => {
      tl.progress(1); // onComplete fa il resto
    };
    velo.addEventListener('click', salta, { once: true });
    window.addEventListener('keydown', salta, { once: true });

    // Rete di sicurezza: qualunque cosa succeda, il velo non resta mai.
    window.setTimeout(() => {
      if (document.getElementById('intro-velo')) fine();
    }, TEMPI.sicurezzaMs);
  }
</script>

<style>
  #intro-velo {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: none;
    place-items: center;
    background: var(--color-notte);
    color: var(--color-avorio-su-notte);
    cursor: pointer;
    will-change: transform;
  }

  #intro-velo[data-tinta='bordeaux'] {
    background: var(--color-bordeaux-notte);
  }

  #intro-velo[data-tinta='grigio'] {
    background: var(--color-grigio-caldo);
  }

  #intro-velo[data-tinta='salvia'] {
    background: var(--color-salvia);
    /* Sul salvia il pesca si perde (~1,7:1): ghirigoro bianco come il
       testo, solo qui nell'intro. Fuori dall'intro il logo resta com'è. */
    --logo-accento: currentColor;
  }

  /* Solo il colore: l'opacità finale (0,85) la mette il tween GSAP,
     altrimenti questa regola, più specifica, scavalcherebbe lo stato
     iniziale nascosto e la sottoriga apparirebbe subito. */
  #intro-velo[data-tinta='salvia'] .velo-sottoriga {
    color: var(--color-avorio-su-notte);
  }

  #intro-velo[data-attivo] {
    display: grid;
  }

  .velo-scena {
    display: grid;
    justify-items: center;
    gap: 1.4rem;
    padding: 1.5rem;
    text-align: center;
  }

  /* Stati iniziali: nel CSS (non in GSAP) così non c'è nessun frame col
     logo già completo prima che la timeline parta. */
  #intro-velo[data-attivo] :global(.logo-ghirigoro) {
    opacity: 0;
  }

  #intro-velo[data-attivo] :global(.logo-lettera) {
    opacity: 0;
  }

  #intro-velo[data-attivo] :global(.logo-firma) {
    opacity: 0;
  }

  .velo-riga,
  .velo-sottoriga {
    margin: 0;
    opacity: 0;
  }

  /* Con il letter-spacing largo l'ultimo carattere si porta dietro il suo
     tracking: il margin-right negativo pari al tracking lo compensa, così
     il testo resta centrato otticamente. */
  .velo-riga {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    margin-right: -0.26em;
    text-transform: uppercase;
    transform: translateY(10px);
  }

  .velo-sottoriga {
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    margin-right: -0.3em;
    text-transform: uppercase;
    color: var(--color-velato-su-notte);
  }

  @media (max-width: 40rem) {
    .velo-riga {
      font-size: 0.6rem;
      letter-spacing: 0.2em;
      margin-right: -0.2em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #intro-velo {
      display: none !important;
    }
  }
</style>
