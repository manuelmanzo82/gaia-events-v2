---
/**
 * Intro di apertura: il logo si COSTRUISCE su un velo avorio, poi logo e
 * righe svaniscono e il velo sale a scoprire l'hero
 * (docs/DECISIONI-DESIGN-gaia.md — scelta definitiva del 16/10).
 *
 * Sequenza (GSAP, tutti i tempi nell'oggetto TEMPI):
 *  1. il ghirigoro si disegna come tracciato a penna: maschera con i path
 *     guida (scheletro del tratto) animati in stroke-dashoffset;
 *  2. "EVENTS" lettera per lettera, dall'80% del ghirigoro;
 *  3. "Gaia Crognale" in dissolvenza;
 *  4. riga di prestigio + sottoriga sfalsata;
 *  5. pausa a logo fermo, poi l'uscita in due tempi: logo e righe salgono
 *     di qualche px e svaniscono, quindi il velo sale — così lo stacco si
 *     legge anche su fondo chiaro.
 *
 * Il logo resta nei suoi colori originali: ghirigoro pesca, testo in
 * inchiostro. Regole: solo prima visita della sessione (sessionStorage),
 * saltabile con clic/tasto, spenta con prefers-reduced-motion, overlay che
 * non blocca il rendering dell'hero sottostante (LCP compreso).
 *
 * RICHIEDE lo snippet inline nel <head> della pagina (vedi styleguide.astro,
 * da spostare in BaseLayout quando l'intro andrà sulla home): decide prima
 * del primo paint se il velo è visibile, mettendo la classe con-intro su
 * <html>. Lì vive anche il flag INTRO_SEMPRE della modalità testing.
 * Senza snippet il velo resta nascosto e viene rimosso dal DOM.
 */
import type { Lang } from '../config/site';
import LogoGaia from './LogoGaia.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'it' } = Astro.props;

const RIGA: Record<Lang, string> = {
  it: 'Wedding & Event Planner · Roma',
  en: 'Wedding & Event Planner · Rome, Italy',
};
const SOTTORIGA = 'Italia · Destination Weddings';
---

<div id="intro-velo" aria-hidden="true">
  <div class="velo-scena">
    <span class="velo-logo"><LogoGaia animabile /></span>
    <p class="velo-riga">{RIGA[lang]}</p>
    <p class="velo-sottoriga">{SOTTORIGA}</p>
  </div>
</div>

<script>
  // GSAP con un import dinamico (giro 8): il velo è già visibile dal CSS e
  // il disegno del logo parte appena GSAP è arrivato, senza che la sua
  // richiesta preceda il primo paint.
  import type { gsap as Gsap } from 'gsap';

  const velo = document.getElementById('intro-velo');

  function ricorda(): void {
    try {
      sessionStorage.setItem('gaia-intro-vista', '1');
    } catch {
      /* niente storage, pazienza */
    }
  }

  if (velo && !document.documentElement.classList.contains('con-intro')) {
    // Lo snippet in <head> non l'ha attivata (già vista, reduced-motion o
    // snippet assente): il velo è già nascosto dal CSS, via dal DOM.
    velo.remove();
  } else if (velo) {
    void import('gsap').then(({ gsap }) => avvia(velo, gsap));
  }

  function avvia(velo: HTMLElement, gsap: typeof Gsap): void {
    const fine = (): void => {
      ricorda();
      window.removeEventListener('keydown', salta);
      velo.remove();
      // Chi aspetta la fine dell'intro (la dissolvenza dell'hero) parte ora.
      document.dispatchEvent(new CustomEvent('gaia:intro-fine'));
    };

    const guide = [...velo.querySelectorAll<SVGPathElement>('.velo-guida')];
    const copertura = velo.querySelector<SVGRectElement>('.velo-copertura');
    const lettere = velo.querySelectorAll<SVGPathElement>('.logo-lettera');
    const firma = velo.querySelector<SVGGElement>('.logo-firma');
    const ghirigoro = velo.querySelector<SVGGElement>('.logo-ghirigoro');
    const riga = velo.querySelector<HTMLElement>('.velo-riga');
    const sottoriga = velo.querySelector<HTMLElement>('.velo-sottoriga');
    const scena = velo.querySelector<HTMLElement>('.velo-scena');

    // Tutti i tempi dell'intro in un punto solo (secondi, salvo nota).
    const TEMPI = {
      avvio: 0.05,
      ghirigoro: 1.8, // disegno completo del tratto
      lettereAvvioFrazione: 0.8, // EVENTS parte all'80% del ghirigoro
      lettera: 0.6,
      lettereStagger: 0.12,
      firma: 0.8,
      riga: 0.8,
      sottorigaSfalso: 0.2,
      pausa: 0.8, // logo completo, fermo
      uscitaScena: 0.5, // logo e righe salgono e svaniscono
      uscitaSalitaPx: 18, // di quanto sale la scena uscendo
      velo: 1.1, // salita del velo
      sicurezzaMs: 7000, // rete di sicurezza
    };

    // Posizioni derivate: la firma entra sulla coda delle lettere, la riga
    // subito dopo; dopo la pausa esce prima la scena, poi sale il velo.
    const tLettere = TEMPI.avvio + TEMPI.ghirigoro * TEMPI.lettereAvvioFrazione;
    const tFirma = tLettere + TEMPI.lettera * 0.5;
    const tRiga = tFirma + 0.15;
    const tSottoriga = tRiga + TEMPI.sottorigaSfalso;
    const tUscita = tSottoriga + TEMPI.riga + TEMPI.pausa;
    const tVelo = tUscita + TEMPI.uscitaScena;

    const tl = gsap.timeline({ onComplete: fine, defaults: { ease: 'power2.out' } });

    // 1 — il ghirigoro si disegna (dashoffset sui path guida della maschera):
    // prima il cammino principale, poi i rami residui, tutto dentro
    // TEMPI.ghirigoro; la copertura chiude la maschera sugli ultimi residui.
    // Due accorgimenti perché a t=0 il velo sia DAVVERO vuoto:
    //  - dasharray/dashoffset con 2 unità di margine: getTotalLength può
    //    stare sotto la lunghezza resa e la differenza spunterebbe subito;
    //  - ogni guida resta a opacity 0 (CSS) finché il suo tween non parte,
    //    così nessun residuo del tratto può apparire prima del tempo.
    for (const guida of guide) {
      const lunghezza = guida.getTotalLength() + 2;
      gsap.set(guida, { strokeDasharray: lunghezza, strokeDashoffset: lunghezza });
    }
    if (ghirigoro) tl.set(ghirigoro, { opacity: 1 }, 0);
    if (guide.length > 0) {
      tl.set(guide[0], { opacity: 1 }, TEMPI.avvio);
      tl.to(
        guide[0],
        { strokeDashoffset: 0, duration: TEMPI.ghirigoro * 0.75, ease: 'power2.inOut' },
        TEMPI.avvio,
      );
      guide.slice(1).forEach((ramo, i) => {
        const partenza = TEMPI.avvio + TEMPI.ghirigoro * 0.7 + i * 0.06;
        tl.set(ramo, { opacity: 1 }, partenza);
        tl.to(
          ramo,
          { strokeDashoffset: 0, duration: TEMPI.ghirigoro * 0.2, ease: 'power2.out' },
          partenza,
        );
      });
    }
    if (copertura) {
      tl.to(copertura, { opacity: 1, duration: 0.25 }, TEMPI.avvio + TEMPI.ghirigoro * 0.85);
    }

    // 2 — EVENTS lettera per lettera. I path hanno già un translate proprio
    // (è la loro posizione): i tween devono essere RELATIVI, altrimenti GSAP
    // sostituisce quel translate e le lettere saltano via.
    tl.to(
      lettere,
      { opacity: 1, y: '-=80', duration: TEMPI.lettera, stagger: TEMPI.lettereStagger },
      tLettere,
    );

    // 3 — la firma in dissolvenza
    if (firma) tl.to(firma, { opacity: 1, duration: TEMPI.firma }, tFirma);

    // 4 — riga di prestigio e sottoriga, sfalsate
    if (riga) tl.to(riga, { opacity: 1, y: 0, duration: TEMPI.riga }, tRiga);
    if (sottoriga) tl.to(sottoriga, { opacity: 1, duration: TEMPI.riga }, tSottoriga);

    // 5 — pausa a logo fermo, poi l'uscita in due tempi: su fondo chiaro il
    // velo che sale da solo non si leggerebbe, quindi prima escono logo e
    // righe, poi sale il velo.
    if (scena) {
      tl.to(
        scena,
        { opacity: 0, y: -TEMPI.uscitaSalitaPx, duration: TEMPI.uscitaScena, ease: 'power2.in' },
        tUscita,
      );
    }
    tl.to(velo, { yPercent: -101, duration: TEMPI.velo, ease: 'power3.inOut' }, tVelo);

    // GSAP parte dopo il primo paint: gli stati iniziali nascosti li mette
    // il CSS sotto [data-attivo], qui si aggiunge solo l'offset di partenza
    // (~13px visivi, relativo al translate che ogni lettera già porta).
    gsap.set(lettere, { y: '+=80' });

    // Un clic o un tasto qualsiasi salta tutto — ma solo se è un gesto
    // intenzionale: l'Invio ancora premuto dalla barra degli indirizzi
    // arriva qui in auto-repeat appena la pagina carica e salterebbe
    // l'intro da solo (visto sullo staging: velo per un istante e via).
    // Quindi niente auto-repeat e una grazia di 600 ms dall'avvio.
    const attivoDa = performance.now();
    function salta(event: Event): void {
      if ((event as KeyboardEvent).repeat) return;
      if (performance.now() - attivoDa < 600) return;
      tl.progress(1); // onComplete fa il resto, listener compresi
    }
    velo.addEventListener('click', salta);
    window.addEventListener('keydown', salta);

    // Rete di sicurezza: qualunque cosa succeda, il velo non resta mai.
    window.setTimeout(() => {
      if (document.getElementById('intro-velo')) fine();
    }, TEMPI.sicurezzaMs);
  }
</script>

<style>
  #intro-velo {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: none;
    place-items: center;
    background: var(--color-avorio);
    color: var(--color-inchiostro);
    cursor: pointer;
    will-change: transform;
  }

  /* Lo stato iniziale lo decide lo snippet in <head> PRIMA del primo paint
     (classe con-intro su <html>): niente lampo del velo quando non deve
     apparire, né della pagina quando deve. */
  :global(html.con-intro) #intro-velo {
    display: grid;
  }

  .velo-scena {
    --logo-h: 112px;
    display: grid;
    justify-items: center;
    gap: 1.4rem;
    /* Larghezza fissa: se fosse larga quanto il testo, al caricamento del
       webfont la riga cambierebbe di qualche pixel e tutta la scena si
       ricentrerebbe (CLS 0,06 su desktop). Così si muove solo la riga. */
    width: min(100% - 3rem, 30rem);
    padding: 1.5rem;
    text-align: center;
  }

  /* Stati iniziali: nel CSS (non in GSAP) così non c'è nessun frame col
     logo già completo prima che la timeline parta. */
  #intro-velo :global(.logo-ghirigoro) {
    opacity: 0;
  }

  #intro-velo :global(.logo-lettera) {
    opacity: 0;
  }

  #intro-velo :global(.logo-firma) {
    opacity: 0;
  }

  /* Le guide della maschera partono invisibili: ognuna si accende solo
     quando il suo tween comincia, così nessun pezzo di tratto (cappucci,
     code di dashoffset) può comparire prima del tempo. */
  #intro-velo :global(.velo-guida) {
    opacity: 0;
  }

  .velo-riga,
  .velo-sottoriga {
    margin: 0;
    opacity: 0;
  }

  /* Con il letter-spacing largo l'ultimo carattere si porta dietro il suo
     tracking: il margin-right negativo pari al tracking lo compensa, così
     il testo resta centrato otticamente. */
  .velo-riga {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    margin-right: -0.26em;
    text-transform: uppercase;
    transform: translateY(10px);
  }

  .velo-sottoriga {
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    margin-right: -0.3em;
    text-transform: uppercase;
    color: var(--color-grigio-caldo);
  }

  @media (max-width: 40rem) {
    .velo-riga {
      font-size: 0.6rem;
      letter-spacing: 0.2em;
      margin-right: -0.2em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #intro-velo {
      display: none !important;
    }
  }
</style>
