---
import { DEFAULT_LANG, type Lang } from '../../config/site';
import { formatDate, useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { availableLangs, getPage, getPosts, pick, text } from '../../lib/content';
import { breadcrumbs } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const page = getPage('blog');
const langs = page ? availableLangs(page, ['title']) : [DEFAULT_LANG];

// Nella v1 l'indice leggeva Sanity + un file locale e gli articoli solo il
// file: un articolo nuovo restava senza pagina. Qui la fonte è una sola.
const posts = getPosts()
  .map((post) => ({ post, slug: pick(post.slug, lang) }))
  .filter((entry) => entry.slug && text(entry.post.title, lang));

const title = text(page?.title, lang) || t('nav.blog');

const meta = buildMeta({
  lang,
  routeKey: 'blog',
  title,
  description: text(page?.intro, lang),
  seo: page ?? undefined,
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: title, href: path('blog', lang) },
];
---

<BaseLayout
  lang={lang}
  routeKey="blog"
  meta={meta}
  availableLangs={langs}
  jsonLd={[breadcrumbs(crumbs)]}
  crumbs={crumbs}
>
  <h1>{title}</h1>
  {text(page?.intro, lang) && <p>{text(page?.intro, lang)}</p>}

  {posts.length === 0 && <p>{t('common.empty')}</p>}

  {
    posts.map(({ post, slug }) => (
      <article>
        <h2><a href={path('blog', lang, slug!)}>{text(post.title, lang)}</a></h2>
        <p>
          <time datetime={post.date}>{formatDate(post.date, lang)}</time>
          {post.readingTime > 0 && <span> — {post.readingTime} {t('common.readingTime')}</span>}
        </p>
        <p>{text(post.excerpt, lang)}</p>
        <p><a href={path('blog', lang, slug!)}>{t('cta.readMore')}</a></p>
      </article>
    ))
  }
</BaseLayout>
