---
/**
 * Magazine, indice (/magazine/ ↔ /en/magazine/). Taglio da rivista:
 *
 *  1. Apertura — «Magazine» enorme, sottotitolo, filtri per categoria
 *  2. In evidenza — l'articolo marcato dal back office o l'ultimo
 *  3. Griglia — ritmo da rivista: una grande e due piccole, poi l'inverso
 *  4. Chiusura — CtaFinale con magazine.photos.cta
 *
 * Filtro ?categoria= lato client con fallback a link (vedi Apertura).
 * Effetti in scripts/magazine-effetti.ts dopo il motion di base.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { existsIn, langsFor } from '../../lib/availability';
import { getPage, getPostCategories, getSettings, text } from '../../lib/content';
import { breadcrumbs } from '../../lib/jsonld';
import { categoriaSlug, inEvidenza, postsIn } from '../../lib/magazine';
import { buildMeta } from '../../lib/seo';
import CtaFinale from '../home/CtaFinale.astro';
import Apertura from '../magazine/Apertura.astro';
import Griglia from '../magazine/Griglia.astro';
import InEvidenza from '../magazine/InEvidenza.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const page = getPage('blog');
const langs = langsFor('blog');
const posts = postsIn(lang);

const title = text(page?.title, lang) || t('nav.blog');
const sottotitolo = text(page?.intro, lang);

// Filtri: solo le categorie con almeno un articolo in questa lingua.
const usate = new Set(posts.map((p) => categoriaSlug(p, lang)).filter(Boolean));
const categorie = getPostCategories()
  .map((c) => ({ slug: text(c.slug, lang), nome: text(c.name, lang) }))
  .filter((c) => c.slug && c.nome && usate.has(c.slug));

const meta = buildMeta({
  lang,
  routeKey: 'blog',
  title,
  description: sottotitolo,
  seo: page ?? undefined,
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: title, href: path('blog', lang) },
];
const evidenza = inEvidenza(posts);
const altri = posts.filter((p) => p !== evidenza);
const rss = existsIn('blog', lang) ? `${path('blog', lang)}rss.xml` : null;
---

<BaseLayout lang={lang} routeKey="blog" meta={meta} availableLangs={langs} jsonLd={[breadcrumbs(crumbs)]} largo>
  {rss && <link slot="head" rel="alternate" type="application/rss+xml" title={`${title} — Gaia Events`} href={rss} />}

  <Apertura lang={lang} titolo={title} sottotitolo={sottotitolo} categorie={categorie} />

  <InEvidenza lang={lang} post={evidenza} />

  <Griglia lang={lang} posts={altri} />

  <CtaFinale lang={lang} settings={getSettings()} foto={getSettings().magazine?.photos?.cta ?? null} lato="destra" />
</BaseLayout>

<script>
  // Effetti della pagina dopo il motion di base (GSAP già caricato).
  document.addEventListener(
    'gaia:motion-pronta',
    () => {
      void import('../../scripts/magazine-effetti').then(({ initMagazineEffetti }) => initMagazineEffetti());
    },
    { once: true },
  );
</script>
