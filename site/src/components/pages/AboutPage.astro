---
/**
 * Chi sono (/chi-sono/ ↔ /en/about/), fase 4.2. Riferimento di ritmo:
 * sarahhaywood.com/about, reinterpretato per una planner che lavora in
 * prima persona. Ogni sezione «prova» qualcosa e vive solo se ha i suoi
 * contenuti nel back office:
 *
 *  1. Apertura — foto di Gaia a tutto schermo, nome, tagline (+ anno)
 *  2. La sua voce — il testo della pagina, parola per parola allo scroll
 *  3. I numeri — about.stats.* (solo se impostati)
 *  4. Il percorso — blocco «timeline» della pagina
 *  5. Come lavoro — blocco «values», sticky split con le foto di Gaia
 *  6. Citazione — il <blockquote> del testo (o un estratto Stampa)
 *  7. Hanno scelto Gaia — Clienti (solo se ce ne sono)
 *  8. Due link enormi — I miei eventi, Servizi
 *  9. Chiusura — la CTA finale della home
 *
 * Testi solo dal back office (pages.about, settings.about.*, tagline).
 * Effetti in scripts/chi-sono-effetti.ts, caricati dopo il motion di base.
 */
import { BUSINESS, type Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { existsIn, langsFor } from '../../lib/availability';
import { getClients, getHighlights, getPage, getPress, getSettings, text } from '../../lib/content';
import { picture } from '../../lib/images';
import { aboutPage, breadcrumbs, person } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';
import Apertura from '../chi-sono/Apertura.astro';
import Citazione from '../chi-sono/Citazione.astro';
import Clienti from '../chi-sono/Clienti.astro';
import LinkGrandi from '../chi-sono/LinkGrandi.astro';
import Numeri from '../chi-sono/Numeri.astro';
import Percorso from '../chi-sono/Percorso.astro';
import Valori from '../chi-sono/Valori.astro';
import Voce from '../chi-sono/Voce.astro';
import CtaFinale from '../home/CtaFinale.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const page = getPage('about');
const langs = langsFor('about');
const settings = getSettings();

const titolo = text(page?.title, lang) || t('nav.about');
const nome = BUSINESS.legalName;
const tagline = text(settings.tagline, lang);
const anno = text(settings.about?.since, lang).trim();

// Il testo della pagina è HTML dal back office (h2, paragrafi, un
// blockquote): qui serve a pezzi. I primi due paragrafi vanno in grande
// (la sua voce), gli altri in corpo lead; il blockquote è la citazione a
// tutto schermo (sezione 6).
const body = text(page?.body, lang);
const senzaTag = (html: string): string => html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const paragrafi = [...body.matchAll(/<p[^>]*>([\s\S]*?)<\/p>/gi)].map((m) => senzaTag(m[1] ?? '')).filter(Boolean);
const citazione = senzaTag(body.match(/<blockquote[^>]*>([\s\S]*?)<\/blockquote>/i)?.[1] ?? '');

// Foto di Gaia al lavoro (highlight «chi-sono»): la prima è l'apertura;
// nella «voce» la grande è l'ultima abbastanza larga per la colonna
// (maxWidth ≥ 600), la piccola la prima delle altre.
const fotoGaia = getHighlights('chi-sono').slice(1).map((h) => h.image);
const grande = fotoGaia.filter((i) => (i?.maxWidth ?? 0) >= 600).at(-1) ?? fotoGaia[0] ?? null;
const piccola = fotoGaia.find((i) => i !== grande) ?? null;
const fotoVoceGrande = picture(grande, lang, '(min-width: 64rem) 40vw, 92vw');
const fotoVocePiccola = picture(piccola, lang, '(min-width: 64rem) 17vw, 40vw');

// I numeri: solo le coppie valore + etichetta compilate, nell'ordine 1-4.
const numeri = Object.entries(settings.about?.stats ?? {})
  .sort(([a], [b]) => Number(a) - Number(b))
  .map(([, n]) => ({ value: text(n?.value, lang).trim(), label: text(n?.label, lang).trim() }))
  .filter((n) => n.value && n.label);

// Blocchi della pagina: «timeline» (il percorso) e «values» (come lavoro).
const blocco = (kind: string) => (page?.blocks ?? []).find((b) => b.kind === kind) ?? null;
const timeline = blocco('timeline');
const tappe = (timeline?.items ?? [])
  .map((i) => ({ anno: i.label ?? '', titolo: text(i.title, lang), testo: text(i.text, lang), image: i.image ?? null }))
  .filter((i) => i.titolo);
const valoriBlocco = blocco('values');
const valori = (valoriBlocco?.items ?? [])
  .map((i) => ({ titolo: text(i.title, lang), testo: text(i.text, lang), image: i.image ?? null }))
  .filter((i) => i.titolo);

// Citazione a tutto schermo: la foto about.photos.quote; se c'è una voce
// Stampa con estratto in questa lingua, prende il posto della citazione.
const fotoCitazione = picture(settings.about?.photos?.quote ?? null, lang, '100vw');
const primaStampa = getPress().find((p) => text(p.excerpt, lang));
const stampa = primaStampa ? { estratto: text(primaStampa.excerpt, lang), testata: primaStampa.outlet, url: primaStampa.url } : null;

// Due link enormi, solo verso pagine che esistono in questa lingua.
const linkGrandi = (
  [
    { key: 'stories' as const, etichetta: t('nav.stories'), foto: settings.about?.photos?.events ?? null },
    { key: 'services' as const, etichetta: t('nav.services'), foto: settings.about?.photos?.services ?? null },
  ] as const
)
  .filter((l) => existsIn(l.key, lang))
  .map((l) => ({ href: path(l.key, lang), etichetta: l.etichetta, foto: picture(l.foto, lang, '(min-width: 64rem) 26vw, 100vw') }));

// Foto dell'apertura: il primo highlight della sezione «chi-sono», il
// ritratto di Gaia al lavoro (taglio sul punto focale).
const fotoApertura = picture(getHighlights('chi-sono')[0]?.image ?? settings.about.image, lang, '100vw');
const preload = fotoApertura?.sources[0] ?? null;

const meta = buildMeta({
  lang,
  routeKey: 'about',
  title: titolo,
  description: text(page?.intro, lang),
  seo: page ?? undefined,
  image: getHighlights('chi-sono')[0]?.image ?? null,
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: titolo, href: path('about', lang) },
];

const jsonLd = [
  aboutPage({ lang, title: meta.title, description: meta.description }),
  person({ lang, image: meta.ogImage, description: text(settings.about.text, lang) }),
  breadcrumbs(crumbs),
];
---

<BaseLayout lang={lang} routeKey="about" meta={meta} availableLangs={langs} jsonLd={jsonLd} largo>
  {
    preload && (
      <link slot="head" rel="preload" as="image" type={preload.type} imagesrcset={preload.srcset} imagesizes="100vw" />
    )
  }

  <Apertura lang={lang} eyebrow={titolo} nome={nome} riga={tagline} anno={anno} foto={fotoApertura} />

  <Voce lang={lang} paragrafi={paragrafi} fotoGrande={fotoVoceGrande} fotoPiccola={fotoVocePiccola} />

  <Numeri numeri={numeri} />

  <Percorso lang={lang} titolo={text(timeline?.title, lang)} tappe={tappe} />

  <Valori lang={lang} titolo={text(valoriBlocco?.title, lang)} valori={valori} />

  <Citazione lang={lang} citazione={citazione} foto={fotoCitazione} stampa={stampa} />

  <Clienti lang={lang} clienti={getClients()} />

  <LinkGrandi link={linkGrandi} />

  <CtaFinale lang={lang} settings={settings} />
</BaseLayout>

<script>
  // Effetti della pagina dopo il motion di base (GSAP già caricato).
  document.addEventListener(
    'gaia:motion-pronta',
    () => {
      void import('../../scripts/chi-sono-effetti').then(({ initChiSonoEffetti }) => {
        if (document.fonts?.ready) {
          void document.fonts.ready.then(() => initChiSonoEffetti());
        } else {
          initChiSonoEffetti();
        }
      });
    },
    { once: true },
  );
</script>
