---
/**
 * Servizi (/servizi/ ↔ /en/services/). Ogni sezione vive solo se ha i
 * suoi contenuti nel back office, niente segnaposto visibili:
 *
 *  1. Apertura — page_hero «services» (foto, titolo H1, frase) + indice
 *  2. Filosofia — blocco «intro» della pagina
 *  3. Capitoli — un capitolo per servizio (destination: fascia a parte)
 *  4. Quale fa per voi — tabella di confronto (service_compare)
 *  5. Come lavoro — blocco «process», cinque passi
 *  6. Partner — solo partner attivi con il consenso alla citazione
 *  7. Non solo matrimoni — blocco «cta»
 *  8. Domande frequenti — FAQ del gruppo «servizi»
 *  9. Dicono di me — ponte, solo se la pagina esiste
 * 10. Chiusura — la CTA finale con la foto servizi.photos.cta
 *
 * Effetti in scripts/servizi-effetti.ts, caricati dopo il motion di base.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SERVICE_FIELDS, langsFor } from '../../lib/availability';
import { getHero, getPage, getServices, getSettings, isPublishable, text } from '../../lib/content';
import { picture } from '../../lib/images';
import { breadcrumbs, service as serviceSchema } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';
import Apertura from '../servizi/Apertura.astro';
import Capitoli from '../servizi/Capitoli.astro';
import Confronto from '../servizi/Confronto.astro';
import Destination from '../servizi/Destination.astro';
import Metodo from '../servizi/Metodo.astro';
import Filosofia from '../servizi/Filosofia.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const page = getPage('services');
const langs = langsFor('services');
const settings = getSettings();
const hero = getHero('services');

// Un servizio compare solo se tradotto nella lingua della pagina.
const servizi = getServices().filter((item) => isPublishable(item, lang, SERVICE_FIELDS));

const titoloPagina = text(page?.title, lang) || t('nav.services');
const titoloApertura = text(hero?.title, lang) || titoloPagina;
const fraseApertura = text(hero?.subtitle, lang) || text(page?.intro, lang);
const immagineApertura = hero?.images?.[0] ?? hero?.poster ?? null;
// Su mobile la foto copre una fascia alta 68svh: in «cover» è larga circa
// 1,5 × l'altezza, quindi più del viewport.
const SIZES_APERTURA = '(max-width: 47.99rem) 102vh, 100vw';
const fotoApertura = picture(immagineApertura, lang, SIZES_APERTURA);
const preload = fotoApertura?.sources[0] ?? null;

// Indice dell'apertura: tutti i servizi, nell'ordine del back office;
// l'ancora è lo slug (le card della home linkano /servizi/#planning).
const indice = servizi.map((s, i) => ({
  slug: s.slug,
  numero: String(i + 1).padStart(2, '0'),
  titolo: text(s.title, lang),
}));

// Blocchi della pagina (page_sections): intro, process, cta.
const blocco = (kind: string) => (page?.blocks ?? []).find((b) => b.kind === kind) ?? null;
const intro = blocco('intro');
const processo = blocco('process');
const passi = (processo?.items ?? [])
  .map((i) => ({ titolo: text(i.title, lang), testo: text(i.text, lang), image: i.image ?? null }))
  .filter((i) => i.titolo);

// Capitoli: tutti i servizi tranne la destination, che ha la sua fascia.
const capitoli = servizi.filter((s) => s.slug !== 'destination');
const destination = servizi.find((s) => s.slug === 'destination') ?? null;
const numeroDestination = String(servizi.indexOf(destination!) + 1).padStart(2, '0');

const meta = buildMeta({
  lang,
  routeKey: 'services',
  title: titoloPagina,
  description: text(page?.intro, lang) || fraseApertura,
  seo: page ?? undefined,
  image: immagineApertura,
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: titoloPagina, href: path('services', lang) },
];

const jsonLd = [breadcrumbs(crumbs), ...servizi.map((item) => serviceSchema(item, lang))];
---

<BaseLayout lang={lang} routeKey="services" meta={meta} availableLangs={langs} jsonLd={jsonLd} largo>
  {
    preload && (
      <link slot="head" rel="preload" as="image" type={preload.type} imagesrcset={preload.srcset} imagesizes={SIZES_APERTURA} />
    )
  }

  <Apertura eyebrow={titoloPagina} titolo={titoloApertura} frase={fraseApertura} foto={fotoApertura} indice={indice} />

  <Filosofia titolo={text(intro?.title, lang)} testo={text(intro?.text, lang)} />

  <Capitoli lang={lang} servizi={capitoli} />

  <Destination lang={lang} servizio={destination} numero={numeroDestination} />

  <Confronto
    lang={lang}
    servizi={servizi}
    titolo={text(settings.servizi?.compare?.title, lang) || t('nav.services')}
  />

  <Metodo lang={lang} titolo={text(processo?.title, lang)} passi={passi} />
</BaseLayout>

<script>
  // Effetti della pagina dopo il motion di base (GSAP già caricato).
  document.addEventListener(
    'gaia:motion-pronta',
    () => {
      void import('../../scripts/servizi-effetti').then(({ initServiziEffetti }) => {
        if (document.fonts?.ready) {
          void document.fonts.ready.then(() => initServiziEffetti());
        } else {
          initServiziEffetti();
        }
      });
    },
    { once: true },
  );
</script>
