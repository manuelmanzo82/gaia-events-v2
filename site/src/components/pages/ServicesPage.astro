---
import { DEFAULT_LANG, type Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { availableLangs, getPage, getServices, pick, text } from '../../lib/content';
import { breadcrumbs, service as serviceSchema } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const page = getPage('services');
const langs = page ? availableLangs(page, ['title']) : [DEFAULT_LANG];

// Un servizio compare solo se tradotto nella lingua della pagina.
const services = getServices().filter((item) => text(item.title, lang));

const title = text(page?.title, lang) || t('nav.services');

const meta = buildMeta({
  lang,
  routeKey: 'services',
  title,
  description: text(page?.intro, lang),
  seo: page ?? undefined,
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: title, href: path('services', lang) },
];

const jsonLd = [
  breadcrumbs(crumbs),
  ...services.map((item) => serviceSchema(item, lang)),
];
---

<BaseLayout
  lang={lang}
  routeKey="services"
  meta={meta}
  availableLangs={langs}
  jsonLd={jsonLd}
  crumbs={crumbs}
>
  <h1>{title}</h1>
  {text(page?.intro, lang) && <p>{text(page?.intro, lang)}</p>}

  {services.length === 0 && <p>{t('common.empty')}</p>}

  {
    services.map((item) => (
      <article id={item.slug}>
        <h2>{text(item.title, lang)}</h2>
        {text(item.subtitle, lang) && <p>{text(item.subtitle, lang)}</p>}
        <p>{text(item.description, lang)}</p>
        {
          pick(item.features, lang) && (
            <ul>
              {pick(item.features, lang)!.map((feature) => <li>{feature}</li>)}
            </ul>
          )
        }
      </article>
    ))
  }

  <p><a href={path('quote', lang)}>{t('cta.quote')}</a></p>
</BaseLayout>
