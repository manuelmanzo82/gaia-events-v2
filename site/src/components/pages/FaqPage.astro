---
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublishable, getFaqs, getPage, text } from '../../lib/content';
import { FAQ_FIELDS, existsIn, langsFor } from '../../lib/availability';
import { breadcrumbs, faqPage } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const page = getPage('faq');
const langs = langsFor('faq');

const faqs = getFaqs().filter((faq) => isPublishable(faq, lang, FAQ_FIELDS));

const title = text(page?.title, lang) || t('nav.faq');

const meta = buildMeta({
  lang,
  routeKey: 'faq',
  title,
  description: text(page?.intro, lang),
  seo: page ?? undefined,
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: title, href: path('faq', lang) },
];

const jsonLd = [breadcrumbs(crumbs), faqPage(faqs, lang)];
---

<BaseLayout
  lang={lang}
  routeKey="faq"
  meta={meta}
  availableLangs={langs}
  jsonLd={jsonLd}
  crumbs={crumbs}
>
  <h1>{title}</h1>
  {text(page?.intro, lang) && <p>{text(page?.intro, lang)}</p>}

  {faqs.length === 0 && <p>{t('common.empty')}</p>}

  {
    faqs.map((faq) => (
      <details>
        <summary>{text(faq.question, lang)}</summary>
        <p>{text(faq.answer, lang)}</p>
      </details>
    ))
  }

  {existsIn('contact', lang) && <p><a href={path('contact', lang)}>{t('cta.contact')}</a></p>}
</BaseLayout>
