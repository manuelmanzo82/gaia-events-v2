---
/**
 * Home. Struttura da docs/DECISIONI-DESIGN-gaia.md, rivista il 16/10: hero
 * scuro, Gaia (foto + manifesto + presentazione), highlights (schede
 * impilate + fascia orizzontale), luoghi, servizi, recensione, destination
 * wedding, CTA finale.
 *
 * Tutti i testi vengono dal back office; una sezione senza contenuti in
 * questa lingua non viene renderizzata, con la stessa logica di
 * availability.ts usata da menu, sitemap e hreflang. Instagram: post
 * caricati dal back office (più avanti anche via API), sezione nascosta
 * se non ce n'è nessuno visibile.
 */
import type { Lang } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getHero, getHighlights, getSettings, text } from '../../lib/content';
import { picture } from '../../lib/images';
import { localBusiness, webSite } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';
import { SCHEDE_IMPILATE } from '../../lib/home';
import CtaFinale from '../home/CtaFinale.astro';
import DestinationAggancio from '../home/DestinationAggancio.astro';
import GaiaIntro from '../home/GaiaIntro.astro';
import HeroHome from '../home/HeroHome.astro';
import MenuVisivo from '../home/MenuVisivo.astro';
import HighlightsOrizzontali from '../home/HighlightsOrizzontali.astro';
import InstagramHome from '../home/InstagramHome.astro';
import LuoghiAnteprima from '../home/LuoghiAnteprima.astro';
import Recensione from '../home/Recensione.astro';
import ServiziPannelli from '../home/ServiziPannelli.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const settings = getSettings();
const hero = getHero('home');

// Highlights della home: le prime 5 orizzontali, nell'ordine del back
// office, fanno da foto alle schede del menu visivo (90vw: qui si accetta
// di superare il maxWidth, vedi MenuVisivo); tutte le altre, verticali
// comprese, vanno nella fascia orizzontale, che da sola esclude quelle
// che non reggono la sua altezza.
const highlights = getHighlights('home');
const impilati = highlights
  .filter((h) => !!h.image && h.image.width > h.image.height)
  .slice(0, SCHEDE_IMPILATE);
const orizzontali = highlights.filter((h) => !impilati.includes(h));

// OG image e JSON-LD: la prima foto dell'hero, se c'è.
const immagineHome = hero?.images[0] ?? settings.hero.image;
const meta = buildMeta({ lang, routeKey: 'home', seo: settings, image: immagineHome });

// Preload della prima foto dell'hero nel formato migliore (il browser
// ignora un preload con un type che non supporta). Nota: Chrome non conta
// come LCP un'immagine che riempie tutto il viewport (la tratta da
// sfondo), quindi l'LCP della home è il titolo e dipende dai font: il
// preload della foto resta, ma senza fetchpriority alta, così i font
// passano avanti sulle connessioni lente.
const preloadHero = picture(immagineHome, lang, '100vw')?.sources[0] ?? null;

const jsonLd = [
  localBusiness({ lang, description: meta.description, image: meta.ogImage }),
  webSite(lang, settings.siteName, meta.description),
];

const section = (key: string) => settings.sections[key];
---

<BaseLayout lang={lang} routeKey="home" meta={meta} jsonLd={jsonLd} intro largo>
  {
    preloadHero && (
      <link
        slot="head"
        rel="preload"
        as="image"
        type={preloadHero.type}
        imagesrcset={preloadHero.srcset}
        imagesizes="100vw"
      />
    )
  }

  <HeroHome lang={lang} hero={hero} settings={settings} />

  <GaiaIntro lang={lang} settings={settings} />

  <MenuVisivo
    lang={lang}
    highlights={impilati}
    eyebrow={text(section('portfolio')?.text, lang)}
    titolo={text(section('portfolio')?.title, lang)}
  />
  <HighlightsOrizzontali lang={lang} highlights={orizzontali} />

  <LuoghiAnteprima lang={lang} />

  <ServiziPannelli
    lang={lang}
    titolo={text(section('services')?.title, lang)}
    testo={text(section('services')?.text, lang)}
  />

  <Recensione lang={lang} eyebrow={text(section('reviews')?.title, lang)} />

  <DestinationAggancio lang={lang} />

  <InstagramHome lang={lang} />

  <CtaFinale lang={lang} settings={settings} />
</BaseLayout>

<script>
  import { initHomeEffetti } from '../../scripts/home-effetti';

  // Dopo il motion di base (BaseLayout): schede impilate e fascia
  // orizzontale esistono solo da 64rem in su.
  if (document.fonts?.ready) {
    void document.fonts.ready.then(() => initHomeEffetti());
  } else {
    initHomeEffetti();
  }
</script>
