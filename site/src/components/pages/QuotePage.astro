---
import { DEFAULT_LANG, type Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { availableLangs, getPage, text } from '../../lib/content';
import { breadcrumbs } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';
import PlaceholderSection from '../PlaceholderSection.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const page = getPage('quote');
const langs = page ? availableLangs(page, ['title']) : [DEFAULT_LANG];

const title = text(page?.title, lang) || t('nav.quote');

const meta = buildMeta({
  lang,
  routeKey: 'quote',
  title,
  description: text(page?.intro, lang),
  seo: page ?? undefined,
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: title, href: path('quote', lang) },
];
---

<BaseLayout
  lang={lang}
  routeKey="quote"
  meta={meta}
  availableLangs={langs}
  jsonLd={[breadcrumbs(crumbs)]}
  crumbs={crumbs}
>
  <h1>{title}</h1>
  {text(page?.intro, lang) && <p>{text(page?.intro, lang)}</p>}

  <PlaceholderSection lang={lang} id="quote-form">
    <p>
      Qui andrà il preventivatore: <strong>un unico componente React bilingue</strong>,
      senza prezzi automatici, che invia a <code>admin/api/quote.php</code>.
      La v1 aveva due versioni quasi identiche, circa 1.200 righe in tutto.
    </p>
  </PlaceholderSection>

  <p><a href={path('contact', lang)}>{t('cta.contact')}</a></p>
</BaseLayout>
