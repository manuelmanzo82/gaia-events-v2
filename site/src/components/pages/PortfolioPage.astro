---
import { DEFAULT_LANG, type Lang } from '../../config/site';
import { formatDate, useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { availableLangs, getEvents, getPage, text } from '../../lib/content';
import { picture } from '../../lib/images';
import { breadcrumbs } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const page = getPage('portfolio');
const langs = page ? availableLangs(page, ['title']) : [DEFAULT_LANG];

// Un evento compare nell'indice solo se ha titolo ed estratto nella lingua.
const events = getEvents().filter(
  (event) => text(event.title, lang) && text(event.excerpt, lang),
);

const title = text(page?.title, lang) || t('nav.portfolio');

const meta = buildMeta({
  lang,
  routeKey: 'portfolio',
  title,
  description: text(page?.intro, lang),
  seo: page ?? undefined,
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: title, href: path('portfolio', lang) },
];
---

<BaseLayout
  lang={lang}
  routeKey="portfolio"
  meta={meta}
  availableLangs={langs}
  jsonLd={[breadcrumbs(crumbs)]}
  crumbs={crumbs}
>
  <h1>{title}</h1>
  {text(page?.intro, lang) && <p>{text(page?.intro, lang)}</p>}

  {events.length === 0 && <p>{t('common.empty')}</p>}

  <ul class="event-grid">
    {
      events.map((event) => (
        <li>
          <a href={path('portfolio', lang, event.slug)}>
            <Picture
              data={picture(event.cover, lang, '(min-width: 48rem) 33vw, 100vw')}
            />
            <h2>{text(event.title, lang)}</h2>
          </a>
          <p>{text(event.location, lang)} — {formatDate(event.date, lang)}</p>
          <p>{text(event.excerpt, lang)}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  /* Griglia provvisoria: la gallery definitiva si progetta nella fase di design. */
  .event-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    list-style: none;
    padding: 0;
  }
</style>
