---
import type { Lang } from '../../config/site';
import { formatDate, useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { availableLangs, text } from '../../lib/content';
import { POST_FIELDS } from '../../lib/availability';
import { picture } from '../../lib/images';
import { article as articleSchema, breadcrumbs } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';
import type { Post } from '../../lib/types';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  post: Post;
  slug: string;
}

const { lang, post, slug } = Astro.props;
const t = useTranslations(lang);

const langs = availableLangs(post, POST_FIELDS);
const title = text(post.title, lang);

const meta = buildMeta({
  lang,
  routeKey: 'blog',
  slug,
  title,
  description: text(post.excerpt, lang),
  seo: post,
  image: post.cover,
  ogType: 'article',
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: t('nav.blog'), href: path('blog', lang) },
  { name: title, href: path('blog', lang, slug) },
];

const jsonLd = [breadcrumbs(crumbs), articleSchema(post, lang, slug)];
---

<BaseLayout
  lang={lang}
  routeKey="blog"
  slug={slug}
  meta={meta}
  availableLangs={langs}
  jsonLd={jsonLd}
  crumbs={crumbs}
>
  <article>
    <h1>{title}</h1>
    <p>
      <time datetime={post.date}>{formatDate(post.date, lang)}</time>
      {post.readingTime > 0 && <span> — {post.readingTime} {t('common.readingTime')}</span>}
      {text(post.category, lang) && <span> — {text(post.category, lang)}</span>}
    </p>

    <Picture data={picture(post.cover, lang, '100vw')} loading="eager" fetchpriority="high" />

    <div set:html={text(post.body, lang)} />

    <p><a href={path('blog', lang)}>{t('nav.blog')}</a></p>
  </article>
</BaseLayout>
