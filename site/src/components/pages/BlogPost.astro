---
/**
 * Magazine, articolo (/magazine/<slug>/ ↔ /en/magazine/<slug-en>/).
 *
 *  1. Apertura — categoria, H1, data e «Aggiornato il», firma, copertina
 *  2. In breve — 3–4 punti (sommario_it/en)
 *  3. Corpo — i blocchi: colonna da lettura, capolettera, citazioni,
 *     immagini, video, domande e risposte, titoli con le ancore
 *  4. Barra di lettura e, su desktop con almeno 3 H2, indice fisso
 *  5. Box autrice, condividi, tre correlati, CtaFinale
 *
 * JSON-LD: BlogPosting (autrice Person), BreadcrumbList, FAQPage se ci
 * sono domande e risposte, VideoObject per i video.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { POST_FIELDS, existsIn } from '../../lib/availability';
import { availableLangs, getSettings, text } from '../../lib/content';
import { picture } from '../../lib/images';
import { blogPosting, breadcrumbs, faqDaBlocchi, videoObject } from '../../lib/jsonld';
import { url } from '../../i18n/routes';
import { titoliH2, videoDi } from '../../lib/magazine';
import { buildMeta } from '../../lib/seo';
import type { Post } from '../../lib/types';
import ArticoloApertura from '../magazine/ArticoloApertura.astro';
import Autrice from '../magazine/Autrice.astro';
import Video from '../magazine/Video.astro';
import BarraLettura from '../magazine/BarraLettura.astro';
import Corpo from '../magazine/Corpo.astro';
import IndiceArticolo from '../magazine/IndiceArticolo.astro';
import InBreve from '../magazine/InBreve.astro';

interface Props {
  lang: Lang;
  post: Post;
  slug: string;
}

const { lang, post, slug } = Astro.props;
const t = useTranslations(lang);
const settings = getSettings();

const langs = availableLangs(post, POST_FIELDS);
const title = text(post.title, lang);
const blocks = post.blocks ?? [];

const meta = buildMeta({
  lang,
  routeKey: 'blog',
  slug,
  title,
  description: text(post.excerpt, lang),
  seo: post,
  image: post.cover ?? post.coverVideo?.poster ?? null,
  ogType: 'article',
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: t('nav.blog'), href: path('blog', lang) },
  { name: title, href: path('blog', lang, slug) },
];

const jsonLd = [
  breadcrumbs(crumbs),
  blogPosting(post, lang, slug),
  faqDaBlocchi(blocks, lang),
  ...videoDi(post).map((v) => videoObject(v, lang)),
];

const titoli = titoliH2(blocks, lang);
const fotoAutrice = picture(settings.magazine?.photos?.autrice ?? null, lang, '11rem');
const conIndice = titoli.length >= 3;
const ritratto = picture(settings.magazine?.photos?.autrice ?? null, lang, '7rem');
const rss = existsIn('blog', lang) ? `${path('blog', lang)}rss.xml` : null;
---

<BaseLayout lang={lang} routeKey="blog" slug={slug} meta={meta} availableLangs={langs} jsonLd={jsonLd} largo>
  {rss && <link slot="head" rel="alternate" type="application/rss+xml" title={`${t('nav.blog')} — Gaia Events`} href={rss} />}

  <article class="mg-articolo">
    <ArticoloApertura lang={lang} post={post} ritratto={ritratto}>
      {
        post.coverVideo && (
          <div slot="copertina-video" class="mg-copertina-video">
            <Video lang={lang} video={post.coverVideo} larga eager />
          </div>
        )
      }
    </ArticoloApertura>

    <BarraLettura />
    <div class:list={['mg-articolo-corpo', { 'mg-articolo-corpo--indice': conIndice }]}>
      <IndiceArticolo lang={lang} titoli={titoli} />
      <div class="mg-lettura" data-lettura>
        <InBreve lang={lang} punti={post.summary?.[lang] ?? []} />
        <Corpo lang={lang} post={post} />
        <Autrice
          lang={lang}
          foto={fotoAutrice}
          bio={text(settings.magazine?.autrice?.bio, lang)}
          titolo={title}
          indirizzo={url('blog', lang, slug)}
        />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .mg-articolo-corpo {
    width: calc(100% - 2 * clamp(1.25rem, 4vw, 3.5rem));
    max-width: 75rem;
    margin: clamp(2.5rem, 7vh, 4.5rem) auto var(--spacing-section-sm);
  }

  /* Con l'indice: colonna dell'indice a sinistra, lettura al centro. */
  @media (min-width: 80rem) {
    .mg-articolo-corpo--indice {
      display: grid;
      grid-template-columns: 13rem minmax(0, 1fr) 13rem;
      gap: 2rem;
    }
  }

  .mg-copertina-video {
    width: calc(100% - 2 * clamp(1.25rem, 4vw, 3.5rem));
    max-width: 75rem;
    margin: clamp(2rem, 6vh, 3.5rem) auto 0;
  }

  .mg-lettura > :global(.mg-breve) {
    width: min(42rem, 100%);
    margin-inline: auto;
  }
</style>

<script>
  document.addEventListener(
    'gaia:motion-pronta',
    () => {
      void import('../../scripts/magazine-effetti').then(({ initMagazineEffetti }) => initMagazineEffetti());
    },
    { once: true },
  );
</script>
