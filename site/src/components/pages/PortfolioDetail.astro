---
import type { Lang } from '../../config/site';
import { formatDate, useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { availableLangs, text } from '../../lib/content';
import { picture } from '../../lib/images';
import { breadcrumbs, event as eventSchema } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';
import type { Event } from '../../lib/types';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  event: Event;
}

const { lang, event } = Astro.props;
const t = useTranslations(lang);

const langs = availableLangs(event, ['title', 'excerpt', 'description']);

const title = text(event.title, lang);

const meta = buildMeta({
  lang,
  routeKey: 'portfolio',
  slug: event.slug,
  title,
  description: text(event.excerpt, lang),
  seo: event,
  image: event.cover,
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: t('nav.portfolio'), href: path('portfolio', lang) },
  { name: title, href: path('portfolio', lang, event.slug) },
];

const jsonLd = [breadcrumbs(crumbs), eventSchema(event, lang)];
---

<BaseLayout
  lang={lang}
  routeKey="portfolio"
  slug={event.slug}
  meta={meta}
  availableLangs={langs}
  jsonLd={jsonLd}
  crumbs={crumbs}
>
  <article>
    <h1>{title}</h1>

    <dl>
      <dt>{t('common.location')}</dt>
      <dd>{text(event.location, lang)}</dd>
      <dt>{t('common.date')}</dt>
      <dd><time datetime={event.date}>{formatDate(event.date, lang)}</time></dd>
      <dt>{t('common.category')}</dt>
      <dd>{text(event.category, lang)}</dd>
    </dl>

    <Picture
      data={picture(event.hero ?? event.cover, lang, '100vw')}
      loading="eager"
      fetchpriority="high"
    />

    <div set:html={text(event.description, lang)} />

    {
      event.video && (
        <p><a href={event.video} rel="noopener">{event.video}</a></p>
      )
    }

    {
      event.gallery.length > 0 && (
        <section>
          <h2>{t('common.gallery')}</h2>
          {/* Lightbox e navigazione arrivano nella fase di design. */}
          <ul class="gallery">
            {event.gallery.map((image) => (
              <li>
                <Picture data={picture(image, lang, '(min-width: 48rem) 50vw, 100vw')} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p><a href={path('portfolio', lang)}>{t('cta.allEvents')}</a></p>
  </article>
</BaseLayout>

<style>
  .gallery {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    list-style: none;
    padding: 0;
  }
</style>
