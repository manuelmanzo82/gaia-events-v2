---
/**
 * Contatti (/contatti/ ↔ /en/contact/). La pagina stessa è la CTA: niente
 * mappa e niente CtaFinale; l'indirizzo resta nel footer e nel JSON-LD.
 *
 *  1. Apertura — «Scriviamoci» enorme e la cornice 9:16 (video di saluto
 *     di Gaia se c'è, altrimenti il suo ritratto con la firma)
 *  2. Tessere — Conosciamoci (principale), WhatsApp, Telefono, Email
 *  3. Form breve — a admin/api/contact.php, ringraziamento sul posto
 *  4. Instagram — lo stesso componente della home (social già nell'header,
 *     nel footer e qui: niente sezione «Seguitemi» a parte)
 *
 * Testi: pagina «contact» e impostazioni del gruppo «contatti».
 * JSON-LD: ContactPage con LocalBusiness e contactPoint, BreadcrumbList.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { langsFor } from '../../lib/availability';
import { getPage, getSettings, text } from '../../lib/content';
import { breadcrumbs, contactPage } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';
import Apertura from '../contatti/Apertura.astro';
import Modulo from '../contatti/Modulo.astro';
import Tessere from '../contatti/Tessere.astro';
import InstagramHome from '../home/InstagramHome.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const page = getPage('contact');
const settings = getSettings();
const c = settings.contatti;
const langs = langsFor('contact');

const title = text(page?.title, lang) || t('nav.contact');
const riga = text(page?.intro, lang) || text(settings.contact.text, lang);

const tessere = Object.fromEntries(
  ['conosciamoci', 'whatsapp', 'telefono', 'email'].map((k) => [
    k,
    { titolo: text(c?.tessera?.[k]?.titolo, lang), testo: text(c?.tessera?.[k]?.testo, lang) },
  ]),
);

const ritratto = c?.photos?.ritratto ?? null;

const meta = buildMeta({
  lang,
  routeKey: 'contact',
  title,
  description: riga,
  seo: page ?? undefined,
  image: ritratto,
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: title, href: path('contact', lang) },
];

const jsonLd = [breadcrumbs(crumbs), contactPage({ lang, title: meta.title, description: meta.description, image: meta.ogImage })];
---

<BaseLayout lang={lang} routeKey="contact" meta={meta} availableLangs={langs} jsonLd={jsonLd} largo>
  <Apertura
    lang={lang}
    titolo={title}
    riga={riga}
    video={c?.video ?? null}
    ritratto={ritratto}
    firma={text(c?.firma, lang)}
  />

  <Tessere
    lang={lang}
    testi={tessere}
    messaggioWhatsapp={text(c?.whatsapp?.messaggio, lang)}
    foto={c?.photos?.tessera ?? null}
  />

  <Modulo lang={lang} titolo={text(c?.form?.titolo, lang)} grazie={text(c?.form?.grazie, lang)} />

  <div class="ct-instagram">
    <InstagramHome lang={lang} />
  </div>
</BaseLayout>

<style>
  /* Instagram subito dopo il form (fondo avorio), e poco spazio prima del
     footer: il componente della home ha margini pensati per la home. */
  .ct-instagram :global(.ig) {
    padding-block: clamp(2.5rem, 6vh, 3.5rem) clamp(2.5rem, 6vh, 4rem);
  }
</style>
