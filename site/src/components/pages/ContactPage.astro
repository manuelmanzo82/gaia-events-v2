---
/**
 * Contatti (/contatti/ ↔ /en/contact/). La pagina stessa è la CTA: niente
 * mappa e niente CtaFinale; l'indirizzo resta nel footer e nel JSON-LD.
 *
 *  1. Apertura — «Scriviamoci» enorme e la cornice 9:16 (video di saluto
 *     di Gaia se c'è, altrimenti il suo ritratto con la firma)
 *  2. Tessere — Conosciamoci (principale), WhatsApp, Telefono, Email
 *  3. Form breve — a admin/api/contact.php, ringraziamento sul posto
 *  4. Instagram — lo stesso componente della home
 *  5. Social — Instagram e Facebook con le icone del sito
 *
 * Testi: pagina «contact» e impostazioni del gruppo «contatti».
 * JSON-LD: ContactPage con LocalBusiness e contactPoint, BreadcrumbList.
 */
import { BUSINESS, type Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { langsFor } from '../../lib/availability';
import { getPage, getSettings, text } from '../../lib/content';
import { breadcrumbs, contactPage } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';
import Icona from '../Icona.astro';
import Apertura from '../contatti/Apertura.astro';
import Modulo from '../contatti/Modulo.astro';
import Tessere from '../contatti/Tessere.astro';
import InstagramHome from '../home/InstagramHome.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const page = getPage('contact');
const settings = getSettings();
const c = settings.contatti;
const langs = langsFor('contact');

const title = text(page?.title, lang) || t('nav.contact');
const riga = text(page?.intro, lang) || text(settings.contact.text, lang);

const tessere = Object.fromEntries(
  ['conosciamoci', 'whatsapp', 'telefono', 'email'].map((k) => [
    k,
    { titolo: text(c?.tessera?.[k]?.titolo, lang), testo: text(c?.tessera?.[k]?.testo, lang) },
  ]),
);

const ritratto = c?.photos?.ritratto ?? null;

const meta = buildMeta({
  lang,
  routeKey: 'contact',
  title,
  description: riga,
  seo: page ?? undefined,
  image: ritratto,
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: title, href: path('contact', lang) },
];

const jsonLd = [breadcrumbs(crumbs), contactPage({ lang, title: meta.title, description: meta.description, image: meta.ogImage })];
const titoloSocial = text(c?.social?.titolo, lang) || t('footer.social');
---

<BaseLayout lang={lang} routeKey="contact" meta={meta} availableLangs={langs} jsonLd={jsonLd} largo>
  <Apertura
    lang={lang}
    titolo={title}
    riga={riga}
    video={c?.video ?? null}
    ritratto={ritratto}
    firma={text(c?.firma, lang)}
  />

  <Tessere lang={lang} testi={tessere} messaggioWhatsapp={text(c?.whatsapp?.messaggio, lang)} />

  <Modulo lang={lang} titolo={text(c?.form?.titolo, lang)} grazie={text(c?.form?.grazie, lang)} />

  <div class="ct-instagram">
    <InstagramHome lang={lang} />
  </div>

  <section class="ct-social" data-theme="light" aria-labelledby="titolo-social">
    <h2 id="titolo-social" class="ct-social-titolo">{titoloSocial}</h2>
    <ul role="list">
      <li>
        <a href={BUSINESS.instagramUrl} rel="noopener me" target="_blank">
          <Icona nome="instagram" dimensione={22} />
          <span>Instagram</span>
        </a>
      </li>
      <li>
        <a href={BUSINESS.facebookUrl} rel="noopener me" target="_blank">
          <Icona nome="facebook" dimensione={22} />
          <span>Facebook</span>
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .ct-instagram {
    margin-top: var(--spacing-section);
  }

  .ct-social {
    width: calc(100% - 2 * clamp(1.25rem, 4vw, 3.5rem));
    max-width: 76rem;
    margin: 0 auto;
    padding-block: var(--spacing-section-sm) var(--spacing-section);
    text-align: center;
  }

  .ct-social-titolo {
    margin: 0 0 1.25rem;
    font-family: var(--font-sans);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-oro-testo);
  }

  .ct-social ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ct-social a {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    min-height: 44px;
    color: var(--color-inchiostro);
    text-decoration: none;
    font-size: 1.0625rem;
  }

  .ct-social a span {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.5s var(--ease-gaia);
  }

  .ct-social a:hover span,
  .ct-social a:focus-visible span {
    background-size: 100% 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ct-social a span {
      transition: none;
    }
  }
</style>
