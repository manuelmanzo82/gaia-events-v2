---
/**
 * Destination wedding (/destination-wedding/ ↔ /en/destination-wedding/).
 * La prima pagina in cui l'inglese conta più dell'italiano: il pubblico
 * sono soprattutto coppie straniere. Ogni sezione vive solo se ha i suoi
 * contenuti nel back office, niente segnaposto visibili:
 *
 *  1. Apertura — page_hero «destinationWedding» (foto, H1, frase)
 *  2. Perché con me — blocco «values», tre colonne con icona
 *  3. Dove — regioni (destination_regioni) + blocco «destinations»
 *  4. Come funziona da lontano — blocco «timeline», conto alla rovescia
 *  5. Il rito — blocco «riti», tre card
 *  6. I vostri ospiti — blocco «ospiti» + striscia (highlights «ospiti»)
 *  7. Matrimoni arrivati da lontano — eventi con stories.destination
 *  8. Domande frequenti — FAQ del gruppo «destination»
 *  9. Dicono di me — ponte, solo se la pagina esiste
 * 10. Chiusura — CtaFinale con destination.photos.cta e la videochiamata
 *
 * Nessun bottone «preventivo» nelle sezioni: resta nel menu e nella
 * CtaFinale. Effetti in scripts/destination-effetti.ts, dopo il motion.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SERVICE_FIELDS, langsFor } from '../../lib/availability';
import {
  getDestinationRegions,
  getDestinationWedding,
  getFaqs,
  getHero,
  getHighlights,
  getServices,
  getSettings,
  isPublishable,
  text,
} from '../../lib/content';
import { picture } from '../../lib/images';
import { breadcrumbs, faqPage, service as serviceSchema } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';
import DaLontano from '../destination/DaLontano.astro';
import Dove from '../destination/Dove.astro';
import Ospiti from '../destination/Ospiti.astro';
import Realizzati from '../destination/Realizzati.astro';
import PercheConMe from '../destination/PercheConMe.astro';
import CtaFinale from '../home/CtaFinale.astro';
import Riti from '../destination/Riti.astro';
import Apertura from '../servizi/Apertura.astro';
import Domande from '../servizi/Domande.astro';
import PonteRecensioni from '../servizi/PonteRecensioni.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const data = getDestinationWedding();
const langs = langsFor('destinationWedding');
const hero = getHero('destinationWedding');

const titoloPagina = text(data.title, lang) || t('nav.destinationWedding');
const titoloApertura = text(hero?.title, lang) || titoloPagina;
const fraseApertura = text(hero?.subtitle, lang) || text(data.intro, lang);
const immagineApertura = hero?.images?.[0] ?? hero?.poster ?? data.hero ?? null;
// Su mobile la foto copre i 68svh alti (come Servizi): in «cover» è larga
// circa 1,5 × l'altezza, quindi più del viewport.
const SIZES_APERTURA = '(max-width: 47.99rem) 102vh, 100vw';
const fotoApertura = picture(immagineApertura, lang, SIZES_APERTURA);
const preload = fotoApertura?.sources[0] ?? null;

// Blocchi della pagina (page_sections): values, destinations, timeline,
// riti, ospiti.
const blocco = (kind: string) => data.blocks.find((b) => b.kind === kind) ?? null;
const perche = blocco('values');
const colonne = (perche?.items ?? [])
  .map((i) => ({ titolo: text(i.title, lang), testo: text(i.text, lang), icona: i.icon }))
  .filter((c) => c.titolo);

const dove = blocco('destinations');
const conto = blocco('timeline');
const tappe = (conto?.items ?? [])
  .map((i) => ({ numero: i.label ?? '', unita: text(i.unit, lang), titolo: text(i.title, lang), testo: text(i.text, lang) }))
  .filter((i) => i.titolo && i.numero);
const riti = blocco('riti');
const voceRiti = (riti?.items ?? [])
  .map((i) => ({ titolo: text(i.title, lang), serve: text(i.text, lang), cura: text(i.cura, lang) }))
  .filter((r) => r.titolo);
const ospiti = blocco('ospiti');
const vociOspiti = (ospiti?.items ?? [])
  .map((i) => ({ titolo: text(i.title, lang), testo: text(i.text, lang) }))
  .filter((v) => v.titolo);
const fotoOspiti = getHighlights('ospiti')
  .map((h) => h.image)
  .filter((i): i is NonNullable<typeof i> => i !== null);

// Domande frequenti: gruppo «destination», con domanda e risposta in
// questa lingua.
const domande = getFaqs()
  .filter((f) => f.active && f.group === 'destination' && text(f.question, lang) && text(f.answer, lang))
  .sort((a, b) => a.order - b.order);

const meta = buildMeta({
  lang,
  routeKey: 'destinationWedding',
  title: titoloPagina,
  description: text(data.intro, lang),
  seo: data,
  image: immagineApertura,
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: titoloPagina, href: path('destinationWedding', lang) },
];

// Service: il servizio «destination» del back office, se tradotto.
const servizio = getServices().find((s) => s.slug === 'destination' && isPublishable(s, lang, SERVICE_FIELDS));

const jsonLd = [
  breadcrumbs(crumbs),
  servizio ? serviceSchema(servizio, lang, 'italia') : null,
  faqPage(domande, lang),
];
---

<BaseLayout lang={lang} routeKey="destinationWedding" meta={meta} availableLangs={langs} jsonLd={jsonLd} largo>
  {
    preload && (
      <link
        slot="head"
        rel="preload"
        as="image"
        type={preload.type}
        imagesrcset={preload.srcset}
        imagesizes={SIZES_APERTURA}
        fetchpriority="high"
      />
    )
  }

  <Apertura eyebrow={t('nav.destinationWedding')} titolo={titoloApertura} frase={fraseApertura} foto={fotoApertura} indice={[]} />

  <PercheConMe titolo={text(perche?.title, lang)} colonne={colonne} />

  <Dove lang={lang} titolo={text(dove?.title, lang)} intro={text(dove?.text, lang)} regioni={getDestinationRegions()} />

  <DaLontano titolo={text(conto?.title, lang)} tappe={tappe} />

  <Riti lang={lang} titolo={text(riti?.title, lang)} intro={text(riti?.text, lang)} riti={voceRiti} />

  <Ospiti lang={lang} titolo={text(ospiti?.title, lang)} intro={text(ospiti?.text, lang)} voci={vociOspiti} foto={fotoOspiti} />

  <Realizzati lang={lang} titolo={text(getSettings().destination?.storie?.title, lang)} />

  <Domande lang={lang} titolo={text(getSettings().destination?.faq?.title, lang) || t('nav.faq')} domande={domande} />

  <PonteRecensioni lang={lang} />

  <CtaFinale
    lang={lang}
    settings={getSettings()}
    foto={getSettings().destination?.photos?.cta ?? null}
    lato="destra"
    riga={text(getSettings().destination?.cta?.video, lang)}
    contattiPari
  />
</BaseLayout>

<script>
  // Effetti della pagina dopo il motion di base (GSAP già caricato).
  document.addEventListener(
    'gaia:motion-pronta',
    () => {
      void import('../../scripts/destination-effetti').then(({ initDestinationEffetti }) => {
        if (document.fonts?.ready) {
          void document.fonts.ready.then(() => initDestinationEffetti());
        } else {
          initDestinationEffetti();
        }
      });
    },
    { once: true },
  );
</script>
