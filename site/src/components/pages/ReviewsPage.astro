---
import type { Lang } from '../../config/site';
import { formatDate, useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublishable, getPage, getReviews, text } from '../../lib/content';
import { REVIEW_FIELDS, existsIn, langsFor } from '../../lib/availability';
import { breadcrumbs, reviewSnippets } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const page = getPage('reviews');
const langs = langsFor('reviews');

const reviews = getReviews().filter((review) => isPublishable(review, lang, REVIEW_FIELDS));

const title = text(page?.title, lang) || t('nav.reviews');

const meta = buildMeta({
  lang,
  routeKey: 'reviews',
  title,
  description: text(page?.intro, lang),
  seo: page ?? undefined,
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: title, href: path('reviews', lang) },
];

const jsonLd = [breadcrumbs(crumbs), reviewSnippets(reviews, lang)];
---

<BaseLayout
  lang={lang}
  routeKey="reviews"
  meta={meta}
  availableLangs={langs}
  jsonLd={jsonLd}
  crumbs={crumbs}
>
  <h1>{title}</h1>
  {text(page?.intro, lang) && <p>{text(page?.intro, lang)}</p>}

  {reviews.length === 0 && <p>{t('common.empty')}</p>}

  {
    reviews.map((review) => (
      <blockquote>
        <p>{text(review.text, lang)}</p>
        <footer>
          {review.author}
          {text(review.eventName, lang) && <span> — {text(review.eventName, lang)}</span>}
          <span> — <time datetime={review.date}>{formatDate(review.date, lang)}</time></span>
        </footer>
      </blockquote>
    ))
  }

  {existsIn('quote', lang) && <p><a href={path('quote', lang)}>{t('cta.quote')}</a></p>}
</BaseLayout>
