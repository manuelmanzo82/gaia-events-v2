---
/**
 * Dicono di me (/dicono-di-me/ ↔ /en/kind-words/), giro 11: una pagina
 * sola, tre blocchi, ognuno visibile solo se ha contenuti.
 *
 *  1. Recensioni: solo quelle vere e attive, con nome, evento e data.
 *  2. Stampa: articoli e interviste (testata, titolo, data, link, logo
 *     opzionale, estratto nella lingua se c'è).
 *  3. Hanno scelto Gaia: la fila dei loghi delle aziende clienti.
 *
 * La pagina (e la voce di menu) non esiste finché tutti e tre i blocchi
 * sono vuoti: la regola sta in availability.ts, non qui. JSON-LD: solo il
 * breadcrumb — niente Review/AggregateRating autoreferenziali sul
 * LocalBusiness, le recensioni restano testo.
 */
import type { Lang } from '../../config/site';
import { formatDate, useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { REVIEW_FIELDS, existsIn, langsFor } from '../../lib/availability';
import { getClients, getPage, getPress, getReviews, isPublishable, text } from '../../lib/content';
import { picture } from '../../lib/images';
import { breadcrumbs } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const page = getPage('reviews');
const langs = langsFor('reviews');

const recensioni = getReviews().filter((r) => isPublishable(r, lang, REVIEW_FIELDS));
const stampa = getPress();
const clienti = getClients();

const title = text(page?.title, lang) || t('nav.reviews');
const intro = text(page?.intro, lang);

const meta = buildMeta({
  lang,
  routeKey: 'reviews',
  title,
  description: intro,
  seo: page ?? undefined,
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: title, href: path('reviews', lang) },
];

const preventivo = existsIn('quote', lang);
---

{/* Breadcrumb solo nel JSON-LD: a video, sotto il header, lascerebbe un buco (come sul preventivo). */}
<BaseLayout lang={lang} routeKey="reviews" meta={meta} availableLangs={langs} jsonLd={[breadcrumbs(crumbs)]}>
  <section class="dm-testa container-gaia" data-theme="light">
    <p class="eyebrow">{t('nav.reviews')}</p>
    <h1 class="text-display dm-titolo">{title}</h1>
    {intro && <p class="dm-intro">{intro}</p>}
  </section>

  {
    recensioni.length > 0 && (
      <section class="dm-recensioni" data-theme="dark" aria-labelledby="dm-recensioni-titolo">
        <div class="container-gaia">
          <h2 id="dm-recensioni-titolo" class="eyebrow" data-reveal="alto">
            {t('reviews.coppie')}
          </h2>
          <ul class="dm-lista-recensioni" role="list">
            {recensioni.map((r) => (
              <li data-reveal="alto">
                <blockquote class="dm-recensione">
                  <p class="font-display dm-citazione">«{text(r.text, lang)}»</p>
                  <footer class="didascalia">
                    <strong>{r.author}</strong>
                    {text(r.eventName, lang) && <span> · {text(r.eventName, lang)}</span>}
                    {r.date && (
                      <span>
                        {' '}
                        · <time datetime={r.date}>{formatDate(r.date, lang)}</time>
                      </span>
                    )}
                  </footer>
                </blockquote>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    stampa.length > 0 && (
      <section class="dm-stampa container-gaia" data-theme="light" aria-labelledby="dm-stampa-titolo">
        <h2 id="dm-stampa-titolo" class="eyebrow" data-reveal="alto">
          {t('reviews.stampa')}
        </h2>
        <ul class="dm-lista-stampa" role="list">
          {stampa.map((a) => {
            const logo = picture(a.logo, lang, '160px');
            const estratto = text(a.excerpt, lang);
            return (
              <li class="dm-articolo" data-reveal="alto">
                <p class="dm-testata">
                  {logo ? <Picture data={logo} class="dm-testata-logo" /> : a.outlet}
                  {a.date && (
                    <time class="didascalia" datetime={a.date}>
                      {formatDate(a.date, lang)}
                    </time>
                  )}
                </p>
                <h3 class="font-display dm-articolo-titolo">
                  {a.url ? (
                    <a href={a.url} rel="noopener" target="_blank">
                      {a.title}
                    </a>
                  ) : (
                    a.title
                  )}
                </h3>
                {estratto && <p class="dm-estratto">{estratto}</p>}
                {a.url && (
                  <a class="link-filo dm-leggi" href={a.url} rel="noopener" target="_blank">
                    {t('cta.readMore')}
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  {
    clienti.length > 0 && (
      <section class="dm-clienti" data-theme="light" aria-labelledby="dm-clienti-titolo">
        <div class="container-gaia">
          <h2 id="dm-clienti-titolo" class="eyebrow" data-reveal="alto">
            {t('reviews.clienti')}
          </h2>
          <ul class="dm-loghi" role="list" data-reveal="alto">
            {clienti.map((c) => {
              const logo = picture(c.logo, lang, '160px');
              return (
                <li>
                  {logo ? (
                    <Picture data={logo} class="dm-logo" />
                  ) : (
                    <span class="dm-logo-nome">{c.name}</span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  {
    preventivo && (
      <p class="dm-chiusura container-gaia">
        <a class="btn" href={path('quote', lang)}>
          {t('cta.quote')}
        </a>
      </p>
    )
  }
</BaseLayout>

<style>
  .dm-testa {
    padding-top: calc(var(--altezza-header, 146px) + clamp(1.5rem, 5vh, 3.5rem));
    padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }

  .dm-testa .eyebrow {
    margin: 0 0 0.9rem;
  }

  .dm-titolo {
    max-width: 16ch;
    margin: 0;
  }

  .dm-intro {
    max-width: 40rem;
    margin: 1.25rem 0 0;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--color-grigio-caldo);
  }

  /* — Recensioni: fondo notte, citazioni grandi come in home — */
  .dm-recensioni {
    padding-block: var(--spacing-section);
  }

  .dm-lista-recensioni {
    display: grid;
    gap: clamp(2.5rem, 5vh, 4rem) 4rem;
    margin: clamp(2rem, 4vh, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 64rem) {
    .dm-lista-recensioni {
      grid-template-columns: 1fr 1fr;
    }

    /* Una sola recensione: al centro, larga. */
    .dm-lista-recensioni:has(li:only-child) {
      grid-template-columns: minmax(0, 56rem);
      justify-content: center;
      text-align: center;
    }
  }

  .dm-recensione {
    margin: 0;
  }

  .dm-citazione {
    margin: 0 0 1rem;
    font-size: var(--text-title);
    line-height: 1.3;
    font-weight: 400;
  }

  .dm-recensione footer strong {
    font-weight: 500;
  }

  /* — Stampa: elenco in due colonne — */
  .dm-stampa {
    padding-block: var(--spacing-section-sm) var(--spacing-section);
  }

  .dm-lista-stampa {
    display: grid;
    gap: 2.5rem 3rem;
    margin: clamp(1.5rem, 3vh, 2.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .dm-lista-stampa {
      grid-template-columns: 1fr 1fr;
    }
  }

  .dm-articolo {
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-inchiostro) 14%, transparent);
  }

  .dm-testata {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: 0 0 0.75rem;
    font-size: var(--text-caption);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .dm-testata :global(.dm-testata-logo) {
    height: 28px;
    width: auto;
  }

  .dm-testata time {
    text-transform: none;
    letter-spacing: 0;
  }

  .dm-articolo-titolo {
    margin: 0;
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    font-weight: 400;
  }

  .dm-articolo-titolo a {
    text-decoration: none;
    color: inherit;
  }

  .dm-articolo-titolo a:hover {
    color: var(--color-bordeaux);
  }

  .dm-estratto {
    max-width: 34rem;
    margin: 0.75rem 0 0;
    color: var(--color-grigio-caldo);
  }

  .dm-leggi {
    display: inline-block;
    margin-top: 0.9rem;
  }

  /* — Hanno scelto Gaia: una fila di loghi, muta — */
  .dm-clienti {
    padding-block: var(--spacing-section-sm);
    background: var(--color-beige);
    text-align: center;
  }

  .dm-clienti .eyebrow {
    justify-content: center;
  }

  .dm-loghi {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2rem clamp(2rem, 5vw, 4.5rem);
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .dm-loghi :global(.dm-logo) {
    height: clamp(28px, 4vw, 44px);
    width: auto;
    max-width: 160px;
    object-fit: contain;
    opacity: 0.8;
  }

  .dm-logo-nome {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.02em;
  }

  .dm-chiusura {
    padding-block: var(--spacing-section-sm) var(--spacing-section);
    text-align: center;
  }

  @media (max-width: 63.98rem) {
    .dm-testa {
      padding-top: calc(var(--altezza-header, 96px) + 1rem);
    }
  }
</style>
