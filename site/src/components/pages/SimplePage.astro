---
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path, type RouteKey } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPage, text } from '../../lib/content';
import { langsFor } from '../../lib/availability';
import { breadcrumbs } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';
import PlaceholderSection from '../PlaceholderSection.astro';

/**
 * Pagina di solo testo gestita dal back office: chi sono, privacy, cookie.
 * Il body è HTML già sanificato lato PHP.
 */
interface Props {
  lang: Lang;
  routeKey: RouteKey;
}

const { lang, routeKey } = Astro.props;
const t = useTranslations(lang);

const page = getPage(routeKey);
const langs = langsFor(routeKey);

const title = text(page?.title, lang);
const body = text(page?.body, lang);

// Blocchi ripetibili: percorso e valori in «chi sono». Un blocco compare
// solo se ha almeno una voce tradotta in questa lingua.
const blocks = (page?.blocks ?? [])
  .map((block) => ({
    ...block,
    items: (block.items ?? []).filter((item) => text(item.title, lang)),
  }))
  .filter((block) => text(block.title, lang) || block.items.length > 0)
  .sort((a, b) => a.order - b.order);

const meta = buildMeta({
  lang,
  routeKey,
  title,
  description: text(page?.intro, lang),
  seo: page ?? undefined,
  image: page?.hero ?? null,
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: title, href: path(routeKey, lang) },
];

const jsonLd = [breadcrumbs(crumbs)];
---

<BaseLayout
  lang={lang}
  routeKey={routeKey}
  meta={meta}
  availableLangs={langs}
  jsonLd={jsonLd}
  crumbs={crumbs}
>
  <h1>{title}</h1>
  {text(page?.intro, lang) && <p>{text(page?.intro, lang)}</p>}

  {body ? <div set:html={body} /> : <PlaceholderSection lang={lang} id={routeKey} />}

  {
    blocks.map((block) => (
      <section data-block={block.kind}>
        <h2>{text(block.title, lang)}</h2>
        {text(block.text, lang) && <p>{text(block.text, lang)}</p>}
        {
          block.items.length > 0 && (
            <ul>
              {block.items.map((item) => (
                <li>
                  {item.label && <strong>{item.label}</strong>}
                  {' '}
                  <strong>{text(item.title, lang)}</strong>
                  {text(item.text, lang) && <p>{text(item.text, lang)}</p>}
                </li>
              ))}
            </ul>
          )
        }
      </section>
    ))
  }

  {page?.updatedAt && <p><small>{t('common.publishedOn')} {page.updatedAt}</small></p>}
</BaseLayout>
