---
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path, type RouteKey } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPage, text } from '../../lib/content';
import { langsFor } from '../../lib/availability';
import { breadcrumbs } from '../../lib/jsonld';
import { buildMeta } from '../../lib/seo';
import PlaceholderSection from '../PlaceholderSection.astro';

/**
 * Pagina di solo testo gestita dal back office: chi sono, privacy, cookie.
 * Il body è HTML già sanificato lato PHP.
 */
interface Props {
  lang: Lang;
  routeKey: RouteKey;
}

const { lang, routeKey } = Astro.props;
const t = useTranslations(lang);

const page = getPage(routeKey);
const langs = langsFor(routeKey);

const title = text(page?.title, lang);
const body = text(page?.body, lang);

const meta = buildMeta({
  lang,
  routeKey,
  title,
  description: text(page?.intro, lang),
  seo: page ?? undefined,
  image: page?.hero ?? null,
  availableLangs: langs,
});

const crumbs = [
  { name: t('nav.home'), href: path('home', lang) },
  { name: title, href: path(routeKey, lang) },
];

const jsonLd = [breadcrumbs(crumbs)];
---

<BaseLayout
  lang={lang}
  routeKey={routeKey}
  meta={meta}
  availableLangs={langs}
  jsonLd={jsonLd}
  crumbs={crumbs}
>
  <h1>{title}</h1>
  {text(page?.intro, lang) && <p>{text(page?.intro, lang)}</p>}

  {body ? <div set:html={body} /> : <PlaceholderSection lang={lang} id={routeKey} />}

  {page?.updatedAt && <p><small>{t('common.publishedOn')} {page.updatedAt}</small></p>}
</BaseLayout>
