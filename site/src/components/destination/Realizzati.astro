---
/**
 * Destination — 7. Matrimoni arrivati da lontano: gli eventi di «I miei
 * eventi» marcati come destination (stories.destination), pubblicati in
 * questa lingua. Card con copertina, titolo e location, che portano al
 * racconto. Nessun evento marcato: la sezione non esiste.
 */
import type { Lang } from '../../config/site';
import { path } from '../../i18n/routes';
import { STORY_FIELDS } from '../../lib/availability';
import { getStories, isPublishable, pick, text } from '../../lib/content';
import { picture } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  titolo: string;
}

const { lang, titolo } = Astro.props;

const eventi = getStories()
  .filter((s) => s.destination === true && isPublishable(s, lang, STORY_FIELDS))
  .slice(0, 6)
  .map((s) => ({
    titolo: text(s.title, lang),
    luogo: s.locationName ?? '',
    href: path('stories', lang, pick(s.slug, lang)!),
    foto: picture(s.cover, lang, '(min-width: 64rem) 30vw, (min-width: 48rem) 46vw, 92vw'),
  }));
---

{
  eventi.length > 0 && titolo && (
    <section class="dw-realizzati container-gaia" data-theme="light" aria-labelledby="titolo-realizzati">
      <h2 id="titolo-realizzati" class="font-display dw-realizzati-titolo" data-reveal="righe">
        {titolo}
      </h2>
      <ul class="dw-realizzati-elenco" role="list" data-reveal-gruppo>
        {eventi.map((e) => (
          <li data-reveal="alto">
            <a class="dw-evento" href={e.href}>
              {e.foto && (
                <figure class="dw-evento-foto">
                  <Picture data={e.foto} cap={false} class="dw-evento-img" />
                </figure>
              )}
              <span class="font-display dw-evento-titolo">{e.titolo}</span>
              {e.luogo && <span class="dw-evento-luogo">{e.luogo}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .dw-realizzati {
    padding-block: var(--spacing-section);
  }

  .dw-realizzati-titolo {
    margin: 0 0 clamp(2rem, 5vh, 3rem);
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    font-weight: 400;
  }

  .dw-realizzati-elenco {
    display: grid;
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dw-evento {
    display: grid;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .dw-evento-foto {
    margin: 0 0 0.75rem;
    overflow: hidden;
    border-radius: 16px;
    aspect-ratio: 4 / 5;
  }

  .dw-evento-foto :global(picture),
  .dw-evento-foto :global(.dw-evento-img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transition: scale 0.8s var(--ease-gaia);
  }

  .dw-evento:hover :global(.dw-evento-img),
  .dw-evento:focus-visible :global(.dw-evento-img) {
    scale: 1.04;
  }

  .dw-evento-luogo {
    font-size: var(--text-eyebrow);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-oro-testo);
  }

  .dw-evento-titolo {
    font-size: clamp(1.5rem, 1.25rem + 0.8vw, 1.875rem);
    line-height: 1.15;
  }

  @media (min-width: 48rem) {
    .dw-realizzati-elenco {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .dw-realizzati-elenco {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dw-evento-foto :global(.dw-evento-img) {
      transition: none;
    }
  }
</style>
