---
/**
 * Articolo — 2. «In breve»: 3–4 punti chiave (posts.sommario_it/en, un
 * punto per riga). Riquadro con il filetto oro, numeri in Cormorant.
 * Senza punti nella lingua il riquadro non c'è.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';

interface Props {
  lang: Lang;
  punti: string[];
}

const { lang, punti } = Astro.props;
const t = useTranslations(lang);
---

{
  punti.length > 0 && (
    <aside class="mg-breve" aria-labelledby="titolo-breve">
      <h2 id="titolo-breve" class="mg-breve-titolo">
        {t('magazine.inBreve')}
      </h2>
      <ol class="mg-breve-punti" role="list">
        {punti.map((p, i) => (
          <li>
            <span class="font-display mg-breve-num" aria-hidden="true">
              {i + 1}
            </span>
            <span>{p}</span>
          </li>
        ))}
      </ol>
    </aside>
  )
}

<style>
  .mg-breve {
    margin: 0 0 clamp(2.5rem, 6vh, 3.5rem);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 2px solid var(--color-oro);
    border-radius: 0 0 16px 16px;
    background: var(--color-bianco-caldo);
  }

  .mg-breve-titolo {
    margin: 0 0 1rem;
    font-family: var(--font-sans);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-oro-testo);
  }

  .mg-breve-punti {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mg-breve-punti li {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
  }

  .mg-breve-num {
    font-size: 1.5rem;
    font-style: italic;
    line-height: 1;
    color: var(--color-oro-testo);
  }
</style>
