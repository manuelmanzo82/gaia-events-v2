---
import { BUSINESS, type Lang } from '../config/site';
import { useTranslations } from '../i18n';
import { path, type RouteKey } from '../i18n/routes';
import { existsIn } from '../lib/availability';
import { getSettings, text } from '../lib/content';
import Icona from './Icona.astro';
import LangSwitcher from './LangSwitcher.astro';
import LogoGaia from './LogoGaia.astro';

/**
 * Footer su fondo notte (giro 11): logo grande in avorio e una frase breve
 * (la tagline delle impostazioni); tre colonne uguali — Contatti (email,
 * WhatsApp, indirizzo e, sotto, Seguici con Instagram e Facebook),
 * Esplora (tutte le pagine su due sottocolonne, nessuna voce a capo),
 * Preventivo (testo + bottone) — e la riga legale con © anno, P.IVA
 * (impostazione legal.piva: finché manca c'è il segnaposto), Privacy,
 * Cookie e lingua.
 *
 * Come nel menu: niente link verso pagine che in questa lingua non
 * esistono (existsIn). Su mobile le colonne si impilano nello stesso
 * ordine e ogni link ha almeno 44 px di altezza. Hover: stessa
 * sottolineatura sottile per tutte le voci, anche su più righe (va sul
 * testo, non su un ::after assoluto).
 */
interface Props {
  lang: Lang;
  routeKey?: RouteKey;
  slug?: string;
  availableLangs?: readonly Lang[];
}

const { lang, routeKey = 'home', slug, availableLangs } = Astro.props;
const t = useTranslations(lang);
const settings = getSettings();

const year = new Date().getFullYear();
const whatsappHref = `https://wa.me/${BUSINESS.whatsapp}`;
const indirizzo = text(settings.contact.address, lang) || `${BUSINESS.street}, ${BUSINESS.postalCode} ${BUSINESS.city}`;
const tagline = text(settings.tagline, lang);
const piva = text(settings.legal.piva, lang);

// Stesso ordine del menu, poi le pagine che stanno solo qui.
const ESPLORA: RouteKey[] = [
  'about',
  'services',
  'places',
  'stories',
  'reviews',
  'blog',
  'destinationWedding',
  'partners',
  'faq',
  'contact',
];
const etichetta: Record<string, string> = {
  about: t('nav.about'),
  services: t('nav.services'),
  places: t('nav.places'),
  stories: t('nav.stories'),
  reviews: t('nav.reviews'),
  blog: t('nav.blog'),
  destinationWedding: t('nav.destinationWedding'),
  partners: t('nav.partners'),
  faq: t('nav.faq'),
  contact: t('nav.contact'),
};
const esplora = ESPLORA.filter((key) => existsIn(key, lang));
const righe = Math.ceil(esplora.length / 2);
const preventivo = existsIn('quote', lang) ? 'quote' : existsIn('contact', lang) ? 'contact' : null;
const legali = (['privacy', 'cookie'] as RouteKey[]).filter((key) => existsIn(key, lang));
---

<footer class="site-footer" data-theme="dark">
  <div class="container-gaia footer-interno">
    <div class="footer-testa">
      <a class="footer-logo" href={path('home', lang)} aria-label="Gaia Events">
        <LogoGaia />
      </a>
      {tagline && <p class="font-display footer-frase">{tagline}</p>}
    </div>

    <div class="footer-colonne">
      <section class="footer-colonna">
        <h2 class="footer-titolo">{t('footer.contacts')}</h2>
        <ul class="footer-lista">
          <li>
            <a href={`mailto:${BUSINESS.email}`} class="footer-icona">
              <Icona nome="email" dimensione={18} />
              <span>{BUSINESS.email}</span>
            </a>
          </li>
          <li>
            <a href={whatsappHref} rel="noopener" class="footer-icona">
              <Icona nome="whatsapp" dimensione={18} />
              <span>{t('cta.whatsapp')}</span>
            </a>
          </li>
          <li><span class="footer-indirizzo">{indirizzo}</span></li>
        </ul>

        <h2 class="footer-titolo footer-titolo--seguici">{t('footer.social')}</h2>
        <ul class="footer-lista">
          <li>
            <a href={BUSINESS.instagramUrl} rel="noopener me" class="footer-icona">
              <Icona nome="instagram" dimensione={18} />
              <span>Instagram</span>
            </a>
          </li>
          <li>
            <a href={BUSINESS.facebookUrl} rel="noopener me" class="footer-icona">
              <Icona nome="facebook" dimensione={18} />
              <span>Facebook</span>
            </a>
          </li>
        </ul>
      </section>

      <nav class="footer-colonna" aria-label={t('footer.explore')}>
        <h2 class="footer-titolo">{t('footer.explore')}</h2>
        <ul class="footer-lista footer-lista--due" style={`--righe: ${righe}`}>
          {
            esplora.map((key) => (
              <li>
                <a href={path(key, lang)}>
                  <span>{etichetta[key]}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        preventivo && (
          <section class="footer-colonna footer-cta">
            <h2 class="footer-titolo">{t('nav.quote')}</h2>
            <p class="footer-cta-testo">{text(settings.sections.cta?.text, lang)}</p>
            <a class="btn" href={path(preventivo, lang)}>
              {t('cta.quote')}
            </a>
          </section>
        )
      }
    </div>

    <div class="footer-legale">
      <p class="footer-legale-testo">
        © {year} {BUSINESS.legalName}
        <span class="footer-sep" aria-hidden="true">·</span>
        {t('footer.vat')} {piva || t('footer.vatMissing')}
      </p>
      <ul class="footer-legale-link">
        {
          legali.map((key) => (
            <li>
              <a href={path(key, lang)}>{key === 'privacy' ? t('footer.privacy') : t('footer.cookie')}</a>
            </li>
          ))
        }
        <li>
          <LangSwitcher lang={lang} routeKey={routeKey} slug={slug} availableLangs={availableLangs} />
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --logo-h: 80px;
    --logo-h-md: 110px;
    background: var(--color-notte);
    color: var(--color-avorio-su-notte);
    font-size: 0.9rem;
  }

  /* Meno aria tra l'ultima sezione e il logo (giro 10). */
  .footer-interno {
    padding-block: clamp(2.5rem, 6vh, 4rem) 2rem;
  }

  /* Su mobile, in fondo, spazio per il tondo WhatsApp (40 px + 16 di
     margine): non copre mai i link legali. */
  @media (max-width: 63.98rem) {
    .footer-interno {
      padding-bottom: calc(2rem + 64px);
    }
  }

  .footer-testa {
    display: grid;
    gap: 1.25rem;
    padding-bottom: clamp(2.5rem, 6vh, 4rem);
    border-bottom: 1px solid color-mix(in srgb, var(--color-avorio-su-notte) 16%, transparent);
  }

  .footer-logo {
    display: inline-flex;
    line-height: 0;
    color: var(--color-avorio-su-notte);
    text-decoration: none;
  }

  .footer-frase {
    margin: 0;
    font-size: var(--text-title);
    font-weight: 320;
    color: var(--color-velato-su-notte);
  }

  .footer-colonne {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 6vh, 4rem);
  }

  .footer-titolo {
    margin: 0 0 0.75rem;
    font-family: var(--font-sans);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-oro);
  }

  .footer-titolo--seguici {
    margin-top: 1.75rem;
  }

  .footer-lista {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-lista a,
  .footer-indirizzo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-avorio-su-notte);
    text-decoration: none;
  }

  /* Hover: sottolineatura sottile sul testo, uguale per tutte le voci
     e corretta anche quando il testo va a capo. */
  .footer-lista a span {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.3s var(--ease-gaia);
  }

  .footer-lista a:hover span,
  .footer-lista a:focus-visible span {
    text-decoration-color: currentColor;
  }

  .footer-icona {
    gap: 0.6rem;
  }

  .footer-icona svg {
    flex: none;
  }

  .footer-indirizzo {
    color: var(--color-velato-su-notte);
  }

  /* Esplora: due sottocolonne riempite in verticale, voci mai a capo. */
  .footer-lista--due {
    grid-template-columns: repeat(2, max-content);
    grid-auto-flow: column;
    grid-template-rows: repeat(var(--righe, 5), auto);
    column-gap: 2rem;
  }

  .footer-lista--due a {
    white-space: nowrap;
  }

  .footer-cta-testo {
    margin: 0 0 1.25rem;
    max-width: 24rem;
    color: var(--color-velato-su-notte);
  }

  .footer-legale {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-avorio-su-notte) 16%, transparent);
    font-size: var(--text-caption);
    color: var(--color-velato-su-notte);
  }

  .footer-legale-testo {
    margin: 0;
  }

  .footer-sep {
    margin-inline: 0.6rem;
  }

  .footer-legale-link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-legale-link a,
  :global(.site-footer .lang-switcher a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-velato-su-notte);
    text-decoration: none;
  }

  .footer-legale-link a:hover,
  :global(.site-footer .lang-switcher a:hover) {
    color: var(--color-avorio-su-notte);
  }

  /* Tablet: Contatti ed Esplora affiancate, Preventivo sotto a tutta
     larghezza. */
  @media (min-width: 48rem) {
    .footer-colonne {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-cta {
      grid-column: 1 / -1;
    }
  }

  /* Desktop: tre colonne uguali. */
  @media (min-width: 64rem) {
    .footer-testa {
      grid-template-columns: auto 1fr;
      align-items: end;
      gap: 3rem;
    }

    .footer-colonne {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem;
    }

    .footer-cta {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-lista a span {
      transition: none;
    }
  }
</style>
