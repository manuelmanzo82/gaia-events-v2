---
import { BUSINESS, type Lang } from '../config/site';
import { useTranslations } from '../i18n';
import { path, type RouteKey } from '../i18n/routes';
import { existsIn } from '../lib/availability';
import { getSettings, text } from '../lib/content';
import LangSwitcher from './LangSwitcher.astro';
import LogoGaia from './LogoGaia.astro';

/**
 * Footer su fondo notte: logo grande in avorio e una frase breve (la
 * tagline delle impostazioni); quattro colonne — Contatti, Esplora (tutte
 * le pagine, comprese quelle tolte dal menu), Social, CTA — e la riga
 * legale con © anno, P.IVA (impostazione legal.piva: finché manca c'è il
 * segnaposto), Privacy, Cookie e lingua.
 *
 * Come nel menu: niente link verso pagine che in questa lingua non
 * esistono (existsIn). Su mobile le colonne si impilano e ogni link ha
 * almeno 44 px di altezza.
 */
interface Props {
  lang: Lang;
  routeKey?: RouteKey;
  slug?: string;
  availableLangs?: readonly Lang[];
}

const { lang, routeKey = 'home', slug, availableLangs } = Astro.props;
const t = useTranslations(lang);
const settings = getSettings();

const year = new Date().getFullYear();
const whatsappHref = `https://wa.me/${BUSINESS.whatsapp}`;
const indirizzo = text(settings.contact.address, lang) || `${BUSINESS.street}, ${BUSINESS.postalCode} ${BUSINESS.city}`;
const tagline = text(settings.tagline, lang);
const piva = text(settings.legal.piva, lang);

const ESPLORA: RouteKey[] = [
  'about',
  'services',
  'places',
  'stories',
  'destinationWedding',
  'portfolio',
  'reviews',
  'partners',
  'blog',
  'faq',
  'contact',
];
const etichetta: Record<string, string> = {
  about: t('nav.about'),
  services: t('nav.services'),
  places: t('nav.places'),
  stories: t('nav.stories'),
  destinationWedding: t('nav.destinationWedding'),
  portfolio: t('nav.portfolio'),
  reviews: t('nav.reviews'),
  partners: t('nav.partners'),
  blog: t('nav.blog'),
  faq: t('nav.faq'),
  contact: t('nav.contact'),
};
const esplora = ESPLORA.filter((key) => existsIn(key, lang));
const preventivo = existsIn('quote', lang) ? 'quote' : existsIn('contact', lang) ? 'contact' : null;
const legali = (['privacy', 'cookie'] as RouteKey[]).filter((key) => existsIn(key, lang));
---

<footer class="site-footer" data-theme="dark">
  <div class="container-gaia footer-interno">
    <div class="footer-testa">
      <a class="footer-logo" href={path('home', lang)} aria-label="Gaia Events">
        <LogoGaia />
      </a>
      {tagline && <p class="font-display footer-frase">{tagline}</p>}
    </div>

    <div class="footer-colonne">
      <section class="footer-colonna">
        <h2 class="footer-titolo">{t('footer.contacts')}</h2>
        <ul class="footer-lista">
          <li><a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a></li>
          <li><a href={whatsappHref} rel="noopener">{t('cta.whatsapp')}</a></li>
          <li><span class="footer-indirizzo">{indirizzo}</span></li>
        </ul>
      </section>

      <nav class="footer-colonna" aria-label={t('footer.explore')}>
        <h2 class="footer-titolo">{t('footer.explore')}</h2>
        <ul class="footer-lista footer-lista--due">
          {esplora.map((key) => <li><a href={path(key, lang)}>{etichetta[key]}</a></li>)}
        </ul>
      </nav>

      <section class="footer-colonna">
        <h2 class="footer-titolo">{t('footer.social')}</h2>
        <ul class="footer-lista">
          <li>
            <a href={BUSINESS.instagramUrl} rel="noopener me" class="footer-social">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none"/></svg>
              <span>Instagram</span>
            </a>
          </li>
          <li>
            <a href={BUSINESS.facebookUrl} rel="noopener me" class="footer-social">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 8.5V6.8c0-.9.5-1.3 1.3-1.3H17V2.5h-2.5C11.7 2.5 10.5 4.3 10.5 7v1.5H8V12h2.5v9.5H14V12h2.6l.4-3.5H14z"/></svg>
              <span>Facebook</span>
            </a>
          </li>
        </ul>
      </section>

      {
        preventivo && (
          <section class="footer-colonna footer-cta">
            <h2 class="footer-titolo">{t('nav.quote')}</h2>
            <p class="footer-cta-testo">{text(settings.sections.cta?.text, lang)}</p>
            <a class="btn" href={path(preventivo, lang)}>
              {t('cta.quote')}
            </a>
          </section>
        )
      }
    </div>

    <div class="footer-legale">
      <p class="footer-legale-testo">
        © {year} {BUSINESS.legalName}
        <span class="footer-sep" aria-hidden="true">·</span>
        {t('footer.vat')} {piva || t('footer.vatMissing')}
      </p>
      <ul class="footer-legale-link">
        {
          legali.map((key) => (
            <li>
              <a href={path(key, lang)}>{key === 'privacy' ? t('footer.privacy') : t('footer.cookie')}</a>
            </li>
          ))
        }
        <li>
          <LangSwitcher lang={lang} routeKey={routeKey} slug={slug} availableLangs={availableLangs} />
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --logo-h: 80px;
    --logo-h-md: 110px;
    background: var(--color-notte);
    color: var(--color-avorio-su-notte);
    font-size: 0.9rem;
  }

  /* Meno aria tra l'ultima sezione e il logo (giro 10). */
  .footer-interno {
    padding-block: clamp(2.5rem, 6vh, 4rem) 2rem;
  }

  /* Su mobile, in fondo, spazio per il tondo WhatsApp (40 px + 16 di
     margine): non copre mai i link legali. */
  @media (max-width: 63.98rem) {
    .footer-interno {
      padding-bottom: calc(2rem + 64px);
    }
  }

  .footer-testa {
    display: grid;
    gap: 1.25rem;
    padding-bottom: clamp(2.5rem, 6vh, 4rem);
    border-bottom: 1px solid color-mix(in srgb, var(--color-avorio-su-notte) 16%, transparent);
  }

  .footer-logo {
    display: inline-flex;
    line-height: 0;
    color: var(--color-avorio-su-notte);
    text-decoration: none;
  }

  .footer-frase {
    margin: 0;
    font-size: var(--text-title);
    font-weight: 320;
    color: var(--color-velato-su-notte);
  }

  .footer-colonne {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 6vh, 4rem);
  }

  .footer-titolo {
    margin: 0 0 1rem;
    font-family: var(--font-sans);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-oro);
  }

  .footer-lista {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-lista a,
  .footer-indirizzo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-avorio-su-notte);
    text-decoration: none;
  }

  .footer-lista a {
    position: relative;
  }

  .footer-lista a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 8px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-gaia);
  }

  .footer-lista a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .footer-indirizzo {
    color: var(--color-velato-su-notte);
  }

  .footer-social {
    gap: 0.6rem;
  }

  .footer-cta-testo {
    margin: 0 0 1.25rem;
    max-width: 22rem;
    color: var(--color-velato-su-notte);
  }

  .footer-legale {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-avorio-su-notte) 16%, transparent);
    font-size: var(--text-caption);
    color: var(--color-velato-su-notte);
  }

  .footer-legale-testo {
    margin: 0;
  }

  .footer-sep {
    margin-inline: 0.6rem;
  }

  .footer-legale-link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-legale-link a,
  :global(.site-footer .lang-switcher a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-velato-su-notte);
    text-decoration: none;
  }

  .footer-legale-link a:hover,
  :global(.site-footer .lang-switcher a:hover) {
    color: var(--color-avorio-su-notte);
  }

  @media (min-width: 48rem) {
    .footer-colonne {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-lista--due {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .footer-testa {
      grid-template-columns: auto 1fr;
      align-items: end;
      gap: 3rem;
    }

    .footer-colonne {
      grid-template-columns: 1.1fr 1.4fr 0.9fr 1.3fr;
      gap: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-lista a::after {
      transition: none;
    }
  }
</style>
