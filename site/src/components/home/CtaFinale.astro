---
/**
 * CTA finale (giro 4): due metà a tutta larghezza, rif. sarahhaywood.com.
 *
 *  - a sinistra la foto A FILO BORDO (il primo highlight della sezione
 *    «cta»), senza margini, alta quanto la sezione;
 *  - a destra, su beige: titolo grande, una riga, la firma «Gaia» in
 *    Cormorant corsivo, il bottone bordeaux al preventivatore (o ai
 *    contatti, se in questa lingua il preventivo non esiste) e due link
 *    discreti con icona, WhatsApp ed email.
 *
 * Sotto i 64rem: foto 4:5 a tutta larghezza, poi il testo. Testi da
 * settings.sections.cta; contatti da BUSINESS.
 */
import { BUSINESS, type Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import { existsIn } from '../../lib/availability';
import { getHighlights, text, type Settings } from '../../lib/content';
import { picture } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  settings: Settings;
}

const { lang, settings } = Astro.props;
const t = useTranslations(lang);

const sezione = settings.sections.cta;
const titolo = text(sezione?.title, lang);
const testo = text(sezione?.text, lang);

const destinazione = existsIn('quote', lang) ? 'quote' : existsIn('contact', lang) ? 'contact' : null;
const etichetta = destinazione === 'quote' ? t('cta.quote') : t('cta.contact');

// Metà schermo a desktop, tutta la larghezza sotto.
const foto = picture(getHighlights('cta')[0]?.image ?? null, lang, '(min-width: 64rem) 50vw, 100vw');

const whatsappHref = `https://wa.me/${BUSINESS.whatsapp}`;
const emailHref = `mailto:${BUSINESS.email}`;
---

{
  titolo && destinazione && (
    <section id="cta" class:list={['cta-finale', { 'cta-finale--senza-foto': !foto }]} data-theme="light">
      {foto && (
        <figure class="cta-figura" data-theme="dark" data-foto>
          <Picture data={foto} cap={false} class="cta-img" />
        </figure>
      )}

      <div class="cta-meta">
        <div class="cta-testo">
          <h2 class="font-display cta-titolo" data-reveal="righe">
            {titolo}
          </h2>
          {testo && (
            <p class="text-lead cta-riga" data-reveal="alto">
              {testo}
            </p>
          )}
          <p class="font-display cta-firma" data-reveal="alto" aria-hidden="true">
            {t('cta.firma')}
          </p>
          <p class="cta-coda" data-reveal="alto">
            <a class="btn btn--pieno" href={path(destinazione, lang)}>
              {etichetta}
            </a>
          </p>
          <ul class="cta-contatti" role="list" data-reveal="alto">
            <li>
              <a href={whatsappHref} rel="noopener" target="_blank" aria-label={t('cta.whatsapp')}>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.3z" />
                  <path d="M9.2 8.6c.2-.5.5-.5.8-.5h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.2-.1.3 0 .5a6.4 6.4 0 0 0 3 2.8c.2.1.4.1.5-.1l.7-.8c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.2.3.4 0 .5-.2 1.1-.6 1.4-.5.4-1.2.6-1.8.5-3.1-.6-5.6-3-6.3-6.1-.2-.7 0-1.4.1-2z" />
                </svg>
                <span>WhatsApp</span>
              </a>
            </li>
            <li>
              <a href={emailHref}>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2.5" y="5" width="19" height="14" rx="2" />
                  <path d="M3 6l9 7 9-7" />
                </svg>
                <span>{BUSINESS.email}</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>
  )
}

<style>
  .cta-finale {
    display: grid;
    background: var(--color-beige);
  }

  /* — Foto a filo bordo — */
  .cta-figura {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-beige) 60%, var(--color-notte));
  }

  .cta-figura :global(picture),
  .cta-figura :global(.cta-img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .cta-figura :global(.cta-img) {
    object-fit: cover;
  }

  /* — Metà di testo — */
  .cta-meta {
    display: grid;
    align-content: center;
    padding: clamp(3rem, 8vh, 5rem) clamp(1.25rem, 4vw, 3.5rem);
  }

  .cta-testo {
    max-width: 34rem;
  }

  .cta-titolo {
    margin: 0;
    font-size: clamp(2.5rem, 1.75rem + 3.4vw, 5.25rem);
    font-weight: 320;
    line-height: 1.04;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .cta-riga {
    max-width: 28rem;
    margin: 1.5rem 0 0;
    color: var(--color-grigio-caldo);
  }

  .cta-firma {
    margin: 1.75rem 0 0;
    font-size: clamp(2.25rem, 1.5rem + 1.6vw, 3rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-bordeaux);
  }

  .cta-coda {
    margin: 2rem 0 0;
  }

  /* Due link discreti con icona, in riga. */
  .cta-contatti {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cta-contatti a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    color: var(--color-inchiostro);
    text-decoration: none;
    transition: color 0.35s var(--ease-gaia);
  }

  .cta-contatti a span {
    border-bottom: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    transition: border-color 0.35s var(--ease-gaia);
  }

  .cta-contatti a:hover {
    color: var(--color-bordeaux);
  }

  .cta-contatti a:hover span {
    border-color: currentColor;
  }

  .cta-contatti a:focus-visible {
    outline: 2px solid var(--color-bordeaux);
    outline-offset: 4px;
  }

  .cta-contatti svg {
    flex: none;
  }

  /* — Mobile: testo con 56 px sopra e sotto; link in colonna, così la
     freccia «torna su» (in basso a destra) non copre mai niente. — */
  @media (max-width: 63.98rem) {
    .cta-meta {
      padding-block: 3.5rem;
    }

    .cta-contatti {
      flex-direction: column;
      gap: 0.25rem;
    }
  }

  /* — Desktop: due metà, foto alta quanto la sezione — */
  @media (min-width: 64rem) {
    .cta-finale {
      grid-template-columns: 1fr 1fr;
      min-height: min(90svh, 56rem);
    }

    .cta-finale--senza-foto {
      grid-template-columns: 1fr;
    }

    .cta-figura {
      aspect-ratio: auto;
      height: 100%;
    }

    .cta-meta {
      padding: clamp(3rem, 8vh, 6rem) clamp(2.5rem, 6vw, 7rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-contatti a,
    .cta-contatti a span {
      transition: none;
    }
  }
</style>
