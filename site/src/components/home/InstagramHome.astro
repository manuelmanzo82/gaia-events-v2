---
/**
 * Instagram in home, prima della CTA finale, con l'aspetto di un profilo
 * Instagram (giro 4):
 *
 *  - intestazione CENTRATA: icona Instagram, @handle (è il titolo della
 *    sezione), bottone «Segui» (ghost, al profilo);
 *  - griglia di QUADRATI uguali 1:1 con gap sottile: 4 colonne × 2 righe
 *    da 64rem (8 post), 3 colonne × 2 righe sotto (6 post, gli altri due
 *    nascosti via CSS);
 *  - al passaggio del mouse o al focus: velo leggero e, al centro, l'icona
 *    del tipo di post (foto, reel, carosello), come su Instagram.
 *
 * Ogni foto apre il post (o il profilo, se il post non ha link) in una
 * nuova scheda. Foto lazy con width/height: nessun effetto su LCP e CLS.
 * Nessun post visibile → la sezione non esiste.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { getInstagram } from '../../lib/content';
import { picture } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const feed = getInstagram();
const POST_MAX = 8;
// Quadrato: ~15rem a desktop (griglia da 60rem su 4 colonne), un terzo
// dello schermo sotto.
const SIZES = '(min-width: 64rem) 15rem, 33vw';

const post = feed.posts
  .slice(0, POST_MAX)
  .map((p) => {
    const data = picture(p.image, lang, SIZES);
    if (!data) return null;
    const href = p.permalink || feed.profileUrl;
    const etichetta = `${data.alt ? data.alt + ' — ' : ''}${
      p.permalink ? t('instagram.apriPost') : t('instagram.apriProfilo')
    } (${t('instagram.nuovaScheda')})`;
    return { data, href, etichetta, tipo: p.tipo };
  })
  .filter((p): p is NonNullable<typeof p> => p !== null && !!p.href);
---

{
  post.length > 0 && feed.profileUrl && (
    <section id="instagram" class="ig" data-theme="light" aria-labelledby="ig-titolo">
      <header class="ig-testa container-gaia" data-reveal="alto">
        <span class="ig-logo" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
            <circle cx="12" cy="12" r="4.4" />
            <circle cx="17.6" cy="6.4" r="1.05" fill="currentColor" stroke="none" />
          </svg>
        </span>
        <h2 id="ig-titolo" class="ig-handle">
          <a href={feed.profileUrl} target="_blank" rel="noopener me">
            <span class="sr-only">{t('instagram.titolo')}: </span>
            {feed.handle || 'Instagram'}
          </a>
        </h2>
        <a class="btn ig-segui" href={feed.profileUrl} target="_blank" rel="noopener me">
          {t('instagram.segui')}
        </a>
      </header>

      <ul class="ig-griglia" role="list">
        {post.map((p) => (
          <li class="ig-voce">
            <a class="ig-link" href={p.href} target="_blank" rel="noopener" aria-label={p.etichetta}>
              <Picture data={p.data} cap={false} class="ig-img" />
              <span class="ig-velo" aria-hidden="true">
                {p.tipo === 'reel' ? (
                  <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
                    <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
                    <path d="M2.5 8h19M8 2.5l3 5.5M14 2.5l3 5.5" />
                    <path d="M10 11.5v6l5-3z" fill="currentColor" stroke="none" />
                  </svg>
                ) : p.tipo === 'carosello' ? (
                  <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
                    <rect x="7" y="7" width="14.5" height="14.5" rx="3.5" />
                    <path d="M17 4.5A2.5 2.5 0 0 0 14.5 2.5h-9A3 3 0 0 0 2.5 5.5v9A2.5 2.5 0 0 0 4.5 17" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
                    <rect x="2.5" y="2.5" width="19" height="19" rx="4" />
                    <path d="M2.5 16.5l5.5-5.5 4.5 4.5 3-3 6 6" />
                    <circle cx="16" cy="8" r="1.6" fill="currentColor" stroke="none" />
                  </svg>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .ig {
    padding-block: var(--spacing-section);
    background: var(--color-avorio);
  }

  /* — Intestazione da profilo, tutta centrata — */
  .ig-testa {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    margin-bottom: clamp(1.75rem, 4vh, 2.5rem);
    text-align: center;
  }

  .ig-logo {
    display: block;
    color: var(--color-inchiostro);
  }

  .ig-logo svg {
    display: block;
  }

  /* Il titolo è l'handle: niente overflow hidden, line-height ampio
     perché le discendenti (g, p) restino intere. */
  .ig-handle {
    margin: 0;
    padding-block: 0.1em;
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 320;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .ig-handle a {
    color: inherit;
    text-decoration: none;
    transition: color 0.35s var(--ease-gaia);
  }

  .ig-handle a:hover {
    color: var(--color-bordeaux);
  }

  .ig-handle a:focus-visible {
    outline: 2px solid var(--color-bordeaux);
    outline-offset: 4px;
  }

  .ig-segui {
    min-width: 9rem;
    padding-block: 0.8rem;
  }

  /* — Griglia di quadrati — */
  .ig-griglia {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3px;
    width: min(100% - 2 * clamp(1.25rem, 4vw, 3.5rem), 60rem);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  /* Sotto i 64rem: 3 × 2, i post oltre il sesto non si vedono. */
  .ig-voce:nth-child(n + 7) {
    display: none;
  }

  .ig-link {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: var(--color-beige);
    color: var(--color-avorio-su-notte);
  }

  .ig-link :global(picture),
  .ig-link :global(.ig-img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ig-link :global(.ig-img) {
    object-fit: cover;
    transition: transform 0.9s var(--ease-gaia);
  }

  /* Velo leggero con l'icona del tipo di post al centro. */
  .ig-velo {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(27 22 17 / 0.28);
    opacity: 0;
    transition: opacity 0.35s var(--ease-gaia);
  }

  .ig-velo svg {
    filter: drop-shadow(0 1px 6px rgb(27 22 17 / 0.4));
  }

  .ig-link:hover .ig-velo,
  .ig-link:focus-visible .ig-velo {
    opacity: 1;
  }

  .ig-link:hover :global(.ig-img) {
    transform: scale(1.03);
  }

  .ig-link:focus-visible {
    outline: 2px solid var(--color-bordeaux);
    outline-offset: 3px;
    z-index: 1;
  }

  @media (min-width: 64rem) {
    .ig-griglia {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .ig-voce:nth-child(n + 7) {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ig-link :global(.ig-img),
    .ig-velo,
    .ig-handle a {
      transition: none;
    }

    .ig-link:hover :global(.ig-img) {
      transform: none;
    }
  }
</style>
