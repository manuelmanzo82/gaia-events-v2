---
/**
 * Highlights, seconda parte: le foto restanti della sezione «home» in una
 * fascia che si aggancia e scorre in orizzontale con lo scroll verticale
 * (home-effetti.ts, [data-orizzontale], rif. sarahhaywood.com/weddings/).
 *
 * Desktop: tutte le foto alla STESSA altezza — min(65svh, ALTEZZA_FASCIA)
 * — larghe secondo il loro formato (verticali e orizzontali alternate),
 * gap costante, angoli 16 px, niente didascalie. Ogni tessera dichiara
 * data-theme="dark": sopra le foto il header è avorio.
 * Una foto che a quell'altezza supererebbe il proprio maxWidth viene
 * esclusa qui, in fase di build (ALTEZZA_FASCIA è anche il tetto in CSS,
 * quindi il controllo vale su qualunque schermo).
 *
 * Sotto i 64rem nessun pin: carosello a scorrimento libero con scroll-snap,
 * tessere tutte 4:5 larghe 78vw, così la successiva sporge dal bordo
 * destro. Giro 7: la prima volta che la sezione entra nello schermo una
 * sola spinta d'invito (60 px a sinistra e ritorno, 0,8 s, una volta per
 * visita via sessionStorage, mai con reduced-motion); sotto le foto una
 * barra sottile di avanzamento che si riempie scorrendo e l'etichetta
 * «Scorri →», che sparisce al primo scroll dell'utente.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import type { Highlight } from '../../lib/content';
import { ALTEZZA_FASCIA } from '../../lib/home';
import { picture } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  highlights: Highlight[];
}

const { lang, highlights } = Astro.props;
const t = useTranslations(lang);

const SIZES = '(min-width: 64rem) 48vw, 82vw';

const foto = highlights
  .map((h) => {
    const data = picture(h.image, lang, SIZES);
    if (!data || !h.image) return null;
    const rapporto = h.image.width / h.image.height;
    // Larghezza resa all'altezza di riferimento: oltre il limite, fuori.
    if (Math.ceil(ALTEZZA_FASCIA * rapporto) > data.maxWidth) return null;
    return { data, rapporto: `${h.image.width} / ${h.image.height}`, limite: data.maxWidth };
  })
  .filter((f): f is NonNullable<typeof f> => f !== null);
---

{
  foto.length > 0 && (
    <section class="orizzontale" data-theme="light" data-orizzontale style={`--altezza-fascia: ${ALTEZZA_FASCIA}px`}>
      <ul class="binario" role="list">
        {foto.map((f) => (
          <li class="tessera" style={`--rapporto: ${f.rapporto}; --limite: ${f.limite}px`} data-theme="dark" data-foto>
            <Picture data={f.data} cap={false} class="tessera-img" />
          </li>
        ))}
      </ul>

      {/* Solo sotto i 64rem: avanzamento e invito a scorrere. */}
      <div class="fascia-guida container-gaia" aria-hidden="true">
        <span class="fascia-barra"><span class="fascia-barra-pieno" /></span>
        <span class="fascia-scorri">
          {t('fascia.scorri')} <span>→</span>
        </span>
      </div>
    </section>
  )
}

<script>
  import { riduciMotion } from '../../scripts/motion';

  const MOBILE = window.matchMedia('(max-width: 63.98rem)');
  const CHIAVE = 'gaia-fascia-spinta';

  for (const sezione of document.querySelectorAll<HTMLElement>('[data-orizzontale]')) {
    const binario = sezione.querySelector<HTMLElement>('.binario');
    const pieno = sezione.querySelector<HTMLElement>('.fascia-barra-pieno');
    const etichetta = sezione.querySelector<HTMLElement>('.fascia-scorri');
    if (!binario || !pieno) continue;

    let spintaInCorso = false;

    // Barra di avanzamento; al primo scroll dell'utente via l'etichetta.
    const aggiorna = (): void => {
      const corsa = binario.scrollWidth - binario.clientWidth;
      pieno.style.transform = `scaleX(${corsa > 0 ? Math.min(binario.scrollLeft / corsa, 1) : 0})`;
      if (!spintaInCorso && binario.scrollLeft > 2 && etichetta) etichetta.classList.add('via');
    };
    binario.addEventListener('scroll', aggiorna, { passive: true });
    aggiorna();

    // Spinta d'invito: una volta per visita, solo su mobile, mai con
    // reduced-motion. 60 px a sinistra e ritorno in 0,8 s.
    const giaFatta = (): boolean => {
      try {
        return sessionStorage.getItem(CHIAVE) === '1';
      } catch {
        return false;
      }
    };
    const spingi = (): void => {
      spintaInCorso = true;
      try {
        sessionStorage.setItem(CHIAVE, '1');
      } catch {
        /* niente storage, pazienza */
      }
      // Lo scroll-snap riporterebbe subito il binario sul punto di
      // aggancio: spento per la durata della spinta.
      binario.style.scrollSnapType = 'none';
      const durata = 800;
      const inizio = performance.now();
      const passo = (ora: number): void => {
        const t = Math.min((ora - inizio) / durata, 1);
        // Andata e ritorno con una curva morbida (seno).
        binario.scrollLeft = Math.sin(t * Math.PI) * 60;
        if (t < 1) {
          requestAnimationFrame(passo);
        } else {
          binario.scrollLeft = 0;
          binario.style.scrollSnapType = '';
          spintaInCorso = false;
        }
      };
      requestAnimationFrame(passo);
    };

    if (MOBILE.matches && !riduciMotion() && !giaFatta() && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (voci) => {
          if (!voci.some((v) => v.isIntersecting)) return;
          io.disconnect();
          window.setTimeout(spingi, 350);
        },
        { threshold: 0.5 },
      );
      io.observe(binario);
    }
  }
</script>

<style>
  .orizzontale {
    background: color-mix(in srgb, var(--color-beige) 38%, var(--color-avorio));
    padding-block: var(--spacing-section-sm);
    overflow: hidden;
  }

  .binario {
    display: flex;
    gap: clamp(1rem, 2vw, 1.75rem);
    margin: 0;
    padding: 0 clamp(1.25rem, 4vw, 3.5rem);
    list-style: none;
  }

  .tessera {
    flex: 0 0 auto;
    overflow: hidden;
    border-radius: 16px;
    background: var(--color-beige);
  }

  .tessera :global(picture),
  .tessera :global(.tessera-img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tessera :global(.tessera-img) {
    object-fit: cover;
  }

  /* — Mobile: carosello libero con scroll-snap, niente JS — */
  @media (max-width: 63.98rem) {
    .binario {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: clamp(1.25rem, 4vw, 3.5rem);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .binario::-webkit-scrollbar {
      display: none;
    }

    .tessera {
      width: min(78vw, var(--limite));
      aspect-ratio: 4 / 5;
      scroll-snap-align: start;
    }

    /* Barra di avanzamento e «Scorri →» sotto le foto. */
    .fascia-guida {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: 1.25rem;
    }

    .fascia-barra {
      flex: 1 1 auto;
      height: 2px;
      overflow: hidden;
      border-radius: 1px;
      background: color-mix(in srgb, var(--color-inchiostro) 14%, transparent);
    }

    .fascia-barra-pieno {
      display: block;
      height: 100%;
      background: var(--color-bordeaux);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.15s linear;
    }

    .fascia-scorri {
      flex: none;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-grigio-caldo);
      transition: opacity 0.4s var(--ease-gaia);
    }

    .fascia-scorri.via {
      opacity: 0;
    }
  }

  .fascia-guida {
    display: none;
  }

  @media (max-width: 63.98rem) {
    .fascia-guida {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fascia-barra-pieno,
    .fascia-scorri {
      transition: none;
    }
  }

  /* — Desktop: fascia alta quanto lo schermo, il binario lo muove GSAP — */
  @media (min-width: 64rem) {
    .orizzontale {
      --altezza-foto: min(65svh, var(--altezza-fascia));
      padding-block: 0;
    }

    .binario {
      align-items: center;
      height: 100vh;
      height: 100svh;
      width: max-content;
      padding-inline: clamp(1.25rem, 4vw, 3.5rem) 12vw;
      will-change: transform;
    }

    /* Stessa altezza per tutte, larghezza dal formato. */
    .tessera {
      height: var(--altezza-foto);
      width: calc(var(--altezza-foto) * var(--rapporto));
    }
  }

  @media (prefers-reduced-motion: reduce) and (min-width: 64rem) {
    .binario {
      height: auto;
      width: auto;
      flex-wrap: wrap;
      padding-block: var(--spacing-section-sm);
    }
  }
</style>
