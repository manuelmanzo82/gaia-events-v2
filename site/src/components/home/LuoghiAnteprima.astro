---
/**
 * Luoghi: anteprima delle regioni pubblicate come mega-card (cover, nome,
 * zone), verso /luoghi/. Senza luoghi pubblicabili in questa lingua la
 * sezione non viene renderizzata: stessa regola di availability.ts.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import { LUOGO_FIELDS, existsIn } from '../../lib/availability';
import { getLuoghi, isPublishable, slugLuogo, text } from '../../lib/content';
import { picture } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  titolo?: string;
}

const { lang, titolo } = Astro.props;
const t = useTranslations(lang);

const regioni = existsIn('places', lang)
  ? getLuoghi()
      .filter((r) => isPublishable(r, lang, LUOGO_FIELDS))
      .map((regione) => ({
        regione,
        slug: slugLuogo(regione, lang),
        cover: picture(regione.cover, lang, '(min-width: 64rem) 46vw, 92vw'),
        zone: (regione.zone ?? []).filter((z) => isPublishable(z, lang, LUOGO_FIELDS)),
      }))
      .filter((r) => r.slug !== null)
  : [];
---

{
  regioni.length > 0 && (
    <section id="luoghi" class="luoghi" data-theme="light">
      <div class="container-gaia">
        <header class="luoghi-testa">
          <p class="eyebrow">{t('nav.places')}</p>
          {titolo && (
            <h2 class="text-display" data-reveal="righe">
              {titolo}
            </h2>
          )}
        </header>

        <ul class="luoghi-griglia" role="list">
          {regioni.map(({ regione, slug, cover, zone }) => (
            <li class="luogo" data-reveal="alto">
              <a class="luogo-link" href={path('places', lang, slug ?? undefined)}>
                {cover && (
                  <figure class="luogo-figura" data-reveal="maschera">
                    <Picture data={cover} cap={false} class="luogo-img" />
                  </figure>
                )}
                <span class="luogo-testo">
                  <span class="font-display text-title">{text(regione.nome, lang)}</span>
                  {zone.length > 0 && (
                    <span class="didascalia">
                      {zone.map((z) => text(z.nome, lang)).join(' · ')}
                    </span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>

        <p class="luoghi-coda">
          <a class="link-filo" href={path('places', lang)}>
            {t('cta.discover')}
          </a>
        </p>
      </div>
    </section>
  )
}

<style>
  .luoghi {
    padding-block: var(--spacing-section);
    background: var(--color-avorio);
  }

  .luoghi-testa h2 {
    margin: 0.9rem 0 2.5rem;
  }

  .luoghi-griglia {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 64rem) {
    .luoghi-griglia {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .luogo-link {
    display: grid;
    gap: 1rem;
    text-decoration: none;
  }

  .luogo-figura {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-beige);
  }

  .luogo-figura :global(.luogo-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-gaia);
  }

  .luogo-link:hover .luogo-figura :global(.luogo-img) {
    transform: scale(1.03);
  }

  .luogo-testo {
    display: grid;
    gap: 0.25rem;
  }

  .luoghi-coda {
    margin: 2.5rem 0 0;
  }
</style>
