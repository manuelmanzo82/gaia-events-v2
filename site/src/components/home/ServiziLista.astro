---
/**
 * Servizi: lista editoriale a tutta larghezza. Per ogni servizio una riga
 * con N° grande, sottotitolo come eyebrow, titolo in Cormorant e una o due
 * righe di testo, filetti sottili tra le righe. Ogni riga porta alla
 * pagina Servizi, all'ancora del servizio.
 *
 *  - desktop con mouse: al passaggio su una riga compare la foto del
 *    servizio (3:2) che segue morbidamente il cursore, con dissolvenza;
 *    con la tastiera la foto compare accanto alla riga che ha il focus;
 *  - prefers-reduced-motion: la foto compare ferma a lato della riga,
 *    senza inseguire il cursore;
 *  - mobile / senza hover: niente foto mobile, ogni servizio ha la sua
 *    foto orizzontale sopra il testo.
 *
 * Foto: solo quella del servizio (services.media_id). Niente ripiego sugli
 * highlights: erano le stesse foto di altre sezioni della home.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import { SERVICE_FIELDS, existsIn } from '../../lib/availability';
import { getServices, isPublishable, text } from '../../lib/content';
import { picture } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  titolo?: string;
  testo?: string;
}

const { lang, titolo, testo } = Astro.props;
const t = useTranslations(lang);

const paginaServizi = existsIn('services', lang);

const servizi = getServices()
  .filter((s) => isPublishable(s, lang, SERVICE_FIELDS))
  .map((servizio, i) => ({
    servizio,
    numero: String(i + 1).padStart(2, '0'),
    href: paginaServizi ? `${path('services', lang)}#${servizio.slug}` : null,
    fotoMobile: picture(servizio.image, lang, '92vw'),
    fotoCursore: picture(servizio.image, lang, '22rem'),
  }));
---

{
  servizi.length > 0 && (
    <section id="servizi" class="servizi" data-theme="light" data-servizi>
      <header class="servizi-testa container-gaia">
        {titolo && (
          <h2 class="text-display" data-reveal="righe">
            {titolo}
          </h2>
        )}
        {testo && <p class="text-lead text-velato">{testo}</p>}
      </header>

      <ol class="servizi-lista container-gaia">
        {servizi.map(({ servizio, numero, href, fotoMobile }, i) => {
          const Riga = href ? 'a' : 'div';
          return (
            <li class="servizio">
              <Riga class="servizio-riga" href={href ?? undefined} data-indice={i}>
                {fotoMobile && (
                  <span class="servizio-foto-mobile">
                    <Picture data={fotoMobile} cap={false} class="servizio-img" />
                  </span>
                )}
                <span class="servizio-numero" aria-hidden="true">
                  N° {numero}
                </span>
                <span class="servizio-corpo">
                  {text(servizio.subtitle, lang) && (
                    <span class="eyebrow servizio-eyebrow">{text(servizio.subtitle, lang)}</span>
                  )}
                  <span class="font-display servizio-titolo">{text(servizio.title, lang)}</span>
                  <span class="servizio-testo">{text(servizio.description, lang)}</span>
                </span>
                {href && (
                  <span class="servizio-freccia" aria-hidden="true">
                    →
                  </span>
                )}
              </Riga>
            </li>
          );
        })}
      </ol>

      <div class="servizi-cursore" aria-hidden="true">
        {servizi.map(({ fotoCursore }, i) =>
          fotoCursore ? (
            <figure class="servizi-cursore-foto" data-indice={i}>
              <Picture data={fotoCursore} cap={false} class="servizio-img" />
            </figure>
          ) : null,
        )}
      </div>

      {paginaServizi && (
        <p class="servizi-coda container-gaia">
          <a class="btn" href={path('services', lang)}>
            {t('cta.discover')}
          </a>
        </p>
      )}
    </section>
  )
}

<script>
  // Foto che segue il cursore: solo dove c'è un mouse vero e spazio.
  const sezione = document.querySelector<HTMLElement>('[data-servizi]');
  const cursore = sezione?.querySelector<HTMLElement>('.servizi-cursore');
  const conMouse = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 64rem)');
  const largo = window.matchMedia('(min-width: 64rem)');
  const riduci = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (sezione && cursore) {
    const foto = [...cursore.querySelectorAll<HTMLElement>('.servizi-cursore-foto')];
    const righe = [...sezione.querySelectorAll<HTMLElement>('.servizio-riga')];

    let x = 0;
    let y = 0;
    let tx = 0;
    let ty = 0;
    let anima = false;
    let segue = false; // true = insegue il mouse; false = ferma accanto alla riga

    const mostra = (indice: number | null): void => {
      // Il contenitore nasce in display: none (foto lazy mai scaricate su
      // mobile o finché non serve): si accende alla prima occasione.
      if (indice !== null) cursore.classList.add('pronto');
      for (const f of foto) f.classList.toggle('attiva', f.dataset.indice === String(indice));
      cursore.classList.toggle('visibile', indice !== null && foto.some((f) => f.dataset.indice === String(indice)));
    };

    const posiziona = (): void => {
      cursore.style.transform = `translate3d(${x}px, ${y}px, 0)`;
    };

    // Dentro la finestra: la foto non esce dai bordi.
    const limita = (px: number, py: number): [number, number] => {
      const w = cursore.offsetWidth;
      const h = cursore.offsetHeight;
      return [
        Math.min(Math.max(px, 16), window.innerWidth - w - 16),
        Math.min(Math.max(py, 16), window.innerHeight - h - 16),
      ];
    };

    const passo = (): void => {
      // Inseguimento morbido (lerp): la foto arriva, non salta.
      x += (tx - x) * 0.14;
      y += (ty - y) * 0.14;
      posiziona();
      if (Math.abs(tx - x) > 0.3 || Math.abs(ty - y) > 0.3) {
        requestAnimationFrame(passo);
      } else {
        anima = false;
      }
    };

    const verso = (px: number, py: number, subito: boolean): void => {
      [tx, ty] = limita(px, py);
      if (subito || riduci) {
        x = tx;
        y = ty;
        posiziona();
        return;
      }
      if (!anima) {
        anima = true;
        requestAnimationFrame(passo);
      }
    };

    // Ferma, a destra della riga e centrata su di lei (tastiera e
    // movimento ridotto).
    const accanto = (riga: HTMLElement): void => {
      const r = riga.getBoundingClientRect();
      verso(r.right - cursore.offsetWidth - 24, r.top + r.height / 2 - cursore.offsetHeight / 2, true);
    };

    righe.forEach((riga, i) => {
      riga.addEventListener('mouseenter', (e) => {
        if (!conMouse.matches) return;
        segue = !riduci;
        const appena = !cursore.classList.contains('visibile');
        mostra(i);
        if (segue) verso(e.clientX + 32, e.clientY - cursore.offsetHeight / 2, appena);
        else accanto(riga);
      });
      riga.addEventListener('mousemove', (e) => {
        if (!segue || !conMouse.matches) return;
        verso(e.clientX + 32, e.clientY - cursore.offsetHeight / 2, false);
      });
      riga.addEventListener('focus', () => {
        if (!largo.matches) return;
        segue = false;
        mostra(i);
        accanto(riga);
      });
      riga.addEventListener('blur', () => mostra(null));
    });

    sezione.querySelector('.servizi-lista')?.addEventListener('mouseleave', () => mostra(null));
    // Con la foto ferma (tastiera, movimento ridotto) lo scroll — anche
    // quello che il focus stesso provoca — la riaccompagna alla riga attiva;
    // senza una riga attiva la foto sparisce invece di restare sospesa.
    window.addEventListener(
      'scroll',
      () => {
        if (segue || !cursore.classList.contains('visibile')) return;
        const attiva = document.activeElement?.closest<HTMLElement>('.servizio-riga');
        const sotto = righe.find((r) => r.matches(':hover'));
        const riga = attiva && righe.includes(attiva) ? attiva : sotto;
        if (riga) accanto(riga);
        else mostra(null);
      },
      { passive: true },
    );
  }
</script>

<style>
  .servizi {
    position: relative;
    padding-block: var(--spacing-section);
    background: var(--color-avorio);
  }

  .servizi-testa {
    margin-bottom: clamp(2rem, 5vh, 3.5rem);
  }

  .servizi-testa h2 {
    margin: 0 0 1rem;
  }

  .servizi-testa p {
    margin: 0;
    max-width: 38rem;
  }

  /* — Lista — */
  .servizi-lista {
    margin: 0 auto;
    list-style: none;
  }

  .servizio {
    border-top: 1px solid var(--color-beige);
  }

  .servizio:last-child {
    border-bottom: 1px solid var(--color-beige);
  }

  .servizio-riga {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.6rem 1.25rem;
    align-items: baseline;
    padding: clamp(1.5rem, 3.5vh, 2.25rem) 0;
    color: inherit;
    text-decoration: none;
  }

  .servizio-foto-mobile {
    grid-column: 1 / -1;
    display: block;
    aspect-ratio: 3 / 2;
    margin-bottom: 0.75rem;
    overflow: hidden;
    border-radius: 3px;
    background: var(--color-beige);
  }

  .servizio-foto-mobile :global(picture),
  .servizio-foto-mobile :global(.servizio-img),
  .servizi-cursore-foto :global(picture),
  .servizi-cursore-foto :global(.servizio-img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .servizio-foto-mobile :global(.servizio-img),
  .servizi-cursore-foto :global(.servizio-img) {
    object-fit: cover;
  }

  .servizio-numero {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 340;
    font-size: clamp(1.75rem, 1.2rem + 2vw, 3.25rem);
    line-height: 1;
    color: var(--color-oro-testo);
  }

  .servizio-corpo {
    display: grid;
    gap: 0.5rem;
  }

  .servizio-eyebrow {
    display: flex;
  }

  .servizio-titolo {
    font-size: var(--text-display);
    font-weight: 330;
    line-height: 1.05;
    letter-spacing: -0.01em;
    transition: color 0.4s var(--ease-gaia);
  }

  /* Una o due righe: il testo completo sta nella pagina Servizi. */
  .servizio-testo {
    display: -webkit-box;
    max-width: 44rem;
    overflow: hidden;
    color: var(--color-grigio-caldo);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .servizio-freccia {
    display: none;
  }

  a.servizio-riga:hover .servizio-titolo,
  a.servizio-riga:focus-visible .servizio-titolo {
    color: var(--color-bordeaux);
  }

  a.servizio-riga:focus-visible {
    outline: 2px solid var(--color-bordeaux);
    outline-offset: 4px;
  }

  .servizi-coda {
    margin: clamp(2rem, 5vh, 3rem) auto 0;
  }

  /* — Foto che segue il cursore (solo desktop) — */
  /* display: none finché non serve: fissa in alto a sinistra conterebbe
     come «nella finestra» e le sue foto lazy si scaricherebbero subito,
     anche su mobile dove non si vedono mai. */
  .servizi-cursore {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20;
    width: clamp(16rem, 22vw, 22rem);
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 4px;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.35s var(--ease-gaia),
      visibility 0s linear 0.35s;
    will-change: transform;
  }

  .servizi-cursore.pronto {
    display: block;
  }

  .servizi-cursore.visibile {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .servizi-cursore-foto {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 0.45s var(--ease-gaia);
  }

  .servizi-cursore-foto.attiva {
    opacity: 1;
  }

  @media (min-width: 64rem) {
    .servizio-riga {
      grid-template-columns: 7rem minmax(0, 1fr) auto;
      gap: 0 2rem;
      align-items: center;
      padding: clamp(1.75rem, 4vh, 2.5rem) 0;
    }

    .servizio-foto-mobile {
      display: none;
    }

    .servizio-numero {
      align-self: start;
      padding-top: 0.35rem;
    }

    .servizio-freccia {
      display: block;
      font-size: 1.5rem;
      color: var(--color-grigio-caldo);
      transform: translateX(-0.5rem);
      opacity: 0;
      transition:
        opacity 0.4s var(--ease-gaia),
        transform 0.4s var(--ease-gaia);
    }

    a.servizio-riga:hover .servizio-freccia,
    a.servizio-riga:focus-visible .servizio-freccia {
      opacity: 1;
      transform: none;
    }
  }

  /* Senza mouse (touch, anche su schermi larghi): foto nella riga. */
  @media (min-width: 64rem) and (hover: none) {
    .servizio-foto-mobile {
      display: block;
      grid-column: 2 / 3;
      max-width: 28rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .servizi-cursore,
    .servizi-cursore-foto,
    .servizio-titolo,
    .servizio-freccia {
      transition: none;
    }
  }
</style>
