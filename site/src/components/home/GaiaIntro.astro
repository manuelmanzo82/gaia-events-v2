---
/**
 * Gaia, subito dopo l'hero: una sezione sola al posto di manifesto e
 * «Chi è Gaia». Foto grande (il primo highlight della sezione «chi-sono»),
 * eyebrow, titolo, la frase-manifesto come citazione grande, due o tre
 * righe di presentazione e il link alla pagina.
 *
 * Testi: settings.sections.about (titolo, testo breve) e
 * settings.home.manifesto. Niente da ripetere: la presentazione è il
 * testo accorciato del back office, la citazione è il manifesto.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import { existsIn } from '../../lib/availability';
import { getHighlights, text, type Settings } from '../../lib/content';
import { picture } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  settings: Settings;
}

const { lang, settings } = Astro.props;
const t = useTranslations(lang);

const sezione = settings.sections.about;
const titolo = text(sezione?.title, lang);
const presentazione = text(sezione?.text, lang);
const manifesto = text(settings.home.manifesto, lang);

const foto = picture(
  getHighlights('chi-sono')[0]?.image ?? settings.about.image,
  lang,
  '(min-width: 64rem) 36vw, 92vw',
);
const paginaChiSono = existsIn('about', lang);
---

{
  (titolo || manifesto) && (
    <section id="gaia" class="gaia" data-theme="light">
      <div class="gaia-griglia">
        {
          foto && (
            <figure class="gaia-figura" data-reveal="maschera">
              <Picture data={foto} cap={false} class="gaia-img" />
              {/* Il taglio (object-position nel CSS) è centrato su Gaia ed
                  esclude l'angolo in basso a destra, dove la foto porta il
                  watermark del fotografo. */}
            </figure>
          )
        }

        <div class="gaia-testo">
          <p class="eyebrow" data-reveal="alto">
            {t('nav.about')}
          </p>
          {titolo && (
            <h2 class="text-display gaia-titolo" data-reveal="righe">
              {titolo}
            </h2>
          )}
          {manifesto && (
            <blockquote class="font-display gaia-citazione" data-reveal="righe">
              «{manifesto}»
            </blockquote>
          )}
          {presentazione && (
            <p class="text-lead gaia-presentazione" data-reveal="alto">
              {presentazione}
            </p>
          )}
          {paginaChiSono && (
            <p class="gaia-coda" data-reveal="alto">
              <a class="link-filo" href={path('about', lang)}>
                {t('cta.discover')}
              </a>
            </p>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .gaia {
    padding-block: var(--spacing-section);
    background: var(--color-avorio);
  }

  .gaia-griglia {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    width: min(100% - 2 * clamp(1.25rem, 4vw, 3.5rem), 80rem);
    margin-inline: auto;
  }

  /* Mobile: foto sopra il testo, in 4:5. La foto (2:3) si taglia in
     verticale: y 30% la tiene intera su di lei, piedi compresi, e lascia
     fuori il watermark del fotografo in basso a destra. */
  .gaia-figura {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 3px;
    background: var(--color-beige);
  }

  /* La foto riempie la figura in assoluto: così non dà altezza propria
     alla riga della griglia, e su desktop la figura è alta esattamente
     quanto la colonna di testo. */
  .gaia-figura :global(picture),
  .gaia-figura :global(.gaia-img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .gaia-figura :global(.gaia-img) {
    object-fit: cover;
    object-position: 50% 30% !important;
  }

  .gaia-testo {
    padding: 0;
  }

  /* La colonna comincia con l'eyebrow e il bordo superiore della foto
     deve stare su «Chi sono». L'eyebrow globale è inline-flex: in linea
     eredita l'interlinea del corpo (28 px) e scendeva di 9 px. Qui è un
     blocco, senza margine sopra. */
  .gaia-testo > .eyebrow {
    display: flex;
    margin-top: 0;
  }

  .gaia-titolo {
    margin: 0.9rem 0 1.75rem;
  }

  .gaia-citazione {
    margin: 0 0 1.75rem;
    padding: 0;
    border: 0;
    max-width: 24ch;
    font-size: var(--text-title);
    font-style: italic;
    font-weight: 340;
    line-height: 1.25;
    text-wrap: balance;
    color: var(--color-inchiostro);
  }

  .gaia-presentazione {
    margin: 0;
    max-width: 30rem;
    color: var(--color-grigio-caldo);
  }

  .gaia-coda {
    margin: 2rem 0 0;
  }

  @media (min-width: 64rem) {
    /* Foto al 40% della larghezza, alta esattamente quanto la colonna di
       testo (dall'eyebrow a «Scopri di più»): la riga la decide il testo,
       la figura si stira (stretch) e la foto la riempie in cover. */
    .gaia-griglia {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: stretch;
    }

    .gaia-figura {
      aspect-ratio: auto;
      height: 100%;
    }

    /* Qui la colonna è più stretta della foto: si taglia ai lati. x 48%
       la tiene al centro (il viso è al 48% della foto) e fa uscire il
       watermark sul bordo destro. */
    .gaia-figura :global(.gaia-img) {
      object-position: 48% 30% !important;
    }

    .gaia-testo {
      max-width: 44rem;
    }

    .gaia-citazione {
      font-size: var(--text-display);
      line-height: 1.12;
    }
  }
</style>
