---
/**
 * Gaia, subito dopo l'hero: una sezione sola al posto di manifesto e
 * «Chi è Gaia». Foto grande (il primo highlight della sezione «chi-sono»),
 * eyebrow, titolo, la frase-manifesto come citazione grande, due o tre
 * righe di presentazione e il link alla pagina.
 *
 * Testi: settings.sections.about (titolo, testo breve) e
 * settings.home.manifesto. Niente da ripetere: la presentazione è il
 * testo accorciato del back office, la citazione è il manifesto.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import { existsIn } from '../../lib/availability';
import { getHighlights, text, type Settings } from '../../lib/content';
import { picture } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  settings: Settings;
}

const { lang, settings } = Astro.props;
const t = useTranslations(lang);

const sezione = settings.sections.about;
const titolo = text(sezione?.title, lang);
const presentazione = text(sezione?.text, lang);
const manifesto = text(settings.home.manifesto, lang);

const foto = picture(
  getHighlights('chi-sono')[0]?.image ?? settings.about.image,
  lang,
  '(min-width: 64rem) 36vw, 92vw',
);
const paginaChiSono = existsIn('about', lang);
---

{
  (titolo || manifesto) && (
    <section id="gaia" class="gaia" data-theme="light">
      <div class="gaia-griglia">
        {
          foto && (
            <figure class="gaia-figura" data-reveal="maschera" data-theme="dark" data-foto>
              <Picture data={foto} cap={false} class="gaia-img" />
              {/* Il taglio (object-position nel CSS) è centrato su Gaia ed
                  esclude l'angolo in basso a destra, dove la foto porta il
                  watermark del fotografo. */}
            </figure>
          )
        }

        <div class="gaia-testo">
          <p class="eyebrow" data-reveal="alto">
            {t('nav.about')}
          </p>
          {titolo && (
            <h2 class="text-display gaia-titolo" data-reveal="righe">
              {titolo}
            </h2>
          )}
          {manifesto && (
            <blockquote class="font-display gaia-citazione" data-reveal="righe">
              «{manifesto}»
            </blockquote>
          )}
          {presentazione && (
            <p class="text-lead gaia-presentazione" data-reveal="alto">
              {presentazione}
            </p>
          )}
          {paginaChiSono && (
            <p class="gaia-coda" data-reveal="alto">
              <a class="link-filo" href={path('about', lang)}>
                {t('cta.discover')}
              </a>
            </p>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .gaia {
    padding-block: var(--spacing-section);
    background: var(--color-avorio);
  }

  .gaia-griglia {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    width: min(100% - 2 * clamp(1.25rem, 4vw, 3.5rem), 80rem);
    margin-inline: auto;
  }

  /* Foto a formato fisso 4:5 (sopra il testo su mobile, accanto su
     desktop). La foto (2:3) si taglia in verticale: y 30% la tiene intera
     e al centro, piedi compresi, e lascia fuori il watermark del
     fotografo in basso a destra. */
  .gaia-figura {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 3px;
    background: var(--color-beige);
  }

  /* La foto riempie la figura 4:5 in cover. */
  .gaia-figura :global(picture),
  .gaia-figura :global(.gaia-img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .gaia-figura :global(.gaia-img) {
    object-fit: cover;
    object-position: 50% 30% !important;
  }

  /* Il header passa sopra la foto in inchiostro (la sezione è chiara):
     fascia alta chiara, leggerissima, per la leggibilità. */
  .gaia-figura::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 1;
    height: 240px;
    background: linear-gradient(180deg, rgb(250 248 245 / 0.6) 0%, rgb(250 248 245 / 0.35) 120px, rgb(250 248 245 / 0) 100%);
    pointer-events: none;
  }

  .gaia-testo {
    padding: 0;
  }

  /* L'eyebrow globale è inline-flex: in linea eredita l'interlinea del
     corpo (28 px) e scende di 9 px. Qui è un blocco, senza margine sopra. */
  .gaia-testo > .eyebrow {
    display: flex;
    margin-top: 0;
  }

  .gaia-titolo {
    margin: 0.9rem 0 1.75rem;
  }

  .gaia-citazione {
    margin: 0 0 1.75rem;
    padding: 0;
    border: 0;
    max-width: 24ch;
    font-size: var(--text-title);
    font-style: italic;
    font-weight: 340;
    line-height: 1.25;
    text-wrap: balance;
    color: var(--color-inchiostro);
  }

  .gaia-presentazione {
    margin: 0;
    max-width: 30rem;
    color: var(--color-grigio-caldo);
  }

  .gaia-coda {
    margin: 2rem 0 0;
  }

  @media (min-width: 64rem) {
    /* Foto 4:5 al ~48% della larghezza, testo centrato in verticale
       accanto. Niente stretch: la foto ha il suo formato, non segue
       l'altezza del testo. */
    .gaia-griglia {
      grid-template-columns: minmax(0, 13fr) minmax(0, 12fr);
      align-items: center;
    }

    .gaia-testo {
      max-width: 36rem;
    }

    .gaia-citazione {
      font-size: var(--text-display);
      line-height: 1.12;
    }
  }
</style>
