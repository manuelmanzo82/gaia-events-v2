---
/**
 * Servizi: le formule in lista numerata editoriale. Su desktop il testo
 * scorre a sinistra e a destra una foto ferma cambia quando il blocco
 * corrispondente entra (home-effetti.ts, [data-split]); sotto i 64rem
 * lista semplice con la foto di ogni formula sopra il testo.
 *
 * Foto: quella del servizio se c'è (services.media_id), altrimenti gli
 * highlights della sezione "servizi" nell'ordine deciso nel back office.
 * Senza servizi pubblicabili in questa lingua la sezione non esiste.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import { SERVICE_FIELDS, existsIn } from '../../lib/availability';
import { getHighlights, getServices, isPublishable, text } from '../../lib/content';
import { picture } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  titolo?: string;
  testo?: string;
}

const { lang, titolo, testo } = Astro.props;
const t = useTranslations(lang);

const ripiego = getHighlights('servizi').map((h) => h.image);

const servizi = getServices()
  .filter((s) => isPublishable(s, lang, SERVICE_FIELDS))
  .map((servizio, i) => ({
    servizio,
    numero: String(i + 1).padStart(2, '0'),
    foto: picture(servizio.image ?? ripiego[i % Math.max(ripiego.length, 1)] ?? null, lang, '(min-width: 64rem) 44vw, 92vw'),
  }));

const paginaServizi = existsIn('services', lang);
---

{
  servizi.length > 0 && (
    <section id="servizi" class="servizi" data-theme="light" data-split>
      <div class="container-gaia servizi-griglia">
        <div class="servizi-colonna">
          <header class="servizi-testa">
            {titolo && (
              <h2 class="text-display" data-reveal="righe">
                {titolo}
              </h2>
            )}
            {testo && <p class="text-lead text-velato">{testo}</p>}
          </header>

          <ol class="servizi-lista">
            {servizi.map(({ servizio, numero, foto }) => (
              <li class="split-blocco">
                {foto && (
                  <figure class="servizio-foto-mobile">
                    <Picture data={foto} class="servizio-img" />
                  </figure>
                )}
                <span class="numero">N° {numero}</span>
                <h3 class="font-display text-title servizio-titolo">{text(servizio.title, lang)}</h3>
                {text(servizio.subtitle, lang) && (
                  <p class="eyebrow servizio-sottotitolo">{text(servizio.subtitle, lang)}</p>
                )}
                <p class="servizio-testo">{text(servizio.description, lang)}</p>
              </li>
            ))}
          </ol>

          {paginaServizi && (
            <p class="servizi-coda">
              <a class="btn" href={path('services', lang)}>
                {t('cta.discover')}
              </a>
            </p>
          )}
        </div>

        <div class="split-foto" aria-hidden="true">
          <div class="split-foto-cornice">
            {servizi.map(({ foto }, i) =>
              foto ? (
                <figure class:list={['split-foto-strato', { attiva: i === 0 }]} data-foto={i}>
                  <Picture data={foto} cap={false} class="split-img" />
                </figure>
              ) : null,
            )}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .servizi {
    padding-block: var(--spacing-section);
    background: var(--color-avorio);
  }

  .servizi-griglia {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .servizi-testa h2 {
    margin: 0 0 1rem;
  }

  .servizi-testa p {
    margin: 0 0 2.5rem;
    max-width: 34rem;
  }

  .servizi-lista {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .split-blocco {
    display: grid;
    gap: 0.6rem;
    padding: 2.25rem 0;
    border-top: 1px solid var(--color-beige);
  }

  .servizio-titolo {
    margin: 0;
  }

  .servizio-sottotitolo {
    margin: 0;
  }

  .servizio-testo {
    margin: 0.5rem 0 0;
    max-width: 34rem;
  }

  .servizio-foto-mobile {
    margin: 0 0 1rem;
    border-radius: 2px;
    overflow: hidden;
  }

  .servizio-foto-mobile :global(.servizio-img) {
    width: 100%;
    height: auto;
  }

  .servizi-coda {
    margin: 2rem 0 0;
  }

  .split-foto {
    display: none;
  }

  @media (min-width: 64rem) {
    .servizi-griglia {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }

    .servizio-foto-mobile {
      display: none;
    }

    .split-blocco {
      min-height: 50vh;
      padding: 3rem 0;
      align-content: center;
    }

    /* Colonna destra: la cornice resta ferma mentre i blocchi scorrono;
       le foto sono strati sovrapposti, quella attiva in dissolvenza. */
    /* Sticky al bordo superiore (il header scorrendo è nascosto). */
    .split-foto {
      display: block;
      position: sticky;
      top: 0;
      padding-block: 2rem;
    }

    .split-foto-cornice {
      position: relative;
      height: calc(100vh - 4rem);
      height: calc(100svh - 4rem);
      border-radius: 2px;
      overflow: hidden;
      background: var(--color-beige);
    }

    .split-foto-strato {
      position: absolute;
      inset: 0;
      margin: 0;
      opacity: 0;
      transition: opacity 1.1s var(--ease-gaia);
    }

    .split-foto-strato.attiva {
      opacity: 1;
    }

    .split-foto-strato :global(picture),
    .split-foto-strato :global(.split-img) {
      display: block;
      width: 100%;
      height: 100%;
    }

    .split-foto-strato :global(.split-img) {
      object-fit: cover;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .split-foto-strato {
      transition: none;
    }
  }
</style>
