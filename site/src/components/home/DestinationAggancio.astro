---
/**
 * Destination wedding: fascia a tutta larghezza, cinematografica, con un
 * paesaggio forte (il primo highlight della sezione «destination») sotto
 * un velo scuro leggero, e titolo + intro della pagina sopra. Senza foto
 * resta il fondo notte. Solo se la pagina esiste in questa lingua.
 *
 * La foto è una fascia con object-fit: cover: il cap del <Picture> è
 * spento perché la larghezza visibile non corrisponde ai pixel richiesti
 * (come per l'hero). Sotto i 64rem (giro 5) la sezione è 4:5 a tutta
 * larghezza con il testo in basso e una leggera parallasse della foto
 * (home-effetti.ts, [data-parallasse]: la figura sborda del 6% sopra e
 * sotto per avere margine di movimento).
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import { existsIn } from '../../lib/availability';
import { getDestinationWedding, getHighlights, text } from '../../lib/content';
import { picture } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const dw = getDestinationWedding();
const titolo = text(dw.title, lang);
const intro = text(dw.intro, lang);
const esiste = existsIn('destinationWedding', lang) && titolo !== '';

const foto = picture(getHighlights('destination')[0]?.image ?? dw.hero, lang, '100vw');
---

{
  esiste && (
    <section id="destination" class="destination" data-theme="dark" data-foto>
      {
        foto && (
          <figure class="destination-figura" aria-hidden="true" data-parallasse="-5 5">
            <Picture data={foto} cap={false} class="destination-img" />
          </figure>
        )
      }
      <div class="destination-velo" aria-hidden="true"></div>

      <div class="container-gaia destination-interno">
        <p class="eyebrow" data-reveal="alto">
          {t('nav.destinationWedding')}
        </p>
        <h2 class="text-display-xl destination-titolo" data-reveal="righe">
          {titolo}
        </h2>
        {intro && (
          <p class="text-lead destination-intro" data-reveal="alto">
            {intro}
          </p>
        )}
        <p class="destination-coda" data-reveal="alto">
          <a class="btn" href={path('destinationWedding', lang)}>
            {t('cta.discover')}
          </a>
        </p>
      </div>
    </section>
  )
}

<style>
  .destination {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 70vh;
    min-height: 70svh;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-notte);
    color: var(--color-avorio-su-notte);
  }

  .destination-figura {
    position: absolute;
    inset: 0;
    z-index: 0;
    margin: 0;
  }

  .destination-figura :global(picture),
  .destination-figura :global(.destination-img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .destination-figura :global(.destination-img) {
    position: absolute;
    inset: 0;
    max-width: none;
    object-fit: cover;
  }

  .destination-velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.5) 0%, rgb(0 0 0 / 0.3) 110px, rgb(0 0 0 / 0) 220px),
      linear-gradient(90deg, rgb(27 22 17 / 0.62) 0%, rgb(27 22 17 / 0.35) 55%, rgb(27 22 17 / 0.2) 100%),
      linear-gradient(0deg, rgb(27 22 17 / 0.45) 0%, transparent 40%);
  }

  .destination-interno {
    position: relative;
    z-index: 2;
    padding-block: clamp(5rem, 14vh, 9rem);
  }

  .destination-titolo {
    max-width: 14ch;
    margin: 0.9rem 0 1.5rem;
    color: var(--color-avorio-su-notte);
  }

  .destination-intro {
    margin: 0;
    max-width: 34rem;
    color: var(--color-avorio-su-notte);
    opacity: 0.88;
  }

  .destination-coda {
    margin: 2.5rem 0 0;
  }

  @media (max-width: 63.98rem) {
    .destination {
      min-height: 0;
      aspect-ratio: 4 / 5;
      align-content: end;
    }

    .destination-figura {
      inset: -6% 0;
      will-change: transform;
    }

    .destination-interno {
      padding-block: 3rem 2.5rem;
    }

    .destination-titolo {
      font-size: var(--text-display);
      line-height: var(--text-display--line-height);
      margin-bottom: 1rem;
    }

    .destination-coda {
      margin-top: 1.75rem;
    }
  }

  @media (min-width: 64rem) {
    .destination {
      min-height: 88vh;
      min-height: 88svh;
    }
  }
</style>
