---
/**
 * Chi è Gaia: ritratto (il primo highlight della sezione "chi-sono") con
 * titolo e testo breve delle impostazioni, link alla pagina Chi sono.
 * Il ritratto resta al suo maxWidth (è una foto da ~500 px CSS: in una
 * colonna sta benissimo, stirata no).
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import { existsIn } from '../../lib/availability';
import { getHighlights, text, type Settings } from '../../lib/content';
import { picture } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  settings: Settings;
}

const { lang, settings } = Astro.props;
const t = useTranslations(lang);

const sezione = settings.sections.about;
const titolo = text(sezione?.title, lang);
const testo = text(sezione?.text, lang);

const ritratto = picture(
  getHighlights('chi-sono')[0]?.image ?? settings.about.image,
  lang,
  '(min-width: 64rem) 40vw, 92vw',
);
const paginaChiSono = existsIn('about', lang);
---

{
  (titolo || testo) && (
    <section id="chi-sono" class="gaia" data-theme="light">
      <div class="container-gaia gaia-griglia">
        {ritratto && (
          <figure class="gaia-ritratto" data-reveal="maschera">
            <Picture data={ritratto} class="gaia-img" />
          </figure>
        )}

        <div class="gaia-testo">
          <p class="eyebrow">{t('nav.about')}</p>
          {titolo && (
            <h2 class="text-display" data-reveal="righe">
              {titolo}
            </h2>
          )}
          {testo && (
            <p class="text-lead gaia-paragrafo" data-reveal="alto">
              {testo}
            </p>
          )}
          {paginaChiSono && (
            <p class="gaia-coda" data-reveal="alto">
              <a class="link-filo" href={path('about', lang)}>
                {t('cta.discover')}
              </a>
            </p>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .gaia {
    padding-block: var(--spacing-section);
    background: color-mix(in srgb, var(--color-beige) 38%, var(--color-avorio));
  }

  .gaia-griglia {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .gaia-ritratto {
    margin: 0;
    border-radius: 2px;
    overflow: hidden;
  }

  .gaia-ritratto :global(.gaia-img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .gaia-testo h2 {
    margin: 0.9rem 0 1.5rem;
  }

  .gaia-paragrafo {
    margin: 0;
    max-width: 32rem;
    color: var(--color-inchiostro);
  }

  .gaia-coda {
    margin: 2rem 0 0;
  }

  @media (min-width: 64rem) {
    .gaia-griglia {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .gaia-ritratto {
      justify-self: start;
    }
  }
</style>
