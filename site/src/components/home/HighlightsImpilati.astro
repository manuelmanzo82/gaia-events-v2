---
/**
 * Highlights, prima parte: schede che si impilano con lo scroll
 * (home-effetti.ts, [data-impila]). La foto riempie la scheda
 * (object-fit: cover), niente cornice né bande.
 *
 * Per non violare il limite di ogni foto (maxWidth, calcolato dal back
 * office) qui entrano solo orizzontali con maxWidth ≥ larghezza della
 * scheda (LIMITE_SCHEDA, 62rem): la selezione la fa HomePage con la
 * stessa costante; verticali e foto più piccole vanno nella fascia
 * orizzontale. Su desktop ogni scheda è sticky al bordo superiore della
 * finestra (il header lì è nascosto); sotto i 64rem colonna semplice.
 */
import type { Lang } from '../../config/site';
import type { Highlight } from '../../lib/content';
import { picture } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  highlights: Highlight[];
  eyebrow?: string;
  titolo?: string;
}

const { lang, highlights, eyebrow, titolo } = Astro.props;

const SIZES = '(min-width: 68rem) 62rem, 92vw';

const schede = highlights
  .map((h, i) => {
    const data = picture(h.image, lang, SIZES);
    if (!data) return null;
    return { data, numero: String(i + 1).padStart(2, '0') };
  })
  .filter((s): s is NonNullable<typeof s> => s !== null);
---

{
  schede.length > 0 && (
    <section id="highlights" class="impila" data-theme="light">
      <header class="impila-testa container-gaia">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {titolo && (
          <h2 class="text-display" data-reveal="righe">
            {titolo}
          </h2>
        )}
      </header>

      <div class="impila-pila" data-impila>
        {schede.map((s) => (
          <article class="scheda">
            <figure class="scheda-figura" data-reveal="maschera">
              <Picture data={s.data} cap={false} class="scheda-img" />
            </figure>
            <div class="scheda-testo">
              <span class="numero">N° {s.numero}</span>
              <p class="scheda-didascalia">{s.data.alt}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .impila {
    padding-block: var(--spacing-section) 0;
    background: var(--color-avorio);
  }

  .impila-testa {
    margin-bottom: clamp(2rem, 5vh, 3.5rem);
  }

  .impila-testa h2 {
    margin: 0.9rem 0 0;
  }

  .impila-pila {
    display: grid;
    gap: clamp(1.5rem, 4vh, 3rem);
    padding-bottom: var(--spacing-section);
  }

  .scheda {
    width: min(100% - 2 * clamp(1.25rem, 4vw, 3.5rem), 62rem);
    margin-inline: auto;
    display: grid;
    gap: 0.9rem;
    will-change: transform, opacity;
  }

  .scheda-figura {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 3px;
    background: var(--color-beige);
  }

  .scheda-figura :global(picture),
  .scheda-figura :global(.scheda-img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .scheda-figura :global(.scheda-img) {
    object-fit: cover;
  }

  .scheda-testo {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .scheda-testo .numero {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .scheda-didascalia {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lead);
    line-height: 1.35;
    color: var(--color-grigio-caldo);
    text-wrap: pretty;
  }

  @media (min-width: 64rem) {
    .impila-pila {
      gap: 0;
    }

    /* Sticky al bordo superiore: la scheda è alta quanto la finestra, la
       foto riempie tutto meno la riga della didascalia. */
    .scheda {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100svh;
      grid-template-rows: minmax(0, 1fr) auto;
      padding-block: 2rem 1.25rem;
      transform-origin: 50% 0%;
      background: var(--color-avorio);
    }

    .scheda-figura {
      aspect-ratio: auto;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scheda {
      position: static;
      height: auto;
    }

    .scheda-figura {
      aspect-ratio: 4 / 3;
    }
  }
</style>
