---
/**
 * Manifesto: una frase grande in Cormorant sotto l'hero, con la firma di
 * Gaia in corsivo. Testo da settings.home.manifesto / manifestoFirma.
 * Senza frase in questa lingua la sezione non viene renderizzata.
 *
 * Il reveal riga per riga è di motion.ts (data-reveal="righe"): parte una
 * volta sola, all'85% della viewport, mai sul primo paint.
 */
import type { Lang } from '../../config/site';
import { text, type Settings } from '../../lib/content';

interface Props {
  lang: Lang;
  settings: Settings;
}

const { lang, settings } = Astro.props;

const frase = text(settings.home.manifesto, lang);
const firma = text(settings.home.manifestoFirma, lang);

// Una frase breve sta in display-xl; oltre i 90 caratteri il corpo scende
// di un gradino, altrimenti su mobile diventa una colonna di dieci righe.
const breve = frase.length <= 90;
---

{
  frase && (
    <section id="manifesto" class="manifesto" data-theme="light">
      <div class="container-gaia">
        <hr class="filetto manifesto-filetto" data-reveal="alto" />
        <p
          class:list={['font-display manifesto-frase', breve ? 'text-display-xl' : 'text-display manifesto-frase--lunga']}
          data-reveal="righe"
        >
          {frase}
        </p>
        {
          firma && (
            <p class="manifesto-firma" data-reveal="alto">
              <span aria-hidden="true">— </span>
              {firma}
            </p>
          )
        }
      </div>
    </section>
  )
}

<style>
  .manifesto {
    padding-block: var(--spacing-section);
    background: var(--color-avorio);
  }

  .manifesto-filetto {
    margin: 0 0 2.5rem;
  }

  .manifesto-frase {
    max-width: 22ch;
    margin: 0;
    font-weight: 320;
    line-height: 1.06;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--color-inchiostro);
  }

  .manifesto-frase--lunga {
    max-width: 30ch;
    line-height: 1.12;
  }

  .manifesto-firma {
    margin: 2.25rem 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-title);
    color: var(--color-grigio-caldo);
  }
</style>
