---
import type { PictureData } from '../lib/images';

interface Props {
  data: PictureData | null;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
  /**
   * Applica il limite di larghezza dell'immagine.
   *
   * Acceso di default: nessuna foto viene mai mostrata più larga di quanto
   * la sua risoluzione consenta, lightbox compresa. Si spegne solo quando il
   * contenitore ritaglia davvero l'immagine — per esempio una fascia a tutta
   * larghezza con `object-fit: cover` — perché lì la larghezza visibile non
   * corrisponde ai pixel richiesti all'immagine.
   */
  cap?: boolean;
}

const {
  data,
  class: className,
  loading = 'lazy',
  fetchpriority = 'auto',
  decoding = 'async',
  cap = true,
} = Astro.props;

const stile = [
  data?.objectPosition ? `object-position: ${data.objectPosition}` : null,
  cap && data ? `max-width: ${data.maxWidth}px` : null,
]
  .filter(Boolean)
  .join('; ');
---

{
  data && (
    <picture>
      {data.sources.map((source) => (
        <source type={source.type} srcset={source.srcset} sizes={source.sizes} />
      ))}
      <img
        src={data.src}
        width={data.width}
        height={data.height}
        alt={data.alt}
        sizes={data.sizes}
        class={className}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding={decoding}
        data-usage={data.usage}
        data-max-width={data.maxWidth}
        style={stile || undefined}
      />
    </picture>
  )
}
