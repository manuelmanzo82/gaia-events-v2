---
import type { Lang } from '../config/site';
import { useTranslations } from '../i18n';
import { path, type RouteKey } from '../i18n/routes';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
  slug?: string;
  availableLangs?: readonly Lang[];
}

const { lang, routeKey, slug, availableLangs } = Astro.props;
const t = useTranslations(lang);

const items: RouteKey[] = [
  'about',
  'services',
  'portfolio',
  'reviews',
  'blog',
  'faq',
  'contact',
];

const navKeyToLabel: Record<string, Parameters<typeof t>[0]> = {
  about: 'nav.about',
  services: 'nav.services',
  portfolio: 'nav.portfolio',
  reviews: 'nav.reviews',
  blog: 'nav.blog',
  faq: 'nav.faq',
  contact: 'nav.contact',
};
---

<header class="site-header">
  <a class="brand" href={path('home', lang)}>Gaia Events</a>

  <nav aria-label={t('nav.menu')}>
    <ul>
      {
        items.map((key) => (
          <li>
            <a href={path(key, lang)} aria-current={routeKey === key ? 'page' : undefined}>
              {t(navKeyToLabel[key]!)}
            </a>
          </li>
        ))
      }
      <li>
        <a href={path('quote', lang)} aria-current={routeKey === 'quote' ? 'page' : undefined}>
          {t('nav.quote')}
        </a>
      </li>
    </ul>
  </nav>

  <LangSwitcher lang={lang} routeKey={routeKey} slug={slug} availableLangs={availableLangs} />
</header>

<style>
  /* Stile minimo: il design del header arriva nella fase successiva. */
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-beige);
  }

  .brand {
    font-family: var(--font-display);
    font-size: 1.25rem;
    text-decoration: none;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
  }

  :global(.lang-switcher) {
    margin-left: auto;
    font-size: 0.875rem;
  }
</style>
