---
import type { Lang } from '../config/site';
import { useTranslations, type UIKey } from '../i18n';
import { path, type RouteKey } from '../i18n/routes';
import { existsIn } from '../lib/availability';
import LangSwitcher from './LangSwitcher.astro';
import LogoGaia from './LogoGaia.astro';

/**
 * Header senza barra, stile Haywood.
 *
 * In cima alla pagina non ha sfondo: logo e voci stanno direttamente sulla
 * pagina e prendono il colore dalla sezione sotto (data-header-theme,
 * aggiornato da scripts/theme-observer.ts: avorio su hero e sezioni
 * scure, inchiostro su quelle chiare), con transizione morbida.
 *
 * Scorrendo in giù si nasconde (translateY), così non copre mai foto,
 * schede o fascia orizzontale; scorrendo in su riappare compatto (logo
 * più piccolo) con fondo PIENO del colore della sezione sotto, mai
 * semitrasparente. Tornando in cima il fondo sparisce. Con
 * prefers-reduced-motion niente animazione: appare e sparisce e basta.
 *
 * Menu corto: Chi sono · Servizi · Luoghi · Storie · Blog · Contatti,
 * più Preventivo e lingua. Portfolio, Dicono di me, Partner e FAQ stanno
 * nel footer. Su desktop le voci sono in riga; sotto i 64rem un pulsante
 * apre un pannello a tutto schermo. Le voci restano filtrate con
 * existsIn(): niente link a pagine che in questa lingua non esistono.
 */
interface Props {
  lang: Lang;
  routeKey: RouteKey;
  slug?: string;
  availableLangs?: readonly Lang[];
}

const { lang, routeKey, slug, availableLangs } = Astro.props;
const t = useTranslations(lang);

const VOCI: Array<{ key: RouteKey; label: UIKey }> = [
  { key: 'about', label: 'nav.about' },
  { key: 'services', label: 'nav.services' },
  { key: 'places', label: 'nav.places' },
  { key: 'stories', label: 'nav.stories' },
  { key: 'blog', label: 'nav.blog' },
  { key: 'contact', label: 'nav.contact' },
];

const voci = VOCI.filter((voce) => existsIn(voce.key, lang));
const preventivo = existsIn('quote', lang);
---

<header class="site-header" data-header-theme="light">
  <a class="brand" href={path('home', lang)} aria-label="Gaia Events">
    <LogoGaia />
  </a>

  <button
    type="button"
    class="menu-toggle"
    aria-expanded="false"
    aria-controls="menu-principale"
  >
    <span class="menu-toggle-testo" data-apri>{t('nav.menu')}</span>
    <span class="menu-toggle-testo" data-chiudi>{t('nav.close')}</span>
    <span class="menu-toggle-linee" aria-hidden="true"><i></i><i></i></span>
  </button>

  <nav id="menu-principale" class="menu" aria-label={t('nav.menu')}>
    <ul class="menu-voci">
      {
        voci.map((voce) => (
          <li>
            <a
              href={path(voce.key, lang)}
              aria-current={routeKey === voce.key ? 'page' : undefined}
            >
              {t(voce.label)}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="menu-coda">
      {
        preventivo && (
          <a class="btn menu-cta" href={path('quote', lang)}>
            {t('nav.quote')}
          </a>
        )
      }
      <LangSwitcher lang={lang} routeKey={routeKey} slug={slug} availableLangs={availableLangs} />
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');

  if (header && toggle) {
    let aperto = false;

    const imposta = (stato: boolean): void => {
      aperto = stato;
      header.classList.toggle('menu-aperto', stato);
      toggle.setAttribute('aria-expanded', String(stato));
      document.documentElement.classList.toggle('menu-bloccato', stato);
      if (stato) header.classList.remove('nascosto');
    };

    toggle.addEventListener('click', () => imposta(!aperto));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') imposta(false);
    });

    // Direzione dello scroll: in giù il header si nasconde, in su torna
    // compatto con il fondo pieno; in cima torna trasparente. La soglia
    // di 6 px evita il tremolio sui micro-movimenti.
    const SOGLIA_CIMA = 48;
    const SOGLIA_DIREZIONE = 6;
    let ultimoY = window.scrollY;

    const aggiorna = (): void => {
      const y = window.scrollY;

      if (y < SOGLIA_CIMA) {
        header.classList.remove('nascosto', 'compatto');
      } else if (!aperto) {
        if (y > ultimoY + SOGLIA_DIREZIONE) {
          header.classList.add('nascosto');
          header.classList.add('compatto');
        } else if (y < ultimoY - SOGLIA_DIREZIONE) {
          header.classList.remove('nascosto');
          header.classList.add('compatto');
        }
      }

      ultimoY = y;
    };

    window.addEventListener('scroll', aggiorna, { passive: true });
    aggiorna();
  }
</script>

<style>
  .site-header {
    --logo-h: 64px;
    --logo-h-md: 96px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.5rem clamp(1.25rem, 4vw, 3.5rem);
    color: var(--color-inchiostro);
    background: transparent;
    transform: translateY(0);
    transition:
      transform 0.5s var(--ease-gaia),
      color 0.5s var(--ease-gaia),
      background-color 0.35s var(--ease-gaia),
      padding 0.35s var(--ease-gaia);
    pointer-events: none;
  }

  .site-header > *,
  .menu {
    pointer-events: auto;
  }

  .site-header[data-header-theme='dark'] {
    color: var(--color-avorio-su-notte);
  }

  /* Scorrendo in giù: via. */
  .site-header.nascosto {
    transform: translateY(-110%);
  }

  /* Scorrendo in su: compatto, con fondo PIENO del colore della sezione. */
  .site-header.compatto {
    --logo-h: 48px;
    --logo-h-md: 64px;
    padding-block: 0.4rem;
    background: var(--color-avorio);
  }

  .site-header.compatto[data-header-theme='dark'] {
    background: var(--color-notte);
  }

  .brand {
    display: inline-flex;
    line-height: 0;
    text-decoration: none;
  }

  :global(.site-header .logo-gaia svg) {
    transition: height 0.35s var(--ease-gaia);
  }

  /* — Voci del menu — */
  .menu-voci {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-voci a {
    position: relative;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .menu-voci a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-gaia);
  }

  .menu-voci a:hover::after,
  .menu-voci a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .menu-coda {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .menu-cta {
    padding: 0.7rem 1.4rem;
    font-size: 0.68rem;
    color: inherit;
  }

  .site-header[data-header-theme='dark'] .menu-cta:hover {
    background: var(--color-avorio-su-notte);
    border-color: var(--color-avorio-su-notte);
    color: var(--color-notte);
  }

  :global(.site-header .lang-switcher) {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* — Pulsante del menu (solo sotto i 64rem) — */
  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .menu-toggle-linee {
    display: inline-grid;
    gap: 5px;
    width: 22px;
  }

  .menu-toggle-linee i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--ease-gaia);
  }

  .menu-toggle [data-chiudi] {
    display: none;
  }

  .menu-aperto .menu-toggle [data-apri] {
    display: none;
  }

  .menu-aperto .menu-toggle [data-chiudi] {
    display: inline;
  }

  .menu-aperto .menu-toggle-linee i:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .menu-aperto .menu-toggle-linee i:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (min-width: 64rem) {
    .menu {
      display: flex;
      align-items: center;
      gap: 2.25rem;
    }
  }

  @media (max-width: 63.98rem) {
    .site-header {
      --logo-h: 56px;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .menu {
      position: fixed;
      inset: 0;
      z-index: -1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 2.5rem;
      padding: 6rem clamp(1.25rem, 6vw, 3rem) 3rem;
      background: var(--color-avorio);
      color: var(--color-inchiostro);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.45s var(--ease-gaia),
        visibility 0s linear 0.45s;
    }

    .menu-aperto .menu {
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }

    .menu-aperto {
      color: var(--color-inchiostro) !important;
      background: var(--color-avorio) !important;
    }

    .menu-voci {
      flex-direction: column;
      gap: 0.5rem;
    }

    .menu-voci a {
      display: inline-block;
      padding: 0.35rem 0;
      font-family: var(--font-display);
      font-size: clamp(1.75rem, 6vw, 2.5rem);
      font-weight: 340;
      letter-spacing: 0;
      text-transform: none;
    }

    .menu-coda {
      flex-wrap: wrap;
      gap: 1.5rem;
    }
  }

  :global(html.menu-bloccato) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .menu,
    .menu-voci a::after,
    .menu-toggle-linee i,
    :global(.site-header .logo-gaia svg) {
      transition: none;
    }
  }
</style>
