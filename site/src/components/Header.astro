---
import { BUSINESS, type Lang } from '../config/site';
import { useTranslations, type UIKey } from '../i18n';
import { path, type RouteKey } from '../i18n/routes';
import { existsIn } from '../lib/availability';
import LangSwitcher from './LangSwitcher.astro';
import LogoGaia from './LogoGaia.astro';

/**
 * Header senza barra: logo e menu stanno sempre sulla pagina, mai uno
 * sfondo né una sfumatura dietro, né in cima né dopo lo scroll (giro 4:
 * la sfumatura del giro 3 è stata tolta su richiesta; resta solo il cambio
 * di colore e, sulle foto, l'ombra sottile del testo). Il colore lo decide la
 * sezione sotto (data-header-theme, da scripts/theme-observer.ts: avorio
 * su hero, sezioni scure e foto; inchiostro su quelle chiare), con
 * transizione morbida. Sopra una foto (sezioni con data-foto) il testo
 * prende un'ombra morbidissima per la leggibilità.
 *
 * Il logo resta sempre alla misura originale (130 px desktop, 80 px
 * mobile): allo scroll cambia solo colore, mai dimensione.
 *
 * Menu corto: Chi sono · Servizi · Luoghi · Storie · Blog · Contatti, più
 * Preventivo e lingua; il resto sta nel footer. Su desktop le voci sono
 * in riga; sotto gli 80rem un pulsante apre un pannello a tutto schermo
 * (a 15 px le voci, Preventivo e lingua accanto al logo chiedono ~1200 px).
 * Le voci sono filtrate con existsIn(): niente link a pagine che in
 * questa lingua non esistono.
 */
interface Props {
  lang: Lang;
  routeKey: RouteKey;
  slug?: string;
  availableLangs?: readonly Lang[];
}

const { lang, routeKey, slug, availableLangs } = Astro.props;
const t = useTranslations(lang);

const VOCI: Array<{ key: RouteKey; label: UIKey }> = [
  { key: 'about', label: 'nav.about' },
  { key: 'services', label: 'nav.services' },
  { key: 'places', label: 'nav.places' },
  { key: 'stories', label: 'nav.stories' },
  { key: 'blog', label: 'nav.blog' },
  { key: 'contact', label: 'nav.contact' },
];

const voci = VOCI.filter((voce) => existsIn(voce.key, lang));
const preventivo = existsIn('quote', lang);
---

<header class="site-header" data-header-theme="light" data-header-foto="0" data-header-theme-menu="light" data-header-foto-menu="0">
  <a class="brand" href={path('home', lang)} aria-label="Gaia Events">
    <LogoGaia />
  </a>

  <button
    type="button"
    class="menu-toggle"
    aria-expanded="false"
    aria-controls="menu-principale"
  >
    <span class="menu-toggle-testo" data-apri>{t('nav.menu')}</span>
    <span class="menu-toggle-testo" data-chiudi>{t('nav.close')}</span>
    <span class="menu-toggle-linee" aria-hidden="true"><i></i><i></i></span>
  </button>

  <nav id="menu-principale" class="menu" aria-label={t('nav.menu')}>
    <ul class="menu-voci">
      {
        voci.map((voce, i) => (
          <li style={`--n: ${i}`}>
            <a
              href={path(voce.key, lang)}
              aria-current={routeKey === voce.key ? 'page' : undefined}
            >
              {t(voce.label)}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="menu-coda">
      {
        preventivo && (
          <a class="btn menu-cta" href={path('quote', lang)}>
            {t('nav.quote')}
          </a>
        )
      }
      <LangSwitcher lang={lang} routeKey={routeKey} slug={slug} availableLangs={availableLangs} />
    </div>

    {/* Solo nel pannello mobile (sotto gli 80rem): due contatti in fondo. */}
    <ul class="menu-contatti" role="list">
      <li>
        <a href={`https://wa.me/${BUSINESS.whatsapp}`} rel="noopener" target="_blank" aria-label={t('cta.whatsapp')}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.3z" />
            <path d="M9.2 8.6c.2-.5.5-.5.8-.5h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.2-.1.3 0 .5a6.4 6.4 0 0 0 3 2.8c.2.1.4.1.5-.1l.7-.8c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.2.3.4 0 .5-.2 1.1-.6 1.4-.5.4-1.2.6-1.8.5-3.1-.6-5.6-3-6.3-6.1-.2-.7 0-1.4.1-2z" />
          </svg>
          <span>WhatsApp</span>
        </a>
      </li>
      <li>
        <a href={BUSINESS.instagramUrl} rel="noopener me" target="_blank">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
            <circle cx="12" cy="12" r="4.4" />
            <circle cx="17.6" cy="6.4" r="1.05" fill="currentColor" stroke="none" />
          </svg>
          <span>Instagram</span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');

  if (header && toggle) {
    let aperto = false;

    const imposta = (stato: boolean): void => {
      aperto = stato;
      header.classList.toggle('menu-aperto', stato);
      toggle.setAttribute('aria-expanded', String(stato));
      document.documentElement.classList.toggle('menu-bloccato', stato);
    };

    toggle.addEventListener('click', () => imposta(!aperto));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') imposta(false);
    });

  }
</script>

<style>
  .site-header {
    --logo-h: 80px;
    --logo-h-md: 130px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.5rem clamp(1.25rem, 4vw, 3.5rem);
    color: var(--color-inchiostro);
    background: transparent;
    transition:
      color 0.5s var(--ease-gaia),
      text-shadow 0.5s var(--ease-gaia),
      padding 0.35s var(--ease-gaia);
    pointer-events: none;
  }

  .site-header > *,
  .menu {
    pointer-events: auto;
  }

  /* Il tema arriva per lato (theme-observer.ts, giro 6): il logo guarda
     il punto sotto di sé, il menu e l'hamburger il punto sotto di loro.
     Sopra una foto, sempre avorio. */
  .brand,
  .menu,
  .menu-toggle {
    transition:
      color 0.5s var(--ease-gaia),
      text-shadow 0.5s var(--ease-gaia);
  }

  .site-header[data-header-theme='dark'] .brand {
    color: var(--color-avorio-su-notte);
  }

  /* Ogni voce del menu ha il suo tema (data-tema dal punto sotto di sé). */
  .menu-voci a,
  .menu-cta,
  :global(.site-header .lang-switcher) {
    transition:
      color 0.5s var(--ease-gaia),
      text-shadow 0.5s var(--ease-gaia);
  }

  .menu-voci a[data-tema='dark'],
  .menu-cta[data-tema='dark'],
  :global(.site-header .lang-switcher[data-tema='dark']),
  .menu-toggle[data-tema='dark'] {
    color: var(--color-avorio-su-notte);
  }

  /* Sopra una foto: ombra testuale morbidissima, quasi invisibile. */
  .menu-voci a[data-foto='1'],
  :global(.site-header .lang-switcher[data-foto='1']),
  .menu-toggle[data-foto='1'] {
    text-shadow: 0 1px 2px rgb(27 22 17 / 0.28), 0 0 18px rgb(27 22 17 / 0.22);
  }

  .site-header[data-header-foto='1'] :global(.logo-gaia svg) {
    filter: drop-shadow(0 1px 2px rgb(27 22 17 / 0.28)) drop-shadow(0 0 14px rgb(27 22 17 / 0.2));
  }

  /* Il logo resta sempre alla misura originale (80 px mobile, 130 px da
     48rem): allo scroll cambia solo colore. Le pagine interne lasciano in
     alto lo spazio del header con --altezza-header (BaseLayout). */
  :global(:root) {
    --altezza-header: 96px;
  }

  @media (min-width: 48rem) {
    :global(:root) {
      --altezza-header: 146px;
    }
  }

  .brand {
    display: inline-flex;
    line-height: 0;
    text-decoration: none;
  }

  :global(.site-header .logo-gaia svg) {
    transition: filter 0.5s var(--ease-gaia);
  }

  /* — Voci del menu — */
  .menu-voci {
    display: flex;
    flex-wrap: nowrap;
    gap: clamp(1.4rem, 1.9vw, 2.1rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-voci a {
    position: relative;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    white-space: nowrap;
    text-transform: uppercase;
    text-decoration: none;
  }

  .menu-voci a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-gaia);
  }

  .menu-voci a:hover::after,
  .menu-voci a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .menu-coda {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .menu-cta {
    padding: 0.8rem 1.6rem;
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    white-space: nowrap;
    color: inherit;
    text-shadow: none;
  }

  .menu-cta[data-tema='dark']:hover {
    background: var(--color-avorio-su-notte);
    border-color: var(--color-avorio-su-notte);
    color: var(--color-notte);
  }

  :global(.site-header .lang-switcher) {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    white-space: nowrap;
    text-transform: uppercase;
  }

  /* — Pulsante del menu (solo sotto gli 80rem) — */
  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .menu-toggle-linee {
    display: inline-grid;
    gap: 5px;
    width: 22px;
  }

  .menu-toggle-linee i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--ease-gaia);
  }

  .menu-toggle [data-chiudi] {
    display: none;
  }

  .menu-aperto .menu-toggle [data-apri] {
    display: none;
  }

  .menu-aperto .menu-toggle [data-chiudi] {
    display: inline;
  }

  .menu-aperto .menu-toggle-linee i:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .menu-aperto .menu-toggle-linee i:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  .menu-contatti {
    display: none;
  }

  @media (min-width: 80rem) {
    .menu {
      display: flex;
      align-items: center;
      gap: 2.25rem;
    }
  }

  @media (max-width: 79.98rem) {
    .site-header {
      --logo-h: 80px;
    }

    .menu-toggle {
      display: inline-flex;
    }

    /* Pannello a tutto schermo (giro 5): voci in Cormorant a 34 px con il
       numero piccolo a sinistra, Preventivo come bottone pieno a tutta
       larghezza, English sotto, WhatsApp e Instagram in fondo. Apertura
       in dissolvenza, voci a cascata. */
    .menu {
      position: fixed;
      inset: 0;
      z-index: -1;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: 2rem;
      padding: calc(var(--altezza-header, 96px) + 1rem) 1.25rem 2rem;
      overflow-y: auto;
      background: var(--color-avorio);
      color: var(--color-inchiostro);
      text-shadow: none;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.45s var(--ease-gaia),
        visibility 0s linear 0.45s;
    }

    .menu-aperto .menu {
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }

    /* A pannello aperto il header è sul pannello avorio: inchiostro. */
    .menu-aperto,
    .menu-aperto .brand,
    .menu-aperto .menu,
    .menu-aperto .menu [data-tema],
    .menu-aperto .menu-toggle {
      color: var(--color-inchiostro) !important;
      text-shadow: none !important;
    }

    .menu-aperto :global(.logo-gaia svg) {
      filter: none !important;
    }

    .menu-voci {
      flex-direction: column;
      gap: 0;
      margin-top: auto;
    }

    .menu-voci li {
      display: flex;
      align-items: baseline;
      gap: 0.9rem;
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.5s var(--ease-gaia),
        transform 0.5s var(--ease-gaia);
    }

    .menu-aperto .menu-voci li {
      opacity: 1;
      transform: none;
      transition-delay: calc(0.08s + var(--n, 0) * 0.05s);
    }

    .menu-voci li::before {
      content: '0' counter(voce);
      counter-increment: voce;
      flex: none;
      width: 1.6rem;
      font-family: var(--font-display);
      font-style: italic;
      font-size: 0.875rem;
      letter-spacing: 0.06em;
      color: var(--color-oro-testo);
    }

    .menu-voci {
      counter-reset: voce;
    }

    .menu-voci a {
      display: flex;
      align-items: center;
      min-height: 60px;
      font-family: var(--font-display);
      font-size: 2.125rem;
      font-weight: 340;
      letter-spacing: 0;
      text-transform: none;
    }

    .menu-voci a::after {
      display: none;
    }

    .menu-coda {
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
    }

    .menu-cta {
      min-height: 52px;
      font-size: 0.875rem;
      background: var(--color-bordeaux);
      border-color: var(--color-bordeaux);
      color: var(--color-avorio) !important;
    }

    :global(.site-header .lang-switcher) {
      font-size: 0.875rem;
      text-align: center;
    }

    :global(.site-header .lang-switcher a) {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }

    .menu-contatti {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 2rem;
      margin: 0;
      padding: 1.25rem 0 0;
      border-top: 1px solid color-mix(in srgb, var(--color-inchiostro) 14%, transparent);
      list-style: none;
    }

    .menu-contatti a {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      min-height: 44px;
      font-size: 0.9375rem;
      letter-spacing: 0.02em;
      text-decoration: none;
    }
  }

  @media (max-width: 79.98rem) and (prefers-reduced-motion: reduce) {
    .menu-voci li {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  :global(html.menu-bloccato) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .menu,
    .menu-voci a::after,
    .menu-toggle-linee i,
    :global(.site-header .logo-gaia svg) {
      transition: none;
    }
  }
</style>
