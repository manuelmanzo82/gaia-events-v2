---
import type { Lang } from '../config/site';
import { useTranslations, type UIKey } from '../i18n';
import { path, type RouteKey } from '../i18n/routes';
import { existsIn } from '../lib/availability';
import LangSwitcher from './LangSwitcher.astro';
import LogoGaia from './LogoGaia.astro';

/**
 * Header senza barra: logo e menu stanno sempre sulla pagina, mai uno
 * sfondo dietro, né in cima né dopo lo scroll. Il colore lo decide la
 * sezione sotto (data-header-theme, da scripts/theme-observer.ts: avorio
 * su hero, sezioni scure e foto; inchiostro su quelle chiare), con
 * transizione morbida. Sopra una foto (sezioni con data-foto) il testo
 * prende un'ombra morbidissima per la leggibilità.
 *
 * Allo scroll il logo si riduce (130 → 64 px su desktop) e resta così;
 * tornando in cima torna grande.
 *
 * Menu corto: Chi sono · Servizi · Luoghi · Storie · Blog · Contatti, più
 * Preventivo e lingua; il resto sta nel footer. Su desktop le voci sono
 * in riga; sotto gli 80rem un pulsante apre un pannello a tutto schermo
 * (a 15 px le voci, Preventivo e lingua accanto al logo chiedono ~1200 px).
 * Le voci sono filtrate con existsIn(): niente link a pagine che in
 * questa lingua non esistono.
 */
interface Props {
  lang: Lang;
  routeKey: RouteKey;
  slug?: string;
  availableLangs?: readonly Lang[];
}

const { lang, routeKey, slug, availableLangs } = Astro.props;
const t = useTranslations(lang);

const VOCI: Array<{ key: RouteKey; label: UIKey }> = [
  { key: 'about', label: 'nav.about' },
  { key: 'services', label: 'nav.services' },
  { key: 'places', label: 'nav.places' },
  { key: 'stories', label: 'nav.stories' },
  { key: 'blog', label: 'nav.blog' },
  { key: 'contact', label: 'nav.contact' },
];

const voci = VOCI.filter((voce) => existsIn(voce.key, lang));
const preventivo = existsIn('quote', lang);
---

<header class="site-header" data-header-theme="light" data-header-foto="0">
  <a class="brand" href={path('home', lang)} aria-label="Gaia Events">
    <LogoGaia />
  </a>

  <button
    type="button"
    class="menu-toggle"
    aria-expanded="false"
    aria-controls="menu-principale"
  >
    <span class="menu-toggle-testo" data-apri>{t('nav.menu')}</span>
    <span class="menu-toggle-testo" data-chiudi>{t('nav.close')}</span>
    <span class="menu-toggle-linee" aria-hidden="true"><i></i><i></i></span>
  </button>

  <nav id="menu-principale" class="menu" aria-label={t('nav.menu')}>
    <ul class="menu-voci">
      {
        voci.map((voce) => (
          <li>
            <a
              href={path(voce.key, lang)}
              aria-current={routeKey === voce.key ? 'page' : undefined}
            >
              {t(voce.label)}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="menu-coda">
      {
        preventivo && (
          <a class="btn menu-cta" href={path('quote', lang)}>
            {t('nav.quote')}
          </a>
        )
      }
      <LangSwitcher lang={lang} routeKey={routeKey} slug={slug} availableLangs={availableLangs} />
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');

  if (header && toggle) {
    let aperto = false;

    const imposta = (stato: boolean): void => {
      aperto = stato;
      header.classList.toggle('menu-aperto', stato);
      toggle.setAttribute('aria-expanded', String(stato));
      document.documentElement.classList.toggle('menu-bloccato', stato);
    };

    toggle.addEventListener('click', () => imposta(!aperto));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') imposta(false);
    });

    // Allo scroll il logo si riduce e resta ridotto; in cima torna grande.
    const SOGLIA = 48;
    const aggiorna = (): void => {
      header.classList.toggle('ridotto', window.scrollY > SOGLIA);
    };
    window.addEventListener('scroll', aggiorna, { passive: true });
    aggiorna();
  }
</script>

<style>
  .site-header {
    --logo-h: 80px;
    --logo-h-md: 130px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.5rem clamp(1.25rem, 4vw, 3.5rem);
    color: var(--color-inchiostro);
    background: transparent;
    transition:
      color 0.5s var(--ease-gaia),
      text-shadow 0.5s var(--ease-gaia),
      padding 0.35s var(--ease-gaia);
    pointer-events: none;
  }

  .site-header > *,
  .menu {
    pointer-events: auto;
  }

  .site-header[data-header-theme='dark'] {
    color: var(--color-avorio-su-notte);
  }

  /* Sfumatura dietro logo e menu, nel colore del tema: niente barra (nessun
     bordo, svanisce verso il basso), ma garantisce il contrasto del menu
     (≥ 4.5:1) anche sopra foto chiare, schede e fasce agganciate, dove
     prima il testo finiva su cieli bianchi o mezzo su foto e mezzo su
     avorio. Due strati che si scambiano l'opacità, perché un gradiente
     non si anima. */
  .site-header::before,
  .site-header::after {
    content: '';
    position: absolute;
    inset: 0 0 -2.5rem;
    z-index: -1;
    pointer-events: none;
    transition: opacity 0.5s var(--ease-gaia);
  }

  .site-header::before {
    background: linear-gradient(
      180deg,
      rgb(250 248 245 / 0.94) 0%,
      rgb(250 248 245 / 0.86) 62%,
      rgb(250 248 245 / 0) 100%
    );
    opacity: 1;
  }

  .site-header::after {
    background: linear-gradient(
      180deg,
      rgb(27 22 17 / 0.7) 0%,
      rgb(27 22 17 / 0.58) 62%,
      rgb(27 22 17 / 0) 100%
    );
    opacity: 0;
  }

  .site-header[data-header-theme='dark']::before {
    opacity: 0;
  }

  .site-header[data-header-theme='dark']::after {
    opacity: 1;
  }

  /* Pannello mobile aperto: il pannello avorio fa già da fondo. */
  .site-header.menu-aperto::before,
  .site-header.menu-aperto::after {
    opacity: 0;
  }

  /* Sopra una foto: ombra testuale morbidissima, quasi invisibile. */
  .site-header[data-header-foto='1'] {
    text-shadow: 0 1px 2px rgb(27 22 17 / 0.28), 0 0 18px rgb(27 22 17 / 0.22);
  }

  .site-header[data-header-foto='1'] :global(.logo-gaia svg) {
    filter: drop-shadow(0 1px 2px rgb(27 22 17 / 0.28)) drop-shadow(0 0 14px rgb(27 22 17 / 0.2));
  }

  /* Dopo lo scroll il logo si riduce e resta così. */
  .site-header.ridotto {
    --logo-h: 56px;
    --logo-h-md: 64px;
    padding-block: 0.4rem;
  }

  .brand {
    display: inline-flex;
    line-height: 0;
    text-decoration: none;
  }

  :global(.site-header .logo-gaia svg) {
    transition:
      height 0.45s var(--ease-gaia),
      filter 0.5s var(--ease-gaia);
  }

  /* — Voci del menu — */
  .menu-voci {
    display: flex;
    flex-wrap: nowrap;
    gap: clamp(1.4rem, 1.9vw, 2.1rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-voci a {
    position: relative;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    white-space: nowrap;
    text-transform: uppercase;
    text-decoration: none;
  }

  .menu-voci a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-gaia);
  }

  .menu-voci a:hover::after,
  .menu-voci a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .menu-coda {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .menu-cta {
    padding: 0.8rem 1.6rem;
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    white-space: nowrap;
    color: inherit;
    text-shadow: none;
  }

  .site-header[data-header-theme='dark'] .menu-cta:hover {
    background: var(--color-avorio-su-notte);
    border-color: var(--color-avorio-su-notte);
    color: var(--color-notte);
  }

  :global(.site-header .lang-switcher) {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    white-space: nowrap;
    text-transform: uppercase;
  }

  /* — Pulsante del menu (solo sotto gli 80rem) — */
  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .menu-toggle-linee {
    display: inline-grid;
    gap: 5px;
    width: 22px;
  }

  .menu-toggle-linee i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--ease-gaia);
  }

  .menu-toggle [data-chiudi] {
    display: none;
  }

  .menu-aperto .menu-toggle [data-apri] {
    display: none;
  }

  .menu-aperto .menu-toggle [data-chiudi] {
    display: inline;
  }

  .menu-aperto .menu-toggle-linee i:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .menu-aperto .menu-toggle-linee i:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (min-width: 80rem) {
    .menu {
      display: flex;
      align-items: center;
      gap: 2.25rem;
    }
  }

  @media (max-width: 79.98rem) {
    .site-header {
      --logo-h: 80px;
    }

    .site-header.ridotto {
      --logo-h: 56px;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .menu {
      position: fixed;
      inset: 0;
      z-index: -1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 2.5rem;
      padding: 6rem clamp(1.25rem, 6vw, 3rem) 3rem;
      background: var(--color-avorio);
      color: var(--color-inchiostro);
      text-shadow: none;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.45s var(--ease-gaia),
        visibility 0s linear 0.45s;
    }

    .menu-aperto .menu {
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }

    /* A pannello aperto il header è sul pannello avorio: inchiostro. */
    .menu-aperto {
      color: var(--color-inchiostro) !important;
      text-shadow: none !important;
    }

    .menu-aperto :global(.logo-gaia svg) {
      filter: none !important;
    }

    .menu-voci {
      flex-direction: column;
      gap: 0.75rem;
    }

    .menu-voci a {
      display: inline-block;
      padding: 0.5rem 0;
      font-size: 1.375rem;
      letter-spacing: 0.12em;
    }

    .menu-cta {
      font-size: 1rem;
    }

    :global(.site-header .lang-switcher) {
      font-size: 1rem;
    }

    .menu-coda {
      flex-wrap: wrap;
      gap: 1.5rem;
    }
  }

  :global(html.menu-bloccato) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .menu,
    .menu-voci a::after,
    .menu-toggle-linee i,
    :global(.site-header .logo-gaia svg) {
      transition: none;
    }
  }
</style>
