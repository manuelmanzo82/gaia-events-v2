---
import { BUSINESS, type Lang } from '../config/site';
import { useTranslations, type UIKey } from '../i18n';
import { path, type RouteKey } from '../i18n/routes';
import { existsIn } from '../lib/availability';
import Icona from './Icona.astro';
import LangSwitcher from './LangSwitcher.astro';
import LogoGaia from './LogoGaia.astro';

/**
 * Header senza barra: logo e menu stanno sempre sulla pagina, mai uno
 * sfondo né una sfumatura dietro, né in cima né dopo lo scroll (giro 4:
 * la sfumatura del giro 3 è stata tolta su richiesta; resta solo il cambio
 * di colore e, sulle foto, l'ombra sottile del testo). Il colore lo decide la
 * sezione sotto (data-header-theme, da scripts/theme-observer.ts: avorio
 * su hero, sezioni scure e foto; inchiostro su quelle chiare), con
 * transizione morbida. Sopra una foto (sezioni con data-foto) il testo
 * prende un'ombra morbidissima per la leggibilità.
 *
 * Il logo resta sempre alla misura originale (130 px desktop, 80 px
 * mobile): allo scroll cambia solo colore, mai dimensione.
 *
 * Menu (giro 11): Chi sono · Servizi · Luoghi · Matrimoni · Dicono di me ·
 * Magazine, più Preventivo e lingua. Contatti, Partner e FAQ stanno nel
 * footer. Su desktop le voci sono in riga; sotto gli 80rem un pulsante
 * apre un pannello a tutto schermo. Le voci sono filtrate con existsIn():
 * niente link a pagine che in questa lingua non esistono.
 */
interface Props {
  lang: Lang;
  routeKey: RouteKey;
  slug?: string;
  availableLangs?: readonly Lang[];
}

const { lang, routeKey, slug, availableLangs } = Astro.props;
const t = useTranslations(lang);

const VOCI: Array<{ key: RouteKey; label: UIKey }> = [
  { key: 'about', label: 'nav.about' },
  { key: 'services', label: 'nav.services' },
  { key: 'places', label: 'nav.places' },
  { key: 'stories', label: 'nav.stories' },
  { key: 'reviews', label: 'nav.reviews' },
  { key: 'blog', label: 'nav.blog' },
];

const voci = VOCI.filter((voce) => existsIn(voce.key, lang));
const preventivo = existsIn('quote', lang);
---

<header class="site-header" data-header-theme="light" data-header-foto="0">
  <a class="brand" href={path('home', lang)} aria-label="Gaia Events">
    <LogoGaia />
  </a>

  <button
    type="button"
    class="menu-toggle"
    aria-expanded="false"
    aria-controls="menu-principale"
  >
    <span class="menu-toggle-testo" data-apri>{t('nav.menu')}</span>
    <span class="menu-toggle-testo" data-chiudi>{t('nav.close')}</span>
    <span class="menu-toggle-linee" aria-hidden="true"><i></i><i></i></span>
  </button>

  <nav id="menu-principale" class="menu" aria-label={t('nav.menu')}>
    <ul class="menu-voci">
      {
        voci.map((voce, i) => (
          <li style={`--n: ${i}`}>
            <a
              href={path(voce.key, lang)}
              aria-current={routeKey === voce.key ? 'page' : undefined}
            >
              {t(voce.label)}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="menu-coda">
      {
        preventivo && (
          <a class="btn menu-cta" href={path('quote', lang)}>
            {t('nav.quote')}
          </a>
        )
      }
      <LangSwitcher lang={lang} routeKey={routeKey} slug={slug} availableLangs={availableLangs} />
      <ul class="menu-social" role="list">
        <li>
          <a href={BUSINESS.instagramUrl} rel="noopener me" target="_blank" aria-label="Instagram">
            <Icona nome="instagram" dimensione={18} />
          </a>
        </li>
        <li>
          <a href={BUSINESS.facebookUrl} rel="noopener me" target="_blank" aria-label="Facebook">
            <Icona nome="facebook" dimensione={18} />
          </a>
        </li>
      </ul>
    </div>

    {/* Solo nel pannello hamburger (sotto gli 80rem): tre icone in fondo,
        senza scritte, 24 px dentro un tocco di 44. */}
    <ul class="menu-contatti" role="list">
      <li>
        <a href={`https://wa.me/${BUSINESS.whatsapp}`} rel="noopener" target="_blank" aria-label={t('cta.whatsapp')} title={t('cta.whatsapp')}>
          <Icona nome="whatsapp" />
        </a>
      </li>
      <li>
        <a href={BUSINESS.instagramUrl} rel="noopener me" target="_blank" aria-label="Instagram" title="Instagram">
          <Icona nome="instagram" />
        </a>
      </li>
      <li>
        <a href={BUSINESS.facebookUrl} rel="noopener me" target="_blank" aria-label="Facebook" title="Facebook">
          <Icona nome="facebook" />
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');

  if (header && toggle) {
    let aperto = false;

    const imposta = (stato: boolean): void => {
      aperto = stato;
      header.classList.toggle('menu-aperto', stato);
      toggle.setAttribute('aria-expanded', String(stato));
      document.documentElement.classList.toggle('menu-bloccato', stato);
    };

    toggle.addEventListener('click', () => imposta(!aperto));

    // Mobile: scendendo il header si nasconde, salendo ricompare con un
    // fondo pieno nel colore della sezione (avorio o notte); in cima alla
    // pagina torna senza fondo. Desktop invariato.
    const mobile = window.matchMedia('(max-width: 63.98rem)');
    let ultimo = window.scrollY;
    let inAttesa = false;
    const aggiornaScorrimento = (): void => {
      inAttesa = false;
      const y = window.scrollY;
      if (!mobile.matches || aperto) {
        header.classList.remove('nascosto', 'pieno');
      } else if (y < 24) {
        header.classList.remove('nascosto', 'pieno');
      } else if (y > ultimo + 4) {
        header.classList.add('nascosto', 'pieno');
      } else if (y < ultimo - 4) {
        header.classList.remove('nascosto');
        header.classList.add('pieno');
      }
      ultimo = y;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (inAttesa) return;
        inAttesa = true;
        requestAnimationFrame(aggiornaScorrimento);
      },
      { passive: true },
    );
    mobile.addEventListener('change', aggiornaScorrimento);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') imposta(false);
    });

  }
</script>

<style>
  .site-header {
    --logo-h: 80px;
    --logo-h-md: 130px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.5rem clamp(1.25rem, 4vw, 3.5rem);
    color: var(--color-inchiostro);
    background: transparent;
    transition:
      color 0.5s var(--ease-gaia),
      text-shadow 0.5s var(--ease-gaia),
      padding 0.35s var(--ease-gaia);
    pointer-events: none;
  }

  .site-header > *,
  .menu {
    pointer-events: auto;
  }

  /* Un solo colore per tutto il header (giro 10), dal data-theme della
     sezione sotto la linea a metà header (theme-observer.ts): avorio sulle
     sezioni con foto, inchiostro sui fondi chiari. */
  .site-header[data-header-theme='dark'] {
    color: var(--color-avorio-su-notte);
  }

  /* Sfumatura fissa in cima allo schermo (giro 10, chiusura): c'è solo
     quando il header è sopra una sezione con foto / scura. 150 px, da
     nero al 30% a trasparente, nessun bordo né fondo pieno; sta sotto logo
     e menu (z-index negativo nel contesto del header, che è fisso con
     z-index 50) e sopra i contenuti; pointer-events: none. Compare e
     sparisce in 300 ms col cambio di tema; con reduced-motion è
     istantanea. Stessa logica su mobile. */
  .site-header::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: -1;
    height: 150px;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.3) 0%, rgb(0 0 0 / 0) 100%);
    opacity: 0;
    transition: opacity 0.3s var(--ease-gaia);
    pointer-events: none;
  }

  .site-header[data-header-theme='dark']::before {
    opacity: 1;
  }

  /* A pannello mobile aperto il header è sull'avorio del pannello. */
  .site-header.menu-aperto::before {
    opacity: 0;
  }

  /* Sopra una foto: ombra testuale appena percettibile, su testo e logo. */
  .site-header[data-header-foto='1'] {
    text-shadow: 0 1px 2px rgb(27 22 17 / 0.3), 0 0 14px rgb(27 22 17 / 0.2);
  }

  .site-header[data-header-foto='1'] :global(.logo-gaia svg) {
    filter: drop-shadow(0 1px 2px rgb(27 22 17 / 0.3)) drop-shadow(0 0 12px rgb(27 22 17 / 0.18));
  }

  /* Il logo resta sempre alla misura originale (80 px mobile, 130 px da
     48rem): allo scroll cambia solo colore. Le pagine interne lasciano in
     alto lo spazio del header con --altezza-header (BaseLayout). */
  :global(:root) {
    --altezza-header: 96px;
  }

  @media (min-width: 48rem) {
    :global(:root) {
      --altezza-header: 146px;
    }
  }

  .brand {
    display: inline-flex;
    line-height: 0;
    text-decoration: none;
  }

  :global(.site-header .logo-gaia svg) {
    transition: filter 0.5s var(--ease-gaia);
  }

  /* — Voci del menu — */
  .menu-voci {
    display: flex;
    flex-wrap: nowrap;
    gap: clamp(1.4rem, 1.9vw, 2.1rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-voci a {
    position: relative;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    white-space: nowrap;
    text-transform: uppercase;
    text-decoration: none;
  }

  .menu-voci a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-gaia);
  }

  .menu-voci a:hover::after,
  .menu-voci a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .menu-coda {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* Tinte esplicite per tema: con currentColor all'hover la tinta si
     risolverebbe nel colore del testo già cambiato (fondo e testo uguali). */
  .menu-cta {
    --btn-tinta: var(--color-inchiostro);
    --btn-contro: var(--color-avorio);
    padding: 0.8rem 1.6rem;
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    white-space: nowrap;
    text-shadow: none;
  }

  .site-header[data-header-theme='dark'] .menu-cta {
    --btn-tinta: var(--color-avorio-su-notte);
    --btn-contro: var(--color-notte);
  }

  /* All'hover il testo non deve ereditare l'ombra del header. */
  .menu-cta:hover,
  .menu-cta:focus-visible {
    text-shadow: none;
  }

  /* «EN» discreto: più piccolo del menu, stesso colore. */
  :global(.site-header .lang-switcher) {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    white-space: nowrap;
    text-transform: uppercase;
    opacity: 0.85;
  }

  :global(.site-header .lang-switcher a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  /* Icone social: 18 px, stessa misura ottica, stesso colore. */
  .menu-social {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 44px;
    color: inherit;
    opacity: 0.85;
    transition: opacity 0.3s var(--ease-gaia);
  }

  .menu-social a:hover,
  .menu-social a:focus-visible {
    opacity: 1;
  }

  .menu-social svg {
    display: block;
  }

  /* — Pulsante del menu (solo sotto gli 80rem) — */
  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }

  /* Il contorno di focus solo da tastiera (:focus-visible, regola
     globale): al tocco il bottone prende il focus ma non mostra nulla. */
  .menu-toggle:focus:not(:focus-visible) {
    outline: none;
  }

  .menu-toggle-linee {
    display: inline-grid;
    gap: 5px;
    width: 22px;
  }

  .menu-toggle-linee i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--ease-gaia);
  }

  .menu-toggle [data-chiudi] {
    display: none;
  }

  .menu-aperto .menu-toggle [data-apri] {
    display: none;
  }

  .menu-aperto .menu-toggle [data-chiudi] {
    display: inline;
  }

  .menu-aperto .menu-toggle-linee i:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .menu-aperto .menu-toggle-linee i:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  .menu-contatti {
    display: none;
  }

  @media (min-width: 80rem) {
    .menu {
      display: flex;
      align-items: center;
      gap: 2.25rem;
    }
  }

  /* Mobile (giro 11): nascosto scendendo, pieno risalendo, trasparente in cima. */
  @media (max-width: 63.98rem) {
    .site-header {
      transition:
        transform 0.35s var(--ease-gaia),
        background-color 0.3s var(--ease-gaia),
        color 0.5s var(--ease-gaia),
        text-shadow 0.5s var(--ease-gaia);
    }

    .site-header.nascosto {
      transform: translateY(-100%);
    }

    .site-header.pieno {
      background: var(--color-avorio);
      text-shadow: none;
    }

    .site-header.pieno[data-header-theme='dark'] {
      background: var(--color-notte);
    }

    .site-header.pieno::before,
    .site-header.pieno :global(.logo-gaia svg) {
      filter: none;
      opacity: 0;
    }
  }

  @media (max-width: 79.98rem) {
    .site-header {
      --logo-h: 80px;
    }

    .menu-toggle {
      display: inline-flex;
    }

    /* Pannello a tutto schermo (giro 11, centrato): vale ovunque compaia
       l'hamburger (telefono, tablet, finestra stretta). Il blocco voci +
       Preventivo + EN + icone è centrato in orizzontale e in verticale
       nello spazio sotto il header: i margini auto della prima e
       dell'ultima voce si spartiscono lo spazio libero e, se lo schermo è
       basso, si azzerano e il pannello scorre senza tagliare nulla.
       Apertura in dissolvenza, voci a cascata. */
    .menu {
      --bordo-pannello: clamp(1.25rem, 4vw, 3.5rem);
      position: fixed;
      inset: 0;
      z-index: -1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: 1.5rem;
      padding: calc(var(--altezza-header, 96px) + 1rem) var(--bordo-pannello) 1.5rem;
      overflow-y: auto;
      text-align: center;
      background: var(--color-avorio);
      color: var(--color-inchiostro);
      text-shadow: none;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.45s var(--ease-gaia),
        visibility 0s linear 0.45s;
    }

    .menu-aperto .menu {
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }

    /* A pannello aperto il header è sul pannello avorio: inchiostro, e il
       logo nei suoi colori (ghirigoro pesca), senza ombre. */
    .menu-aperto,
    .menu-aperto .brand,
    .menu-aperto .menu,
    .menu-aperto .menu-toggle {
      --logo-accento: #e8c0a8;
      color: var(--color-inchiostro) !important;
      text-shadow: none !important;
    }

    .menu-aperto :global(.logo-gaia svg) {
      filter: none !important;
    }

    .menu-voci {
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      margin-top: auto;
    }

    .menu-voci li {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.5s var(--ease-gaia),
        transform 0.5s var(--ease-gaia);
    }

    .menu-aperto .menu-voci li {
      opacity: 1;
      transform: none;
      transition-delay: calc(0.08s + var(--n, 0) * 0.05s);
    }

    .menu-voci a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: clamp(44px, 6.5vh, 56px);
      padding-inline: 0.75rem;
      font-family: var(--font-display);
      font-size: clamp(2rem, 1.4rem + 2.6vw, 2.5rem);
      font-weight: 340;
      line-height: 1.1;
      letter-spacing: 0;
      text-transform: none;
    }

    .menu-voci a::after {
      display: none;
    }

    .menu-voci a[aria-current='page'] {
      color: var(--color-bordeaux);
    }

    /* Preventivo a cornice e, sotto, «EN»: uno sopra l'altro, centrati. */
    .menu-coda {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    /* Preventivo a cornice, come sul desktop: sul pannello avorio cornice e
       testo in inchiostro qualunque sia il tema del header sotto; al tocco
       fondo inchiostro e testo avorio. */
    .site-header.menu-aperto .menu-cta {
      --btn-tinta: var(--color-inchiostro);
      --btn-contro: var(--color-avorio);
      min-height: 48px;
      padding-inline: 1.5rem;
      font-size: 0.875rem;
    }

    /* «EN» ben visibile. */
    :global(.site-header .lang-switcher) {
      font-size: 1rem;
      letter-spacing: 0.18em;
      opacity: 1;
    }

    :global(.site-header .lang-switcher a) {
      min-height: 48px;
      padding-inline: 0.5rem;
      border-bottom: 1px solid currentColor;
    }

    /* Le icone della riga desktop non servono: in fondo ci sono i contatti. */
    .menu-social {
      display: none;
    }

    /* In fondo al blocco le tre icone in fila, centrate. */
    .menu-contatti {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      margin: 0 0 auto;
      padding: 0;
      list-style: none;
    }

    .menu-contatti a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      text-decoration: none;
      transition: background-color 0.3s var(--ease-gaia);
    }

    .menu-contatti a:hover,
    .menu-contatti a:focus-visible {
      background: color-mix(in srgb, var(--color-inchiostro) 8%, transparent);
    }

    .menu-contatti svg {
      display: block;
    }
  }

  @media (max-width: 79.98rem) and (prefers-reduced-motion: reduce) {
    .menu-voci li {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  :global(html.menu-bloccato) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header::before,
    .site-header,
    .site-header.nascosto,
    .menu,
    .menu-voci a::after,
    .menu-toggle-linee i,
    :global(.site-header .logo-gaia svg) {
      transition: none;
    }
  }
</style>
