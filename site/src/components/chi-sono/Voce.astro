---
/**
 * Chi sono — 2. La sua voce (avorio), split: da una parte una foto grande
 * di Gaia al lavoro, sticky; dall'altra il testo della pagina, sempre
 * pienamente leggibile, con un reveal discreto per paragrafo
 * (data-reveal="alto" di motion.ts, a cascata). Una seconda foto più
 * piccola sta in sovrapposizione sulla grande e scorre a velocità
 * diversa ([data-parallasse]). Il primo paragrafo è in corpo grande, gli
 * altri in lead; chiude la firma «Gaia» in corsivo.
 *
 * Foto: highlight «chi-sono» (la grande è quella dopo l'apertura, la
 * piccola la successiva). Sotto i 64rem: foto grande con la piccola
 * sovrapposta, poi il testo. Senza JS o con reduced-motion: tutto fermo e
 * visibile.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import type { PictureData } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  paragrafi: string[];
  fotoGrande: PictureData | null;
  fotoPiccola: PictureData | null;
}

const { lang, paragrafi, fotoGrande, fotoPiccola } = Astro.props;
const t = useTranslations(lang);
const [primo, ...altri] = paragrafi;
---

{
  primo && (
    <section id="voce" class="voce" data-theme="light">
      <div class="container-gaia voce-griglia">
        {fotoGrande && (
          <div class="voce-foto">
            <div class="voce-sticky">
              <figure class="voce-figura" data-reveal="maschera">
                <Picture data={fotoGrande} cap={false} class="voce-img" />
              </figure>
              {fotoPiccola && (
                <figure class="voce-figura-piccola" data-parallasse="14 -14">
                  <Picture data={fotoPiccola} cap={false} class="voce-img" />
                </figure>
              )}
            </div>
          </div>
        )}

        <div class="voce-testo" data-reveal-gruppo>
          <p class="font-display voce-primo" data-reveal="alto">
            {primo}
          </p>
          {altri.map((p) => (
            <p class="text-lead voce-paragrafo" data-reveal="alto">
              {p}
            </p>
          ))}
          <p class="font-display voce-firma" data-reveal="alto" aria-hidden="true">
            {t('cta.firma')}
          </p>
        </div>
      </div>
    </section>
  )
}

<style>
  .voce {
    padding-block: var(--spacing-section);
  }

  .voce-griglia {
    display: grid;
    gap: clamp(2.5rem, 6vh, 4rem);
  }

  /* — Foto grande 4:5 con la piccola sovrapposta in basso a destra — */
  .voce-sticky {
    position: relative;
  }

  .voce-figura {
    margin: 0;
    overflow: hidden;
    border-radius: 16px;
    aspect-ratio: 4 / 5;
  }

  .voce-figura :global(picture),
  .voce-figura :global(.voce-img),
  .voce-figura-piccola :global(picture),
  .voce-figura-piccola :global(.voce-img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none !important;
    object-fit: cover;
  }

  .voce-figura-piccola {
    position: absolute;
    right: -6%;
    bottom: -10%;
    width: 42%;
    margin: 0;
    overflow: hidden;
    border-radius: 12px;
    aspect-ratio: 3 / 4;
    box-shadow: 0 24px 60px rgb(27 22 17 / 0.22);
  }

  /* — Testo: primo paragrafo grande, gli altri in lead, firma — */
  .voce-testo {
    max-width: 36rem;
  }

  .voce-primo {
    margin: 0 0 1.25rem;
    font-size: clamp(1.625rem, 1.15rem + 1.7vw, 2.5rem);
    line-height: 1.25;
    font-weight: 400;
    text-wrap: pretty;
  }

  .voce-paragrafo {
    margin: 0 0 1.25rem;
    color: var(--color-grigio-caldo);
  }

  .voce-firma {
    margin: 1.5rem 0 0;
    font-size: 2.25rem;
    font-style: italic;
    color: var(--color-bordeaux);
  }

  @media (max-width: 63.98rem) {
    /* Spazio per la foto piccola che sporge sotto. */
    .voce-foto {
      padding-bottom: 10%;
    }
  }

  @media (min-width: 64rem) {
    .voce-griglia {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      gap: clamp(3rem, 7vw, 7rem);
      align-items: start;
    }

    /* La colonna si allunga quanto la riga, così lo sticky ha spazio. */
    .voce-foto {
      align-self: stretch;
      padding-bottom: 8%;
    }

    .voce-sticky {
      position: sticky;
      top: calc(var(--altezza-header, 146px) * 0.7);
    }

    .voce-testo {
      padding-top: clamp(1rem, 6vh, 4rem);
    }
  }
</style>
