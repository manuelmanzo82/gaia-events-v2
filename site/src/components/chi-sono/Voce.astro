---
/**
 * Chi sono — 2. La sua voce (avorio), split: da una parte le foto di
 * Gaia al lavoro, dall'altra il testo della pagina, sempre pienamente
 * leggibile, con un reveal discreto per paragrafo (data-reveal="alto" di
 * motion.ts, a cascata). Il primo paragrafo è in corpo grande, gli altri
 * in lead; sotto, la firma «Gaia» in corsivo.
 *
 * Desktop: i due blocchi hanno la stessa altezza. La colonna delle foto si
 * allunga quanto il testo (grid stretch): la foto grande parte all'altezza
 * della prima riga, la piccola (bordo avorio, ombra morbida) finisce
 * all'altezza dell'ultima riga dell'ultimo paragrafo; text-box-trim toglie
 * la mezza interlinea in cima e in fondo, così i bordi coincidono. La
 * piccola ha una parallasse leggera (±5%), allineata a metà del passaggio.
 *
 * Mobile: foto grande 4:5, la piccola dentro i margini, sovrapposta in
 * basso a destra (sporge di circa il 15%), poi il testo.
 *
 * Foto: highlight «chi-sono» (la grande e la piccola le sceglie
 * AboutPage). Senza JS o con reduced-motion: tutto fermo e visibile.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import type { PictureData } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  paragrafi: string[];
  fotoGrande: PictureData | null;
  fotoPiccola: PictureData | null;
}

const { lang, paragrafi, fotoGrande, fotoPiccola } = Astro.props;
const t = useTranslations(lang);
const [primo, ...altri] = paragrafi;
---

{
  primo && (
    <section id="voce" class="voce" data-theme="light">
      <div class="container-gaia voce-griglia">
        {fotoGrande && (
          <div class:list={['voce-foto', { 'voce-foto--sola': !fotoPiccola }]}>
            <figure class="voce-figura" data-reveal="maschera">
              <Picture data={fotoGrande} cap={false} class="voce-img" />
            </figure>
            {fotoPiccola && (
              <figure class="voce-figura-piccola" data-parallasse="5 -5">
                <Picture data={fotoPiccola} cap={false} class="voce-img" />
              </figure>
            )}
          </div>
        )}

        <div class="voce-testo" data-reveal-gruppo>
          <p class="font-display voce-primo" data-reveal="alto">
            {primo}
          </p>
          {altri.map((p) => (
            <p class="text-lead voce-paragrafo" data-reveal="alto">
              {p}
            </p>
          ))}
        </div>

        <p class="font-display voce-firma" data-reveal="alto" aria-hidden="true">
          {t('cta.firma')}
        </p>
      </div>
    </section>
  )
}

<style>
  .voce {
    padding-block: var(--spacing-section);
  }

  .voce-griglia {
    display: grid;
    gap: clamp(2.5rem, 6vh, 4rem);
  }

  .voce-figura,
  .voce-figura-piccola {
    margin: 0;
    overflow: hidden;
  }

  .voce-figura {
    border-radius: 16px;
  }

  .voce-figura :global(picture),
  .voce-figura :global(.voce-img),
  .voce-figura-piccola :global(picture),
  .voce-figura-piccola :global(.voce-img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none !important;
    object-fit: cover;
  }

  /* La piccola si stacca dalla grande: cornice avorio e ombra morbida. */
  .voce-figura-piccola {
    border: 9px solid var(--color-bianco-caldo);
    border-radius: 14px;
    box-shadow:
      0 2px 6px rgb(27 22 17 / 0.08),
      0 24px 56px rgb(27 22 17 / 0.2);
  }

  .voce-figura-piccola :global(.voce-img) {
    border-radius: 6px;
  }

  /* — Testo — */
  .voce-testo {
    max-width: 36rem;
  }

  .voce-primo {
    margin: 0 0 1.25rem;
    font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.25rem);
    line-height: 1.25;
    font-weight: 400;
    text-wrap: pretty;
  }

  .voce-paragrafo {
    margin: 0 0 1.25rem;
    color: var(--color-grigio-caldo);
  }

  .voce-testo > :last-child {
    margin-bottom: 0;
  }

  .voce-firma {
    margin: 0;
    font-size: 2.25rem;
    font-style: italic;
    color: var(--color-bordeaux);
  }

  /* — Mobile: grande 4:5, piccola dentro i margini in basso a destra — */
  @media (max-width: 63.98rem) {
    .voce-foto {
      position: relative;
      /* Spazio per la parte della piccola che sporge sotto la grande. */
      padding-bottom: 9%;
    }

    .voce-figura {
      aspect-ratio: 4 / 5;
    }

    .voce-figura-piccola {
      position: absolute;
      right: 0.75rem;
      bottom: 0;
      width: 42%;
      aspect-ratio: 3 / 4;
      border-width: 7px;
    }

    .voce-foto--sola {
      padding-bottom: 0;
    }
  }

  /* — Desktop: foto e testo della stessa altezza — */
  @media (min-width: 64rem) {
    .voce-griglia {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'foto testo'
        '. firma';
      column-gap: clamp(3rem, 7vw, 7rem);
      row-gap: 1.75rem;
      align-items: stretch;
    }

    .voce-foto {
      grid-area: foto;
      position: relative;
      min-height: 32rem;
    }

    .voce-testo {
      grid-area: testo;
      align-self: start;
    }

    .voce-firma {
      grid-area: firma;
    }

    /* Prima riga e ultima riga a filo dei bordi delle foto. */
    .voce-primo {
      text-box: trim-start cap alphabetic;
    }

    .voce-testo > :last-child {
      text-box: trim-end cap alphabetic;
    }

    /* La grande occupa la colonna dall'alto, lasciando sotto lo spazio
       in cui la piccola sporge; la piccola finisce in fondo alla colonna. */
    .voce-figura {
      position: absolute;
      inset: 0 14% 16% 0;
    }

    .voce-figura-piccola {
      position: absolute;
      right: 0;
      bottom: 0;
      width: 42%;
      height: 46%;
    }

    .voce-foto--sola .voce-figura {
      inset: 0;
    }
  }
</style>
