---
/**
 * Chi sono — 6. Citazione a tutto schermo (notte): il <blockquote> del
 * testo della pagina sopra la foto about.photos.quote, con parallasse
 * lieve ([data-parallasse]); corpo contenuto (3-4 righe a 1440, fino a 6
 * a 390), non display. Predisposta per la stampa: se arriva una voce
 * Stampa con estratto in questa lingua, mostra quella con testata e link
 * al posto della citazione di Gaia.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import type { PictureData } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  citazione: string;
  foto: PictureData | null;
  /** Voce di stampa, se c'è: ha la precedenza sulla citazione. */
  stampa?: { estratto: string; testata: string; url: string | null } | null;
}

const { lang, citazione, foto, stampa = null } = Astro.props;
const t = useTranslations(lang);
const testo = stampa?.estratto || citazione;
---

{
  testo && (
    <section class="citazione" data-theme="dark" data-foto={foto ? '' : undefined}>
      {foto && (
        <figure class="citazione-foto" aria-hidden="true" data-parallasse="-8 8">
          <Picture data={foto} cap={false} class="citazione-img" />
        </figure>
      )}
      <div class="citazione-velo" aria-hidden="true"></div>
      <blockquote class="citazione-testo container-gaia">
        <p class="font-display citazione-frase" data-reveal="righe">
          «{testo}»
        </p>
        <footer class="citazione-fonte" data-reveal="alto">
          {stampa ? (
            stampa.url ? (
              <a href={stampa.url} rel="noopener" target="_blank">
                {stampa.testata}
              </a>
            ) : (
              stampa.testata
            )
          ) : (
            <span class="font-display citazione-firma">{t('cta.firma')}</span>
          )}
        </footer>
      </blockquote>
    </section>
  )
}

<style>
  .citazione {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 90vh;
    min-height: 90svh;
    padding-block: var(--spacing-section);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-notte);
    color: var(--color-avorio-su-notte);
    text-align: center;
  }

  .citazione-foto {
    position: absolute;
    inset: -10% 0;
    z-index: 0;
    margin: 0;
  }

  .citazione-foto :global(picture),
  .citazione-foto :global(.citazione-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .citazione-velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.5) 0%, rgb(0 0 0 / 0.25) 160px, rgb(0 0 0 / 0) 320px),
      rgb(27 22 17 / 0.5);
  }

  .citazione-testo {
    position: relative;
    z-index: 2;
    margin: 0;
  }

  .citazione-frase {
    max-width: 44ch;
    margin: 0 auto;
    font-size: clamp(1.5rem, 1.15rem + 1.4vw, 2.25rem);
    line-height: 1.3;
    font-weight: 400;
    text-wrap: balance;
  }

  .citazione-fonte {
    margin-top: 1.5rem;
    font-size: var(--text-caption);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-velato-su-notte);
  }

  .citazione-fonte a {
    color: inherit;
  }

  .citazione-firma {
    font-size: 2rem;
    font-style: italic;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-oro);
  }
</style>
