---
/**
 * Chi sono — 5. I valori (avorio): quattro fasce a tutta larghezza
 * impilate. La fascia aperta mostra, a sinistra, numero, titolo e testo
 * e, a destra, la foto in una finestra 3:2 con gli angoli arrotondati
 * (circa il 45% della larghezza); le fasce chiuse sono strisce con numero
 * e titolo su fondo beige, senza foto. Nessun link.
 *
 * `stile="piena"` è la variante con la foto a tutta fascia (foto
 * orizzontali di scene, testo sopra): tenuta per confronto.
 *
 * Desktop (≥64rem): sezione agganciata sotto il header, la fascia attiva
 * segue lo scroll e l'hover la apre (chi-sono-effetti.ts, [data-valori]).
 * Mobile: si apre la fascia al centro dello schermo (IntersectionObserver
 * qui sotto). Stesse curve e durate delle card della home (flex-grow
 * 0,7 s, dettaglio 0,6 s, foto 1,2 s, ease-gaia), angoli a 4 px.
 * Reduced-motion: tutte aperte uguali, nessuna transizione.
 */
import type { Lang } from '../../config/site';
import type { Image } from '../../lib/types';
import { picture } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  titolo: string;
  valori: Array<{ titolo: string; testo: string; image: Image | null }>;
  stile?: 'finestra' | 'piena';
}

const { lang, titolo, valori, stile = 'finestra' } = Astro.props;
---

{
  valori.length > 0 && (
    <section
      class:list={['valori', `valori--${stile}`]}
      data-theme="light"
      data-valori
      aria-labelledby="valori-titolo"
    >
      <div class="valori-testa container-gaia">
        <h2 id="valori-titolo" class="eyebrow" data-reveal="alto">
          {titolo}
        </h2>
      </div>
      <ol class="fasce" role="list">
        {valori.map((v, i) => {
          const foto = picture(v.image, lang, stile === 'piena' ? '100vw' : '(min-width: 64rem) 45vw, 92vw');
          return (
            <li class:list={['fascia', { attiva: i === 0 }]} data-fascia={i}>
              <div class="fascia-interno">
                <div class="fascia-testo">
                  <span class="fascia-numero numero" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="font-display fascia-titolo">{v.titolo}</h3>
                  {v.testo && (
                    <div class="fascia-dettaglio">
                      <p class="fascia-riga">{v.testo}</p>
                    </div>
                  )}
                </div>
                {foto && (
                  <figure class="fascia-foto" data-theme="dark" data-foto>
                    <Picture data={foto} cap={false} class="fascia-img" />
                    {stile === 'piena' && <span class="fascia-velo" aria-hidden="true" />}
                  </figure>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    </section>
  )
}

<script>
  // Mobile: la fascia che passa il centro dello schermo si apre.
  const mobile = window.matchMedia('(max-width: 63.98rem)');
  if (mobile.matches && 'IntersectionObserver' in window) {
    for (const sezione of document.querySelectorAll<HTMLElement>('[data-valori]')) {
      const fasce = [...sezione.querySelectorAll<HTMLElement>('.fascia')];
      const io = new IntersectionObserver(
        (voci) => {
          for (const voce of voci) {
            if (!voce.isIntersecting) continue;
            const i = Number((voce.target as HTMLElement).dataset.fascia ?? 0);
            fasce.forEach((f, k) => f.classList.toggle('attiva', k === i));
          }
        },
        { rootMargin: '-40% 0px -40% 0px', threshold: 0 },
      );
      for (const f of fasce) io.observe(f);
    }
  }
</script>

<style>
  .valori {
    padding-block: var(--spacing-section-sm) var(--spacing-section);
  }

  .valori-testa {
    margin-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }

  .valori-testa .eyebrow {
    margin: 0;
  }

  .fasce {
    display: grid;
    gap: 0.75rem;
    width: calc(100% - 2 * clamp(1.25rem, 4vw, 3.5rem));
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  /* — Fascia: chiusa è una striscia beige con numero e titolo — */
  .fascia-interno {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    height: 4.5rem;
    padding: 0 clamp(1.25rem, 2.5vw, 2.25rem);
    overflow: hidden;
    border-radius: 4px;
    background: var(--color-beige);
    color: var(--color-inchiostro);
    transition:
      height 0.7s var(--ease-gaia),
      background-color 0.5s var(--ease-gaia);
  }

  .fascia-testo {
    display: grid;
    align-content: center;
    gap: 0.35rem;
    min-height: 4.5rem;
  }

  .fascia-numero {
    margin: 0;
  }

  .fascia-titolo {
    margin: 0;
    font-size: var(--text-title);
    font-weight: 320;
    line-height: 1.05;
    letter-spacing: -0.01em;
    transition: font-size 0.6s var(--ease-gaia);
  }

  .fascia-dettaglio {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.6s var(--ease-gaia),
      opacity 0.45s var(--ease-gaia);
  }

  .fascia-dettaglio > * {
    min-height: 0;
  }

  .fascia-riga {
    max-width: 30rem;
    margin: 0.4rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-grigio-caldo);
  }

  /* Foto: finestra 3:2 con gli angoli arrotondati. */
  .fascia-foto {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 12px;
    aspect-ratio: 3 / 2;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.6s var(--ease-gaia),
      transform 0.8s var(--ease-gaia);
  }

  .fascia-foto :global(picture),
  .fascia-foto :global(.fascia-img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none !important;
    object-fit: cover;
  }

  .fascia-foto :global(.fascia-img) {
    transition: transform 1.2s var(--ease-gaia);
  }

  /* Aperta */
  .fascia.attiva .fascia-interno {
    height: auto;
    padding-block: clamp(1.25rem, 3vh, 2rem);
    background: var(--color-bianco-caldo);
  }

  .fascia.attiva .fascia-titolo {
    font-size: var(--text-display);
  }

  .fascia.attiva .fascia-dettaglio {
    grid-template-rows: 1fr;
    opacity: 1;
    transition-delay: 0.15s;
  }

  .fascia.attiva .fascia-foto {
    opacity: 1;
    transform: none;
    transition-delay: 0.1s;
  }

  .fascia.attiva :global(.fascia-img) {
    transform: scale(1.04);
  }

  /* — Variante «piena»: foto a tutta fascia, testo sopra su velo — */
  .valori--piena .fascia-interno {
    display: block;
    padding: 0;
    background: var(--color-notte);
    color: var(--color-avorio-su-notte);
    isolation: isolate;
  }

  .valori--piena .fascia-foto {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    border-radius: 0;
    opacity: 1;
    transform: none;
  }

  .valori--piena .fascia-velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.5) 0%, rgb(0 0 0 / 0.3) 120px, rgb(0 0 0 / 0) 240px),
      linear-gradient(0deg, rgb(27 22 17 / 0.8) 0%, rgb(27 22 17 / 0.4) 50%, rgb(27 22 17 / 0.15) 100%);
  }

  .valori--piena .fascia:not(.attiva) .fascia-velo {
    background: rgb(27 22 17 / 0.72);
  }

  .valori--piena .fascia-testo {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: 0 clamp(1.25rem, 2.5vw, 2.25rem) clamp(1.1rem, 3vh, 2rem);
  }

  .valori--piena .fascia-riga {
    color: inherit;
    opacity: 0.92;
  }

  .valori--piena .fascia.attiva .fascia-interno {
    height: min(70vh, 28rem);
    background: var(--color-notte);
  }

  /* — Desktop: sezione agganciata sotto il header, le fasce si spartiscono
     l'altezza; aperta = testo a sinistra, foto a destra (45%) — */
  @media (min-width: 64rem) {
    .valori {
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: calc(100svh - var(--altezza-header, 146px));
      min-height: 36rem;
      padding-block: 1.5rem 2rem;
    }

    .fasce {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      min-height: 0;
      gap: 0.75rem;
    }

    .fascia {
      flex: 1 1 0;
      min-height: 0;
      transition: flex-grow 0.7s var(--ease-gaia);
    }

    .fascia-interno,
    .fascia.attiva .fascia-interno {
      height: 100%;
      padding-block: 0;
      transition: background-color 0.5s var(--ease-gaia);
    }

    .fascia.attiva {
      flex-grow: 3.4;
    }

    .fascia.attiva .fascia-interno {
      grid-template-columns: minmax(0, 1fr) 45%;
      align-items: center;
      column-gap: clamp(2rem, 4vw, 4rem);
      padding-block: 1.25rem;
    }

    .fascia-interno {
      grid-template-columns: minmax(0, 1fr) 45%;
    }

    .fascia:not(.attiva) .fascia-foto {
      display: none;
    }

    /* La finestra non supera l'altezza della fascia aperta. */
    .fascia-foto {
      width: 100%;
      max-height: 100%;
      aspect-ratio: 3 / 2;
      justify-self: end;
    }

    .fascia-riga {
      max-width: 36rem;
    }

    .valori--piena .fascia-interno {
      display: block;
    }

    .valori--piena .fascia:not(.attiva) .fascia-foto {
      display: block;
    }

    .valori--piena .fascia.attiva .fascia-interno {
      height: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fascia,
    .fascia-interno,
    .fascia-dettaglio,
    .fascia-titolo,
    .fascia-foto,
    .fascia-foto :global(.fascia-img) {
      transition: none;
    }

    /* Tutte aperte uguali, senza animazione. */
    .fascia-interno,
    .fascia.attiva .fascia-interno {
      height: auto;
      padding-block: clamp(1.25rem, 3vh, 2rem);
      background: var(--color-bianco-caldo);
    }

    .fascia-dettaglio,
    .fascia.attiva .fascia-dettaglio {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    .fascia-foto,
    .fascia.attiva .fascia-foto {
      opacity: 1;
      transform: none;
    }

    .fascia.attiva :global(.fascia-img) {
      transform: none;
    }

    @media (min-width: 64rem) {
      .valori {
        height: auto;
        padding-top: var(--spacing-section-sm);
      }

      .fascia,
      .fascia.attiva {
        flex: 0 0 auto;
      }

      .fascia-interno,
      .fascia.attiva .fascia-interno {
        grid-template-columns: minmax(0, 1fr) 45%;
        align-items: center;
        column-gap: clamp(2rem, 4vw, 4rem);
        height: auto;
        padding-block: 1.25rem;
      }

      .fascia:not(.attiva) .fascia-foto {
        display: block;
      }
    }
  }
</style>
