---
/**
 * Chi sono — 5. I valori come schede impilate: stesso componente e stesso
 * movimento del menu visivo della home (SchedeImpilate.astro, scrub in
 * scripts/schede-impilate.ts). Ogni scheda è sticky sotto il header, la
 * successiva sale e si sovrappone alla precedente, che si rimpicciolisce
 * e si scurisce. Desktop: variante «divisa», numero, titolo e testo a
 * sinistra su beige e la foto a destra (55%); mobile identico alla home
 * (foto piena 4:5, velo, testo in basso). Nessun link. Reduced-motion:
 * schede una sotto l'altra, ferme.
 *
 * Foto: una per valore, dal JSON del blocco «values» (scene e dettagli,
 * nessun ritratto né ospite riconoscibile). A 1920 la foto è larga ~994
 * px: tutte quelle scelte hanno maxWidth ≥ 1181.
 */
import type { Lang } from '../../config/site';
import { picture } from '../../lib/images';
import type { Image } from '../../lib/types';
import SchedeImpilate, { type Scheda } from '../SchedeImpilate.astro';

interface Props {
  lang: Lang;
  titolo: string;
  valori: Array<{ titolo: string; testo: string; image: Image | null }>;
}

const { lang, titolo, valori } = Astro.props;

const schede: Scheda[] = valori
  .map((v, i) => {
    const foto = picture(v.image, lang, '(min-width: 64rem) 52vw, 92vw');
    if (!foto) return null;
    return { titolo: v.titolo, riga: v.testo, numero: String(i + 1).padStart(2, '0'), foto };
  })
  .filter((s): s is NonNullable<typeof s> => s !== null);
---

<SchedeImpilate id="valori" schede={schede} eyebrow={titolo} variante="divisa" />
