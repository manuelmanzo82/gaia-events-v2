---
/**
 * Chi sono — 4. Timeline (notte): le tappe del blocco «timeline» della
 * pagina (anno, titolo, riga, foto per voce).
 *
 * Desktop (≥64rem): sezione alta uno schermo, agganciata; lo scroll
 * verticale fa scorrere il .binario in orizzontale (chi-sono-effetti.ts,
 * [data-timeline]); un filetto oro si disegna con lo scroll
 * (.percorso-filo-pieno), l'anno della tappa al centro è pieno, gli altri
 * in contorno; ogni foto ha una parallasse leggera dentro la sua cornice.
 *
 * Mobile: tappe impilate, linea verticale a sinistra che si riempie con
 * lo scroll, niente pin.
 *
 * Senza JS o con reduced-motion: filetto pieno, anni pieni, foto ferme;
 * su desktop il binario scorre a mano (overflow).
 */
import type { Lang } from '../../config/site';
import type { Image } from '../../lib/types';
import { picture } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
  titolo: string;
  tappe: Array<{ anno: string; titolo: string; testo: string; image: Image | null }>;
}

const { lang, titolo, tappe } = Astro.props;
---

{
  tappe.length > 0 && (
    <section class="percorso" data-theme="dark" data-timeline aria-labelledby="percorso-titolo">
      <div class="percorso-interno">
        <h2 id="percorso-titolo" class="eyebrow percorso-eyebrow" data-reveal="alto">
          {titolo}
        </h2>
        <div class="percorso-corpo">
          <div class="percorso-filo" aria-hidden="true">
            <span class="percorso-filo-pieno" />
          </div>
          <ol class="binario percorso-binario" role="list">
            {tappe.map((t, i) => {
              // Misura reale resa: la cornice è min(40vw, 62svh) e la foto è
              // ingrandita ×1,22 per la parallasse (su mobile la cornice è
              // ~80vw, quindi ~100vw).
              const foto = picture(t.image, lang, '(min-width: 64rem) min(49vw, 76vh), 100vw');
              return (
                <li class:list={['tappa', { attiva: i === 0 }]} data-tappa={i}>
                  <p class="font-display tappa-anno" aria-hidden="true">
                    {t.anno}
                  </p>
                  <span class="tappa-punto" aria-hidden="true" />
                  {foto && (
                    <figure class="tappa-foto">
                      <Picture data={foto} class="tappa-img" />
                    </figure>
                  )}
                  <div class="tappa-corpo">
                    <h3 class="font-display tappa-titolo">
                      {t.anno && <span class="sr-only">{t.anno}: </span>}
                      {t.titolo}
                    </h3>
                    {t.testo && <p class="tappa-testo">{t.testo}</p>}
                  </div>
                </li>
              );
            })}
          </ol>
        </div>
      </div>
    </section>
  )
}

<style>
  .percorso {
    --bordo: clamp(1.25rem, 4vw, 3.5rem);
    padding-block: var(--spacing-section-sm);
    overflow: hidden;
  }

  .percorso-eyebrow {
    margin: 0 var(--bordo) clamp(1.5rem, 4vh, 2.5rem);
  }

  /* — Mobile: colonna con la linea a sinistra — */
  .percorso-corpo {
    position: relative;
    padding-left: calc(var(--bordo) + 1.5rem);
    padding-right: var(--bordo);
  }

  .percorso-filo {
    position: absolute;
    top: 0.75rem;
    bottom: 0.75rem;
    left: var(--bordo);
    width: 1px;
    background: color-mix(in srgb, var(--color-oro) 25%, transparent);
  }

  .percorso-filo-pieno {
    position: absolute;
    inset: 0;
    background: var(--color-oro);
    transform: scaleY(0);
    transform-origin: top;
  }

  .percorso-binario {
    display: grid;
    gap: clamp(2.5rem, 7vh, 4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tappa {
    position: relative;
  }

  .tappa-punto {
    position: absolute;
    top: 0.75rem;
    left: -1.5rem;
    width: 9px;
    height: 9px;
    margin-left: -4px;
    border-radius: 50%;
    background: var(--color-notte);
    border: 1px solid var(--color-oro);
    transition: background-color 0.5s var(--ease-gaia);
  }

  .tappa.attiva .tappa-punto {
    background: var(--color-oro);
  }

  /* Anno: pieno sulla tappa attiva; sulle altre oro al 18% con un
     contorno di 1,5 px (il solo filo da 1 px a quella misura, su fondo
     scuro, si leggeva male e sembrava spezzato). */
  .tappa-anno {
    margin: 0 0 0.75rem;
    font-size: clamp(3.5rem, 2.5rem + 5vw, 7rem);
    line-height: 0.95;
    font-weight: 300;
    font-variant-numeric: lining-nums;
    color: color-mix(in srgb, var(--color-oro) 18%, transparent);
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--color-oro) 45%, transparent);
    transition:
      color 0.6s var(--ease-gaia),
      -webkit-text-stroke-color 0.6s var(--ease-gaia);
  }

  .tappa.attiva .tappa-anno {
    color: var(--color-oro);
    -webkit-text-stroke-color: var(--color-oro);
  }

  .tappa-foto {
    position: relative;
    margin: 0 0 1.25rem;
    overflow: hidden;
    border-radius: 12px;
    aspect-ratio: 4 / 5;
  }

  .tappa-foto :global(picture),
  .tappa-foto :global(.tappa-img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none !important;
    object-fit: cover;
  }

  /* La foto è più grande della cornice: così la parallasse (±10% su
     desktop) non scopre mai il fondo. */
  .tappa-foto :global(.tappa-img) {
    transform: scale(1.22);
  }

  .tappa-titolo {
    margin: 0;
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    font-weight: 400;
  }

  .tappa-testo {
    max-width: 30rem;
    margin: 0.6rem 0 0;
    color: var(--color-velato-su-notte);
  }

  /* — Desktop: uno schermo, striscia orizzontale, filetto che si disegna — */
  @media (min-width: 64rem) {
    /* Agganciata in cima: il header fisso sta sopra, quindi il contenuto
       si centra nello spazio sotto di lui. */
    .percorso {
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: 100svh;
      min-height: 40rem;
      padding-block: var(--altezza-header, 146px) 0;
    }

    .percorso-eyebrow {
      margin-bottom: clamp(1.25rem, 3vh, 2rem);
    }

    .percorso-corpo {
      padding: 0;
    }

    /* Tappe da 56vw: a schermo se ne vede una e mezza e il binario è
       lungo circa 2,5 schermi, quindi con lo scroll la prima esce a
       sinistra e l'ultima entra da destra. */
    .percorso-binario {
      display: flex;
      align-items: flex-start;
      gap: 4vw;
      width: max-content;
      padding: 0 var(--bordo);
      padding-right: 18vw;
    }

    /* La foto è 40vw, ma sugli schermi bassi (es. 1280×720) si limita in
       altezza (3:2 → 62svh di larghezza) così la tappa sta nello schermo. */
    .tappa {
      --foto: min(40vw, 62svh);
      display: grid;
      grid-template-columns: var(--foto) minmax(0, 1fr);
      grid-template-areas:
        'anno anno'
        'foto testo';
      column-gap: 2vw;
      align-items: end;
      width: 56vw;
      padding-top: 1.25rem;
    }

    .tappa-anno {
      grid-area: anno;
    }

    .tappa-foto {
      grid-area: foto;
      margin: 0;
    }

    /* Titolo e testo in una cella sola, in basso accanto alla foto. */
    .tappa-corpo {
      grid-area: testo;
      align-self: end;
    }

    .tappa-testo {
      max-width: none;
    }

    /* Il filetto corre sotto gli anni, lungo tutto il binario: è figlio
       del corpo ma segue il binario perché lo script lo sposta insieme. */
    .percorso-filo {
      top: auto;
      bottom: auto;
      left: 0;
      width: 100%;
      height: 1px;
      inset-block-start: 0;
    }

    .percorso-filo-pieno {
      transform: scaleX(0);
      transform-origin: left;
    }

    .tappa-punto {
      top: -5px;
      left: 0;
      margin-left: 0;
    }

    /* Anno enorme (16vw), la foto gli passa sotto la base. */
    .tappa-anno {
      font-size: 16vw;
      line-height: 0.85;
      margin-bottom: -0.12em;
      position: relative;
      z-index: 1;
    }

    .tappa-foto {
      aspect-ratio: 3 / 2;
      border-radius: 16px;
    }

    /* Senza pin (JS spento o reduced-motion) la striscia scorre a mano. */
    :global(html:not(.motion-attivo)) .percorso-corpo {
      overflow-x: auto;
      scroll-snap-type: x proximity;
    }
  }

  /* — Statico e leggibile con reduced-motion — */
  @media (prefers-reduced-motion: reduce) {
    .percorso-filo-pieno {
      transform: none;
    }

    .tappa-anno {
      color: var(--color-oro);
      -webkit-text-stroke-color: var(--color-oro);
      transition: none;
    }

    .tappa-foto :global(.tappa-img) {
      transform: none;
    }
  }
</style>
