---
/**
 * Chi sono — 8. Due card grandi affiancate (rif. sarahhaywood.com/about,
 * WEDDINGS / PARTIES): «I miei eventi» e «Servizi», foto piena con angoli
 * arrotondati, titolo grande in Cormorant sovrapposto in basso; al
 * passaggio un leggero zoom della foto e il velo che si attenua; entrata
 * in scroll sfalsata (data-reveal-gruppo di motion.ts). Su mobile una
 * sopra l'altra. Una card sola (es. senza eventi nella lingua) va a tutta
 * larghezza.
 */
import type { PictureData } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  link: Array<{ href: string; etichetta: string; foto: PictureData | null }>;
}

const { link } = Astro.props;
---

{
  link.length > 0 && (
    <section class="link-grandi" data-theme="light">
      <ul class:list={['container-gaia', 'carte', { 'carte--una': link.length === 1 }]} role="list" data-reveal-gruppo>
        {link.map((l) => (
          <li class="carta-voce" data-reveal="alto">
            <a href={l.href} class="carta" data-theme="dark" data-foto>
              {l.foto && <Picture data={l.foto} cap={false} class="carta-img" />}
              <span class="carta-velo" aria-hidden="true" />
              <span class="font-display carta-titolo">{l.etichetta}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .link-grandi {
    padding-block: var(--spacing-section);
  }

  .carte {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding-block: 0;
    list-style: none;
  }

  .carta {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 16px;
    background: var(--color-notte);
    color: var(--color-avorio-su-notte);
    text-decoration: none;
    isolation: isolate;
  }

  .carta:focus-visible {
    outline: 2px solid var(--color-bordeaux);
    outline-offset: 4px;
  }

  .carta :global(picture),
  .carta :global(.carta-img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none !important;
    object-fit: cover;
  }

  .carta :global(.carta-img) {
    transition: transform 1.2s var(--ease-gaia);
  }

  .carta-velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.45) 0%, rgb(0 0 0 / 0.25) 120px, rgb(0 0 0 / 0) 240px),
      linear-gradient(0deg, rgb(27 22 17 / 0.75) 0%, rgb(27 22 17 / 0.3) 45%, rgb(27 22 17 / 0.1) 100%);
    transition: opacity 0.6s var(--ease-gaia);
  }

  .carta-titolo {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: 0 clamp(1.25rem, 2.5vw, 2.25rem) clamp(1.25rem, 3vh, 2.25rem);
    font-size: var(--text-display);
    font-weight: 320;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .carta:hover :global(.carta-img),
  .carta:focus-visible :global(.carta-img) {
    transform: scale(1.04);
  }

  .carta:hover .carta-velo,
  .carta:focus-visible .carta-velo {
    opacity: 0.72;
  }

  @media (min-width: 64rem) {
    .carte {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .carta {
      aspect-ratio: 4 / 3;
    }

    .carta-titolo {
      font-size: var(--text-display-xl);
      line-height: 1;
    }

    /* Una card sola: tutta la larghezza, più bassa. */
    .carte--una {
      grid-template-columns: minmax(0, 1fr);
    }

    .carte--una .carta {
      aspect-ratio: 21 / 9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carta :global(.carta-img),
    .carta-velo {
      transition: none;
    }

    .carta:hover :global(.carta-img),
    .carta:focus-visible :global(.carta-img) {
      transform: none;
    }
  }
</style>
