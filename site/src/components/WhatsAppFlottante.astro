---
import { BUSINESS, type Lang } from '../config/site';
import { useTranslations } from '../i18n';

/**
 * WhatsApp flottante: il glifo ufficiale di WhatsApp (fumetto con la
 * cornetta), monocromatico, senza cerchio attorno, in basso a destra.
 *
 * Icona (giro 9): il glifo di WhatsApp A CONTORNO, ridisegnato con lo
 * stesso ingombro del cerchio del torna-su (diametro ~42 px dentro i 44
 * del bottone, 38 dentro i 40 su mobile) e un tratto sottile di 1,25 px
 * non scalato (vector-effect: non-scaling-stroke), come il bordo del
 * cerchio: fumetto con la coda in basso a sinistra e cornetta al centro.
 * SVG quadrato con preserveAspectRatio xMidYMid meet e dimensioni fisse
 * anche in CSS: nessuno stretch, nemmeno mentre la pillola si allarga.
 *
 * Sempre visibile, dal caricamento al footer compreso; con l'intro a velo
 * attiva compare alla fine dell'intro. Il torna-su sta 12 px sopra e
 * compare solo dopo l'hero: il WhatsApp non si sposta mai. Colore come
 * logo e menu (scripts/flottanti.ts): avorio sopra le foto e le sezioni
 * scure, inchiostro sui fondi chiari.
 *
 * Desktop, con un puntatore vero: al passaggio o al focus si allarga in
 * una pillola con il bordo e «Scrivimi su WhatsApp», su un fondo leggero
 * nel colore del tema (avorio o notte velati): aprendosi verso sinistra
 * può finire sopra una foto, e così resta leggibile. Mobile: solo l'icona.
 * Link wa.me al numero di site.ts con il messaggio precompilato. Con
 * prefers-reduced-motion nessuna animazione: compare e basta.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const href = `https://wa.me/${BUSINESS.whatsapp}?text=${encodeURIComponent(t('whatsapp.messaggio'))}`;

---

<a
  class="wa-flottante"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={t('cta.whatsapp')}
  data-tema="light"
  hidden
>
  <span class="wa-icona" aria-hidden="true">
    <svg
      viewBox="0 0 44 44"
      width="44"
      height="44"
      preserveAspectRatio="xMidYMid meet"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      {/* Fumetto: cerchio di raggio 21 centrato, coda verso il basso a sinistra. */}
      <path vector-effect="non-scaling-stroke" d="M3.81 32.5 L2.6 41.4 L13.13 41.03 A21 21 0 1 0 3.81 32.5 Z"></path>
      {/* Cornetta, al centro del fumetto. */}
      <path
        vector-effect="non-scaling-stroke"
        transform="translate(11.6 11.4) scale(0.88)"
        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
      ></path>
    </svg>
  </span>
  <span class="wa-testo" aria-hidden="true">{t('cta.whatsapp')}</span>
</a>

<script>
  import { initFlottante } from '../scripts/flottanti';

  const bottone = document.querySelector<HTMLElement>('.wa-flottante');
  // Il colore si misura sotto l'icona, che resta ferma mentre la pillola
  // si allarga verso sinistra.
  if (bottone) initFlottante(bottone, { dopoIntro: true });
</script>

<style>
  .wa-flottante {
    position: fixed;
    /* Stesso margine del header: i flottanti cadono dentro le schede e i
       pannelli, mai a cavallo del loro bordo. */
    right: clamp(1.25rem, 4vw, 3.5rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 40;
    display: grid;
    grid-template-columns: 44px 0fr;
    align-items: center;
    height: 44px;
    border-radius: 999px;
    background: transparent;
    /* Il bordo della pillola è un'ombra interna: non cambia la scatola,
       quindi l'icona resta 44 × 44 a riposo e da aperta. */
    box-shadow: inset 0 0 0 1px transparent;
    color: var(--color-inchiostro);
    text-decoration: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s var(--ease-gaia),
      color 0.5s var(--ease-gaia),
      background-color 0.5s var(--ease-gaia),
      box-shadow 0.5s var(--ease-gaia),
      grid-template-columns 0.5s var(--ease-gaia),
      padding 0.5s var(--ease-gaia),
      visibility 0s linear 0.45s;
  }

  .wa-flottante.visibile {
    opacity: 0.9;
    visibility: visible;
    transition-delay: 0s;
  }

  .wa-flottante.visibile:hover,
  .wa-flottante.visibile:focus-visible {
    opacity: 1;
  }

  .wa-flottante:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .wa-flottante[data-tema='dark'] {
    color: var(--color-avorio-su-notte);
    filter: drop-shadow(0 1px 2px rgb(27 22 17 / 0.35)) drop-shadow(0 0 10px rgb(27 22 17 / 0.25));
  }

  .wa-icona {
    display: block;
    flex: none;
    width: 44px;
    height: 44px;
  }

  .wa-icona svg {
    display: block;
    flex: none;
    width: 44px;
    height: 44px;
    max-width: none;
  }

  .wa-testo {
    min-width: 0;
    overflow: hidden;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.35s var(--ease-gaia);
  }

  /* Desktop con puntatore: pillola con il testo al passaggio o al focus;
     la colonna dell'icona resta fissa a 44 px. */
  @media (hover: hover) and (min-width: 64rem) {
    .wa-flottante:hover,
    .wa-flottante:focus-visible {
      grid-template-columns: 44px 1fr;
      padding-right: 1.1rem;
      background: rgb(250 248 243 / 0.92);
      box-shadow: inset 0 0 0 1px currentColor;
    }

    .wa-flottante[data-tema='dark']:hover,
    .wa-flottante[data-tema='dark']:focus-visible {
      background: rgb(27 22 17 / 0.55);
    }

    .wa-flottante:hover .wa-testo,
    .wa-flottante:focus-visible .wa-testo {
      opacity: 1;
      transition-delay: 0.15s;
    }
  }

  /* Mobile: 40 px come il torna-su (glifo ~35 px, stessa proporzione),
     stessi 16 px dal bordo: i due centri sono sulla stessa verticale. */
  @media (max-width: 63.98rem) {
    .wa-flottante {
      right: 1rem;
      bottom: 1rem;
      grid-template-columns: 40px 0fr;
      height: 40px;
    }

    .wa-icona,
    .wa-icona svg {
      width: 40px;
      height: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-flottante,
    .wa-testo {
      transition: none;
    }
  }
</style>
