---
import { BUSINESS, type Lang } from '../config/site';
import { useTranslations } from '../i18n';

/**
 * WhatsApp flottante: il glifo ufficiale di WhatsApp (fumetto con la
 * cornetta), monocromatico, senza cerchio attorno, in basso a destra.
 *
 * Icona: SVG quadrato 44 × 44 con preserveAspectRatio="xMidYMid meet" e
 * il viewBox allargato attorno al glifo da 24 unità, così il glifo misura
 * 39 px al centro del quadrato: la stessa grandezza visiva del cerchio
 * del torna-su, con il centro sulla stessa verticale. Dimensioni fisse anche in CSS (flex:
 * none, niente max-width): nessuno stretch, nemmeno mentre la pillola si
 * allarga. Il glifo ufficiale è una forma piena (l'anello del fumetto e la
 * cornetta): non ha tratti, quindi non c'è stroke da scalare.
 *
 * Sempre visibile, dal caricamento al footer compreso; con l'intro a velo
 * attiva compare alla fine dell'intro. Il torna-su sta 12 px sopra e
 * compare solo dopo l'hero: il WhatsApp non si sposta mai. Colore come
 * logo e menu (scripts/flottanti.ts): avorio sopra le foto e le sezioni
 * scure, inchiostro sui fondi chiari.
 *
 * Desktop, con un puntatore vero: al passaggio o al focus si allarga in
 * una pillola con il bordo e «Scrivimi su WhatsApp», su un fondo leggero
 * nel colore del tema (avorio o notte velati): aprendosi verso sinistra
 * può finire sopra una foto, e così resta leggibile. Mobile: solo l'icona.
 * Link wa.me al numero di site.ts con il messaggio precompilato. Con
 * prefers-reduced-motion nessuna animazione: compare e basta.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const href = `https://wa.me/${BUSINESS.whatsapp}?text=${encodeURIComponent(t('whatsapp.messaggio'))}`;

// Glifo da 24 unità reso a 39 px in un quadrato da 44 (come il cerchio
// del torna-su): viewBox di 24 × 44 / 39 unità, centrato.
const LATO = (24 * 44) / 39;
const MARGINE = (LATO - 24) / 2;
const viewBox = `${-MARGINE} ${-MARGINE} ${LATO} ${LATO}`;
---

<a
  class="wa-flottante"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={t('cta.whatsapp')}
  data-tema="light"
  hidden
>
  <span class="wa-icona" aria-hidden="true">
    <svg
      viewBox={viewBox}
      width="44"
      height="44"
      preserveAspectRatio="xMidYMid meet"
      fill="currentColor"
    >
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
      ></path>
    </svg>
  </span>
  <span class="wa-testo" aria-hidden="true">{t('cta.whatsapp')}</span>
</a>

<script>
  import { initFlottante } from '../scripts/flottanti';

  const bottone = document.querySelector<HTMLElement>('.wa-flottante');
  // Il colore si misura sotto l'icona, che resta ferma mentre la pillola
  // si allarga verso sinistra.
  if (bottone) initFlottante(bottone, { dopoIntro: true, punto: bottone.querySelector<HTMLElement>('.wa-icona') });
</script>

<style>
  .wa-flottante {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 40;
    display: grid;
    grid-template-columns: 44px 0fr;
    align-items: center;
    height: 44px;
    border-radius: 999px;
    background: transparent;
    /* Il bordo della pillola è un'ombra interna: non cambia la scatola,
       quindi l'icona resta 44 × 44 a riposo e da aperta. */
    box-shadow: inset 0 0 0 1px transparent;
    color: var(--color-inchiostro);
    text-decoration: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s var(--ease-gaia),
      color 0.5s var(--ease-gaia),
      background-color 0.5s var(--ease-gaia),
      box-shadow 0.5s var(--ease-gaia),
      grid-template-columns 0.5s var(--ease-gaia),
      padding 0.5s var(--ease-gaia),
      visibility 0s linear 0.45s;
  }

  .wa-flottante.visibile {
    opacity: 0.9;
    visibility: visible;
    transition-delay: 0s;
  }

  .wa-flottante.visibile:hover,
  .wa-flottante.visibile:focus-visible {
    opacity: 1;
  }

  .wa-flottante:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .wa-flottante[data-tema='dark'] {
    color: var(--color-avorio-su-notte);
  }

  .wa-icona {
    display: block;
    flex: none;
    width: 44px;
    height: 44px;
  }

  .wa-icona svg {
    display: block;
    flex: none;
    width: 44px;
    height: 44px;
    max-width: none;
  }

  .wa-testo {
    min-width: 0;
    overflow: hidden;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.35s var(--ease-gaia);
  }

  /* Desktop con puntatore: pillola con il testo al passaggio o al focus;
     la colonna dell'icona resta fissa a 44 px. */
  @media (hover: hover) and (min-width: 64rem) {
    .wa-flottante:hover,
    .wa-flottante:focus-visible {
      grid-template-columns: 44px 1fr;
      padding-right: 1.1rem;
      background: rgb(250 248 243 / 0.92);
      box-shadow: inset 0 0 0 1px currentColor;
    }

    .wa-flottante[data-tema='dark']:hover,
    .wa-flottante[data-tema='dark']:focus-visible {
      background: rgb(27 22 17 / 0.55);
    }

    .wa-flottante:hover .wa-testo,
    .wa-flottante:focus-visible .wa-testo {
      opacity: 1;
      transition-delay: 0.15s;
    }
  }

  /* Mobile: 40 px come il torna-su (glifo ~35 px, stessa proporzione),
     stessi 16 px dal bordo: i due centri sono sulla stessa verticale. */
  @media (max-width: 63.98rem) {
    .wa-flottante {
      right: 1rem;
      bottom: 1rem;
      grid-template-columns: 40px 0fr;
      height: 40px;
    }

    .wa-icona,
    .wa-icona svg {
      width: 40px;
      height: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-flottante,
    .wa-testo {
      transition: none;
    }
  }
</style>
