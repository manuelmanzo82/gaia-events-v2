---
import type { Lang } from '../config/site';
import { useTranslations } from '../i18n';

/**
 * Torna su: cerchio sottile con una freccia, in basso a destra, SOPRA il
 * WhatsApp flottante (gap 12 px), che invece è sempre visibile: la
 * freccia compare dopo una schermata di scroll, sparisce sul footer e
 * porta in cima con lo scroll morbido di Lenis (o con quello nativo se
 * Lenis non c'è). Comparsa, footer e colore (avorio sopra le foto,
 * inchiostro sui fondi chiari) in scripts/flottanti.ts.
 * Con prefers-reduced-motion niente animazione di comparsa né di scroll.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<button type="button" class="torna-su" aria-label={t('nav.backToTop')} data-tema="light" hidden>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 19V5" />
    <path d="M6 11l6-6 6 6" />
  </svg>
</button>

<script>
  import { initFlottante } from '../scripts/flottanti';
  import { getLenis, riduciMotion } from '../scripts/motion';

  const bottone = document.querySelector<HTMLButtonElement>('.torna-su');

  if (bottone) {
    initFlottante(bottone, { dopoHero: true, viaSulFooter: true, dopoIntro: true });

    bottone.addEventListener('click', () => {
      const lenis = getLenis();
      if (lenis && !riduciMotion()) {
        lenis.scrollTo(0, { duration: 1.4 });
      } else {
        window.scrollTo({ top: 0, behavior: riduciMotion() ? 'auto' : 'smooth' });
      }
    });
  }
</script>

<style>
  .torna-su {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: calc(clamp(1rem, 3vw, 2rem) + 44px + 12px);
    z-index: 40;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: transparent;
    color: var(--color-inchiostro);
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px);
    visibility: hidden;
    transition:
      opacity 0.45s var(--ease-gaia),
      transform 0.45s var(--ease-gaia),
      color 0.5s var(--ease-gaia),
      visibility 0s linear 0.45s;
  }

  .torna-su.visibile {
    opacity: 0.8;
    transform: translateY(0);
    visibility: visible;
    transition-delay: 0s;
  }

  .torna-su.coperto {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Mobile: 40 px, 16 px dal bordo, sopra il WhatsApp (44 px + 12). */
  @media (max-width: 63.98rem) {
    .torna-su {
      right: 1rem;
      bottom: calc(1rem + 44px + 12px);
      width: 40px;
      height: 40px;
    }
  }

  .torna-su:hover,
  .torna-su:focus-visible {
    opacity: 1;
  }

  .torna-su[data-tema='dark'] {
    color: var(--color-avorio-su-notte);
  }

  @media (prefers-reduced-motion: reduce) {
    .torna-su {
      transition: none;
      transform: none;
    }
  }
</style>
