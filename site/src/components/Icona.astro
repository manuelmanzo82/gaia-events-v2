---
/**
 * Icone a linea, un solo set per tutto il sito (giro 11): WhatsApp,
 * Instagram, Facebook (e la busta della CTA). Stesso tratto (1.5 px,
 * non scalato), stesso ingombro ottico (19 px su 24 di viewBox) e stessi
 * terminali tondi, ovunque compaiano: menu mobile, header desktop,
 * footer, CTA finale. Il tondo flottante ha il suo SVG a 44 px con lo
 * stesso disegno del fumetto e lo stesso tratto.
 */
interface Props {
  nome: 'whatsapp' | 'instagram' | 'facebook' | 'email';
  dimensione?: number;
  class?: string;
}

const { nome, dimensione = 24, class: classe } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={dimensione}
  height={dimensione}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={classe}
  aria-hidden="true"
>
  {
    nome === 'whatsapp' && (
      <>
        {/* Fumetto: cerchio di raggio 10 con la coda in basso a sinistra
            (stesse proporzioni del tondo flottante); cornetta al centro,
            scalata a metà con tratto doppio così resta 1,5. */}
        <path d="M3.34 17 2.76 21.24 7.77 21.06A10 10 0 1 0 3.34 17Z" />
        <path
          stroke-width="3"
          transform="translate(6 6) scale(0.5)"
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
        />
      </>
    )
  }
  {
    nome === 'instagram' && (
      <>
        <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
        <circle cx="12" cy="12" r="4.4" />
        <circle cx="17.6" cy="6.4" r="1.05" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    nome === 'facebook' && (
      <path d="M14 8.5V6.8c0-.9.5-1.3 1.3-1.3H17V2.5h-2.5C11.7 2.5 10.5 4.3 10.5 7v1.5H8V12h2.5v9.5H14V12h2.6l.4-3.5H14z" />
    )
  }
  {
    nome === 'email' && (
      <>
        <rect x="2.5" y="5" width="19" height="14" rx="2" />
        <path d="M3 6l9 7 9-7" />
      </>
    )
  }
</svg>
