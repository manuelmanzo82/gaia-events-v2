---
/**
 * Logo Gaia Events — SVG PROVVISORIO ricostruito per tracciatura dal PNG
 * ufficiale (D:\GMS\Gaia Events\preventivo\logo.png, 231x152): quando
 * arriva il sorgente vettoriale va sostituito il contenuto del componente.
 *
 * Struttura pensata per l'intro (e per qualunque animazione futura):
 *  - .logo-ghirigoro  ghirigoro calligrafico, fill var(--logo-accento)
 *  - .logo-events     "EVENTS", un path per glifo (.logo-lettera), in ordine
 *  - .logo-firma      "Gaia Crognale", currentColor
 *
 * Con la prop `animabile` l'SVG include anche la maschera del tratto:
 * i path .velo-guida (scheletro del ghirigoro, estratti dalla maschera di
 * tracciatura) animati con stroke-dashoffset "disegnano" il ghirigoro; il
 * rect .velo-copertura chiude la maschera a fine animazione per scoprire
 * eventuali residui. Senza `animabile` niente maschera: zero overhead.
 *
 * Sulle sezioni scure il tema imposta --logo-accento: currentColor e il
 * logo diventa monocromo (come logo-bianco.png della v1).
 * Due modi (giro 8): con `animabile` l'SVG è inline completo, maschera
 * compresa (solo il velo dell'intro); senza, è un <use href="#logo-gaia">
 * che richiama il <symbol> definito una volta per pagina da LogoSimbolo.
 * I tracciati stanno in LogoTracciati.
 *
 * Dimensioni v1: box 231x152, alto 80px mobile / 130px desktop
 * (override con --logo-h / --logo-h-md).
 */
import LogoTracciati from './LogoTracciati.astro';

interface Props {
  class?: string;
  /** Include la maschera del tratto per l'intro animata. */
  animabile?: boolean;
}

const { animabile = false } = Astro.props;
---

<span class:list={['logo-gaia', Astro.props.class]} translate="no">
{
  animabile ? (
    <svg
      aria-hidden="true"
      focusable="false"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 231 152"
      width="231"
      height="152"
    >
  {/* La maschera si applica DOPO lo scale(1/6) del gruppo, quindi il suo
      contenuto vive nello spazio del gruppo (1386x912): le guide, in
      coordinate viewBox, vengono riportate lì con scale(6). */}
  {
    animabile && (
      <mask id="velo-maschera-ghirigoro" maskUnits="userSpaceOnUse" x="0" y="0" width="1386" height="912">
        <g transform="scale(6)">
        <rect class="velo-copertura" width="231" height="152" fill="#fff" opacity="0" />
        {/* linecap butt, non round: con dashoffset pieno il cappuccio
            tondo dipingerebbe comunque un punto sulla coda di ogni guida
            (il dash a lunghezza zero dove il pattern riparte). */}
        <g
          fill="none"
          stroke="#fff"
          stroke-width="11.29"
          stroke-linecap="butt"
          stroke-linejoin="round"
        >
        <path class="velo-guida" d="M 111.2 29.3 L 114.8 30.3 L 122.3 29.7 L 127.2 26.7 L 130.2 22.2 L 131.0 15.5 L 129.7 10.7 L 126.2 6.2 L 122.2 3.8 L 114.2 3.0 L 109.3 4.0 L 105.3 5.8 L 98.8 10.5 L 88.0 22.2 L 80.5 32.7 L 73.2 45.8 L 65.7 65.8 L 62.5 81.7 L 59.8 83.8 L 57.2 81.8 L 55.2 71.5 L 53.2 56.2 L 53.2 42.7 L 50.7 43.7 L 46.8 47.3 L 40.7 51.0 L 34.7 52.8 L 27.5 53.0 L 19.7 50.3 L 15.0 47.0 L 10.8 42.5 L 7.2 35.7 L 6.0 31.2 L 6.0 24.2 L 7.5 19.0 L 10.3 14.0 L 15.3 8.8 L 19.5 6.0 L 26.7 3.3 L 31.5 3.0"/>
        <path class="velo-guida" d="M 59.8 83.8 L 61.7 123.7 L 64.2 125.5 L 66.0 132.0 L 68.0 135.8 L 72.0 140.5 L 76.8 143.5 L 82.7 144.3 L 87.3 143.2 L 91.7 139.3 L 92.8 136.5 L 92.8 134.0 L 91.2 130.0 L 88.5 127.7 L 86.2 126.8"/>
        <path class="velo-guida" d="M 59.8 83.8 L 61.8 123.5 L 59.0 125.8 L 57.0 130.7 L 53.8 134.5 L 49.2 137.2 L 45.7 137.5 L 43.0 137.2 L 40.3 135.8 L 38.3 134.0 L 36.8 131.2 L 37.2 127.3 L 38.0 126.0 L 39.8 124.2 L 42.5 123.0"/>
        <path class="velo-guida" d="M 53.2 42.7 L 56.3 31.5"/>
        </g>
        </g>
      </mask>
    )
  }
      <LogoTracciati animabile />
    </svg>
  ) : (
    <svg
      aria-hidden="true"
      focusable="false"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 231 152"
      width="231"
      height="152"
    >
      <use href="#logo-gaia" />
    </svg>
  )
}
</span>

<style>
  .logo-gaia {
    display: inline-block;
    line-height: 0;
    color: currentColor;
  }

  .logo-gaia svg {
    display: block;
    width: auto;
    height: var(--logo-h, 80px);
  }

  @media (min-width: 48rem) {
    .logo-gaia svg {
      height: var(--logo-h-md, 130px);
    }
  }
</style>
