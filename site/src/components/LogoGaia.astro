---
/**
 * Logo Gaia Events — SVG PROVVISORIO ricostruito per tracciatura dal PNG
 * ufficiale (D:\GMS\Gaia Events\preventivo\logo.png, 231x152): quando
 * arriva il sorgente vettoriale va sostituito il contenuto del componente.
 *
 * Struttura pensata per l'intro (e per qualunque animazione futura):
 *  - .logo-ghirigoro  ghirigoro calligrafico, fill var(--logo-accento)
 *  - .logo-events     "EVENTS", un path per glifo (.logo-lettera), in ordine
 *  - .logo-firma      "Gaia Crognale", currentColor
 *
 * Con la prop `animabile` l'SVG include anche la maschera del tratto:
 * i path .velo-guida (scheletro del ghirigoro, estratti dalla maschera di
 * tracciatura) animati con stroke-dashoffset "disegnano" il ghirigoro; il
 * rect .velo-copertura chiude la maschera a fine animazione per scoprire
 * eventuali residui. Senza `animabile` niente maschera: zero overhead.
 *
 * Sulle sezioni scure il tema imposta --logo-accento: currentColor e il
 * logo diventa monocromo (come logo-bianco.png della v1).
 * Dimensioni v1: box 231x152, alto 80px mobile / 130px desktop
 * (override con --logo-h / --logo-h-md).
 */
interface Props {
  class?: string;
  /** Include la maschera del tratto per l'intro animata. */
  animabile?: boolean;
}

const { animabile = false } = Astro.props;
---

<span class:list={['logo-gaia', Astro.props.class]} translate="no">
<svg
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 231 152"
  width="231"
  height="152"
>
  {/* La maschera si applica DOPO lo scale(1/6) del gruppo, quindi il suo
      contenuto vive nello spazio del gruppo (1386x912): le guide, in
      coordinate viewBox, vengono riportate lì con scale(6). */}
  {
    animabile && (
      <mask id="velo-maschera-ghirigoro" maskUnits="userSpaceOnUse" x="0" y="0" width="1386" height="912">
        <g transform="scale(6)">
        <rect class="velo-copertura" width="231" height="152" fill="#fff" opacity="0" />
        {/* linecap butt, non round: con dashoffset pieno il cappuccio
            tondo dipingerebbe comunque un punto sulla coda di ogni guida
            (il dash a lunghezza zero dove il pattern riparte). */}
        <g
