---
/**
 * Servizi — 9. Ponte verso «Dicono di me»: una citazione forte (la prima
 * recensione in evidenza tradotta in questa lingua), la fila dei loghi
 * della Stampa e il link alla pagina. Esiste solo se la pagina Dicono di
 * me esiste in questa lingua, e mostra solo i blocchi che hanno contenuto.
 */
import type { Lang } from '../../config/site';
import { useTranslations } from '../../i18n';
import { path } from '../../i18n/routes';
import { existsIn } from '../../lib/availability';
import { getPress, getReviews, text } from '../../lib/content';
import { picture } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const pagina = existsIn('reviews', lang);
const recensioni = getReviews().filter((r) => r.active && text(r.text, lang));
const scelta = recensioni.find((r) => r.featured) ?? recensioni[0] ?? null;
const citazione = scelta
  ? { testo: text(scelta.text, lang), autore: scelta.author, evento: text(scelta.eventName, lang) }
  : null;
const loghi = getPress()
  .filter((p) => p.active && p.logo)
  .map((p) => ({ nome: p.outlet, foto: picture(p.logo, lang, '9rem') }))
  .filter((p) => p.foto);
---

{
  pagina && (citazione || loghi.length > 0) && (
    <section class="sv-ponte container-gaia" data-theme="light" aria-labelledby="titolo-ponte">
      <h2 id="titolo-ponte" class="eyebrow sv-ponte-titolo">
        {t('nav.reviews')}
      </h2>

      {citazione && (
        <figure class="sv-ponte-citazione">
          <blockquote class="font-display" data-reveal="righe">
            <p>{citazione.testo}</p>
          </blockquote>
          <figcaption>
            {citazione.autore}
            {citazione.evento && <span> · {citazione.evento}</span>}
          </figcaption>
        </figure>
      )}

      {loghi.length > 0 && (
        <ul class="sv-ponte-loghi" role="list" aria-label={t('reviews.stampa')}>
          {loghi.map((l) => (
            <li>
              <Picture data={l.foto} class="sv-ponte-logo" />
              <span class="sr-only">{l.nome}</span>
            </li>
          ))}
        </ul>
      )}

      <p class="sv-ponte-link">
        <a class="link-filo" href={path('reviews', lang)}>
          {t('servizi.leggiDicono')}
        </a>
      </p>
    </section>
  )
}

<style>
  .sv-ponte {
    padding-block: var(--spacing-section);
    text-align: center;
  }

  .sv-ponte-titolo {
    justify-content: center;
    margin: 0 0 2rem;
  }

  .sv-ponte-citazione {
    max-width: 48rem;
    margin: 0 auto;
  }

  .sv-ponte-citazione blockquote {
    margin: 0;
    font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.3;
    font-style: italic;
    text-wrap: balance;
  }

  .sv-ponte-citazione blockquote p {
    margin: 0;
  }

  .sv-ponte-citazione figcaption {
    margin-top: 1.5rem;
    font-size: var(--text-eyebrow);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-grigio-caldo);
  }

  .sv-ponte-loghi {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    align-items: center;
    justify-content: center;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .sv-ponte-loghi :global(.sv-ponte-logo) {
    display: block;
    width: auto;
    max-width: 9rem;
    max-height: 3rem;
    filter: grayscale(1);
    opacity: 0.75;
  }

  .sv-ponte-link {
    margin: 2.5rem 0 0;
  }
</style>
