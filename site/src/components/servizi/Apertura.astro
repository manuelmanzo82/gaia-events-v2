---
/**
 * Servizi — 1. Apertura (notte, 100svh): foto dell'hero di pagina
 * (page_hero «services»), eyebrow, titolo «Come posso aiutarvi» (H1) e una
 * frase; in basso l'indice dei servizi numerato, con le ancore che usano
 * anche le card della home (#planning, #coordinamento, #design,
 * #destination: lo slug del servizio).
 *
 * Su desktop la foto riempie il viewport e Chrome la esclude dall'LCP;
 * su mobile copre i 68svh alti ed è lei l'LCP: fetchpriority alta qui e
 * nel preload di ServicesPage.
 */
import type { PictureData } from '../../lib/images';
import Picture from '../Picture.astro';

interface Props {
  eyebrow: string;
  titolo: string;
  frase: string;
  foto: PictureData | null;
  indice: Array<{ slug: string; numero: string; titolo: string }>;
}

const { eyebrow, titolo, frase, foto, indice } = Astro.props;
---

<section class="sv-apertura" data-theme="dark" data-foto>
  {
    foto && (
      <figure class="sv-apertura-foto" aria-hidden="true" data-parallasse="0 12">
        <Picture data={foto} cap={false} loading="eager" fetchpriority="high" decoding="async" class="sv-apertura-img" />
      </figure>
    )
  }
  <div class="sv-apertura-velo" aria-hidden="true"></div>

  <div class="sv-apertura-testo container-gaia">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="text-display-xl sv-apertura-titolo">{titolo}</h1>
    {frase && <p class="text-lead sv-apertura-frase">{frase}</p>}

    {
      indice.length > 0 && (
        <nav class="sv-indice" aria-label={eyebrow}>
          <ol role="list">
            {indice.map((v) => (
              <li>
                <a href={`#${v.slug}`}>
                  <span class="sv-indice-numero" aria-hidden="true">
                    {v.numero}
                  </span>
                  <span>{v.titolo}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <slot />
  </div>
</section>

<style>
  .sv-apertura {
    position: relative;
    display: grid;
    align-content: end;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-notte);
    color: var(--color-avorio-su-notte);
  }

  .sv-apertura-foto {
    position: absolute;
    inset: 0 0 -12%;
    z-index: 0;
    margin: 0;
  }

  .sv-apertura-foto :global(picture),
  .sv-apertura-foto :global(.sv-apertura-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .sv-apertura-velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.55) 0%, rgb(0 0 0 / 0.3) 120px, rgb(0 0 0 / 0) 260px),
      linear-gradient(0deg, rgb(27 22 17 / 0.88) 0%, rgb(27 22 17 / 0.5) 45%, rgb(27 22 17 / 0) 75%);
    pointer-events: none;
  }

  .sv-apertura-testo {
    position: relative;
    z-index: 2;
    padding-top: calc(var(--altezza-header, 146px) + 2rem);
    padding-bottom: clamp(2rem, 6vh, 3.5rem);
  }

  .sv-apertura-testo .eyebrow {
    margin: 0 0 1rem;
  }

  .sv-apertura-titolo {
    max-width: 14ch;
    margin: 0;
    color: var(--color-avorio-su-notte);
  }

  .sv-apertura-frase {
    max-width: 36rem;
    margin: 1rem 0 0;
    color: var(--color-velato-su-notte);
  }

  /* Indice dei servizi in fondo all'apertura. */
  .sv-indice {
    margin-top: clamp(2rem, 6vh, 3.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-avorio-su-notte) 25%, transparent);
  }

  .sv-indice ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sv-indice a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    min-height: 44px;
    padding-block: 0.5rem;
    color: var(--color-avorio-su-notte);
    text-decoration: none;
    transition: color 0.3s var(--ease-gaia);
  }

  .sv-indice a:hover,
  .sv-indice a:focus-visible {
    color: var(--color-oro);
  }

  /* Mobile: la foto prende la parte alta e sfuma nel notte, così il
     testo non copre i volti. */
  @media (max-width: 47.99rem) {
    .sv-apertura-foto {
      inset: 0 0 auto;
      height: 68svh;
    }

    .sv-apertura-velo {
      background:
        linear-gradient(180deg, rgb(0 0 0 / 0.5) 0%, rgb(0 0 0 / 0) 160px),
        linear-gradient(0deg, var(--color-notte) 32svh, rgb(27 22 17 / 0.6) 46svh, rgb(27 22 17 / 0) 62svh);
    }

    .sv-indice a {
      font-size: 0.875rem;
      line-height: 1.3;
    }
  }

  .sv-indice-numero {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-oro);
  }

  @media (min-width: 48rem) {
    .sv-indice ol {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      gap: 0.25rem 2rem;
    }

    /* Il testo sta a sinistra: un velo in più da quel lato. */
    .sv-apertura-velo {
      background:
        linear-gradient(90deg, rgb(27 22 17 / 0.45) 0%, rgb(27 22 17 / 0) 55%),
        linear-gradient(180deg, rgb(0 0 0 / 0.55) 0%, rgb(0 0 0 / 0.3) 120px, rgb(0 0 0 / 0) 260px),
        linear-gradient(0deg, rgb(27 22 17 / 0.88) 0%, rgb(27 22 17 / 0.5) 45%, rgb(27 22 17 / 0) 75%);
    }
  }
</style>
