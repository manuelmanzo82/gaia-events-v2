---
import '../styles/global.css';

import type { Lang } from '../config/site';
import { useTranslations } from '../i18n';
import type { RouteKey } from '../i18n/routes';
import type { Meta } from '../lib/seo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import IntroVelo from '../components/IntroVelo.astro';
import JsonLd from '../components/JsonLd.astro';
import Seo from '../components/Seo.astro';
import type { Crumb } from '../lib/jsonld';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
  meta: Meta;
  slug?: string;
  availableLangs?: readonly Lang[];
  /** Oggetti schema.org della pagina; i null vengono scartati. */
  jsonLd?: unknown[];
  crumbs?: Crumb[];
  /** Intro a velo con il logo che si costruisce (solo la home). */
  intro?: boolean;
  /** Pagina a tutta larghezza: le sezioni gestiscono da sole i contenitori. */
  largo?: boolean;
}

const {
  lang,
  routeKey,
  meta,
  slug,
  availableLangs,
  jsonLd = [],
  crumbs = [],
  intro = false,
  largo = false,
} = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      /**
       * Decide PRIMA del primo paint se l'intro parte, mettendo una classe
       * su <html>: il CSS del velo parte da lì, quindi nessun lampo né del
       * velo quando non deve apparire, né della pagina quando deve.
       * Sta qui, primo elemento di <head>, prima dei fogli di stile. Il velo
       * esiste solo nelle pagine con la prop `intro` (la home): altrove la
       * classe non ha effetto.
       *
       * INTRO_SEMPRE: modalità testing — l'intro parte a OGNI caricamento.
       * Per il lancio rimetterla a false: torna "una volta per sessione".
       */
      (() => {
        var INTRO_SEMPRE = true;
        var vista = false;
        try {
          vista = sessionStorage.getItem('gaia-intro-vista') === '1';
        } catch (e) {
          /* storage bloccato: l'intro parte, ma senza memoria */
        }
        var riduci = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if ((INTRO_SEMPRE || !vista) && !riduci) {
          document.documentElement.classList.add('con-intro');
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <Seo meta={meta} />
    <JsonLd data={jsonLd} />

    {/* Preload dell'elemento LCP e altro di pagina: lo decide chi usa il layout. */}
    <slot name="head" />

    {/* Solo i due variabili principali: corsivo e latin-ext arrivano on demand. */}
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/montserrat-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body>
    {intro && <IntroVelo lang={lang} />}

    <a class="skip-link" href="#main">{t('nav.skipToContent')}</a>

    <Header lang={lang} routeKey={routeKey} slug={slug} availableLangs={availableLangs} />

    <main id="main" class:list={['main', { 'main--largo': largo }]}>
      {crumbs.length > 1 && <Breadcrumbs lang={lang} crumbs={crumbs} />}
      <slot />
    </main>

    <Footer lang={lang} />

    <script>
      import { initMotion } from '../scripts/motion';
      import { initThemeObserver } from '../scripts/theme-observer';

      initMotion();

      const header = document.querySelector<HTMLElement>('.site-header');
      if (header) initThemeObserver(header);
    </script>
  </body>
</html>

<style>
  /* Il header è fisso: le pagine normali lasciano spazio sopra, la home
     (largo) ci passa sotto con l'hero a tutto schermo. */
  .main {
    max-width: 72rem;
    margin-inline: auto;
    padding: calc(var(--altezza-header, 7rem) + 1rem) 1.5rem 2rem;
  }

  .main--largo {
    max-width: none;
    margin: 0;
    padding: 0;
  }

  :global(.breadcrumbs ol) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    font-size: 0.8125rem;
  }

  :global(.breadcrumbs li + li::before) {
    content: '/';
    margin-right: 0.5rem;
    opacity: 0.5;
  }
</style>
