---
// Lo slug degli articoli è tradotto: /magazine/titolo-it ↔ /en/magazine/title-en
import BlogPost from '../../components/pages/BlogPost.astro';
import { getPosts, isPublishable, pick } from '../../lib/content';
import { POST_FIELDS } from '../../lib/availability';
import type { Post } from '../../lib/types';

export function getStaticPaths() {
  return getPosts()
    .filter((post) => isPublishable(post, 'it', POST_FIELDS))
    .map((post) => ({
      params: { slug: pick(post.slug, 'it')! },
      props: { post },
    }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props as Props;
const slug = Astro.params.slug!;
---

<BlogPost lang="it" post={post} slug={slug} />
