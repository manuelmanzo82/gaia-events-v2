---
/**
 * Indici in inglese: servizi, portfolio, recensioni, blog, FAQ.
 *
 * Stanno tutti qui, in una rotta dinamica, perché un file statico verrebbe
 * generato comunque. Con getStaticPaths invece la pagina nasce solo se
 * quell'elenco ha almeno un elemento tradotto in inglese: niente pagine
 * indice vuote, e la pagina ricompare da sola appena arriva la prima
 * traduzione.
 *
 * Le corrispondenti pagine italiane restano file statici: l'italiano è la
 * lingua sorgente e c'è sempre.
 */
import BlogPage from '../../components/pages/BlogPage.astro';
import FaqPage from '../../components/pages/FaqPage.astro';
import PartnersPage from '../../components/pages/PartnersPage.astro';
import PlacesPage from '../../components/pages/PlacesPage.astro';
import PortfolioPage from '../../components/pages/PortfolioPage.astro';
import ReviewsPage from '../../components/pages/ReviewsPage.astro';
import ServicesPage from '../../components/pages/ServicesPage.astro';
import StoriesPage from '../../components/pages/StoriesPage.astro';
import { ROUTES } from '../../i18n/routes';
import { existsIn } from '../../lib/availability';

const INDEXES = [
  'services',
  'portfolio',
  'reviews',
  'blog',
  'faq',
  'places',
  'stories',
  'partners',
] as const;

export function getStaticPaths() {
  // Stesso elenco di INDEXES: getStaticPaths viene estratta dal modulo e
  // non vede le costanti del frontmatter, quindi l'array va ripetuto.
  return (
    ['services', 'portfolio', 'reviews', 'blog', 'faq', 'places', 'stories', 'partners'] as const
  )
    .filter((key) => existsIn(key, 'en'))
    .map((key) => ({ params: { section: ROUTES[key].en }, props: { key } }));
}

interface Props {
  key: (typeof INDEXES)[number];
}

const { key } = Astro.props as Props;
---

{key === 'services' && <ServicesPage lang="en" />}
{key === 'portfolio' && <PortfolioPage lang="en" />}
{key === 'reviews' && <ReviewsPage lang="en" />}
{key === 'blog' && <BlogPage lang="en" />}
{key === 'faq' && <FaqPage lang="en" />}
{key === 'places' && <PlacesPage lang="en" />}
{key === 'stories' && <StoriesPage lang="en" />}
{key === 'partners' && <PartnersPage lang="en" />}
