---
// Lo slug dei matrimoni è tradotto: /matrimoni/titolo-it ↔ /en/weddings/title-en
import StoryDetail from '../../../components/pages/StoryDetail.astro';
import { getStories, isPublishable, pick } from '../../../lib/content';
import { STORY_FIELDS } from '../../../lib/availability';
import type { Story } from '../../../lib/types';

export function getStaticPaths() {
  return getStories()
    .filter((story) => isPublishable(story, 'en', STORY_FIELDS))
    .map((story) => ({
      params: { slug: pick(story.slug, 'en')! },
      props: { story },
    }));
}

interface Props {
  story: Story;
}

const { story } = Astro.props as Props;
const slug = Astro.params.slug!;
---

<StoryDetail lang="en" story={story} slug={slug} />
