# ---------------------------------------------------------------------
# Gaia Events — sito statico su hosting condiviso (Apache)
#
# Questo file viene copiato in dist/ dal build e caricato dal deploy.
# Sostituisce gli header che la v1 aveva in vercel.json.
#
# Non tocca admin/ e uploads/: quelle cartelle hanno regole proprie.
# ---------------------------------------------------------------------

Options -Indexes -MultiViews

DirectoryIndex index.html

# Il build genera 404.html in radice.
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------
# Staging
#
# Sul sottodominio di incognito.work il sito non va indicizzato. L'header
# si attiva da solo in base al dominio, così non serve ricordarsene a mano
# (il build aggiunge già anche il meta robots, vedi IS_STAGING in
# site/src/config/site.ts).
# ---------------------------------------------------------------------
<IfModule mod_setenvif.c>
    SetEnvIf Host "incognito\.work$" STAGING=1
</IfModule>

# ---------------------------------------------------------------------
# File derivati: mai serviti
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blocco dei file derivati PRIMA di ogni altra cosa.
    #
    # Deve stare in mod_rewrite e non in un <FilesMatch>: le sezioni <If>
    # (quella della basic auth, in radice) sono valutate per ultime e hanno
    # la precedenza sull autorizzazione dei <Files>, quindi un "Require all
    # denied" piu in basso verrebbe scavalcato. [F] di mod_rewrite no.
    #
    # Serve a non servire come TESTO un file che non e piu PHP:
    # config.php.bak-20261014 conterrebbe le credenziali del database.
    RewriteRule "(^|/)\.env|\.bak|\.php\.|\.(sql|log|orig|old|save|ini|sh)$" - [F,L]
</IfModule>

# ---------------------------------------------------------------------
# Header di sicurezza
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # Noindex automatico in staging.
    Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=STAGING

    # HSTS: attivarlo SOLO quando il dominio definitivo è su HTTPS stabile.
    # Una volta inviato, i browser lo ricordano per un anno.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # -----------------------------------------------------------------
    # Content Security Policy
    #
    # Rispetto alla v1: via Sanity (i contenuti arrivano dal nostro PHP) e
    # via Web3Forms (i form vanno al nostro endpoint, quindi form-action
    # resta 'self'). Instagram non serve: le immagini del feed vengono
    # scaricate in /uploads/ e servite dal nostro dominio.
    #
    # script-src tiene 'unsafe-inline' perché il CSP si applica anche ai
    # blocchi <script type="application/ld+json"> del JSON-LD.
    # Niente 'unsafe-eval': il sito è statico e non ne ha bisogno.
    #
    # Se un giorno aggiungiamo Google Analytics o Tag Manager, i domini
    # vanno aggiunti qui in script-src, img-src e connect-src, altrimenti
    # lo script viene bloccato senza errori visibili.
    # -----------------------------------------------------------------
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self'; connect-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# ---------------------------------------------------------------------
# Compressione
# ---------------------------------------------------------------------
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS application/xml application/rss+xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# Tipi MIME che gli hosting condivisi spesso non conoscono
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
    AddCharset UTF-8 .html .css .js .json .xml .txt .svg
</IfModule>

# ---------------------------------------------------------------------
# Cache
#
# Gli asset di Astro hanno l'hash nel nome, quindi possono stare in cache
# per un anno. L'HTML no: deve cambiare appena pubblichiamo.
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/plain "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 hour"

    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/avif "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
</IfModule>

<IfModule mod_headers.c>
    # File con hash nel nome: immutabili.
    <FilesMatch "\.[0-9a-zA-Z_-]{8,}\.(css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML e file di testo generati: sempre riverificati.
    <FilesMatch "\.(html|txt|xml)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    # I font self-hosted possono servire a pagine su altri sottodomini.
    <FilesMatch "\.woff2$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------
# File che non devono MAI essere scaricabili
#
# Non basta elencare i nomi noti: il pericolo sono i file derivati, quelli
# che nascono accanto a un file buono e ne conservano il contenuto senza
# piu' essere eseguiti. Un config.php.bak-20261014 e' PHP che Apache serve
# come testo, credenziali del database comprese.
#
# Per questo si bloccano anche i doppi suffissi (qualcosa.php.altro) e
# qualunque nome che contenga .bak, non solo quelli che ci finiscono.
# ---------------------------------------------------------------------
<FilesMatch "(^\.env|^config.*\.php$|\.bak|\.(sql|log|orig|old|save|ini|sh)$|\.php\.)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------
# Protezione con password dello staging
#
# Vale SOLO sui domini incognito.work: in produzione il blocco non viene
# nemmeno valutato, quindi questo stesso file va bene per entrambi gli
# ambienti e sopravvive ai deploy, che lo riscrivono ogni volta.
#
# Il file delle password sta FUORI dalla cartella pubblica, un livello
# sopra /gaia-staging, e il nome inizia per .ht così la configurazione
# globale di Apache lo nega comunque.
#
# Unica eccezione: admin/api/export.php, che la GitHub Action deve poter
# chiamare e che non ha modo di presentare queste credenziali. È già
# protetto dal suo bearer token: senza, risponde 401 da solo.
#
# L'eccezione sta QUI dentro, nella stessa condizione, e non in un
# <Files> dentro admin/api/: le sezioni <If> vengono valutate per ultime e
# hanno la precedenza su <Files> e <Directory>, quindi un'eccezione
# dichiarata più in basso verrebbe semplicemente ignorata.
# ---------------------------------------------------------------------
<If "%{HTTP_HOST} =~ /incognito\.work$/ && %{REQUEST_URI} !~ m#^/admin/api/export\.php$#">
    AuthType Basic
    AuthName "Anteprima Gaia Events"
    AuthUserFile /kunden/homepages/30/d593572430/htdocs/.htpasswd-gaia-staging
    Require valid-user
</If>
