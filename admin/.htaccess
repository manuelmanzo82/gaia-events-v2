# ---------------------------------------------------------------------
# Back office — Apache
#
# Due compiti: mandare tutto a index.php e impedire l'accesso diretto a
# configurazione, codice e template.
# ---------------------------------------------------------------------

Options -Indexes -MultiViews

# Senza questa riga la richiesta di /admin/ si ferma sulla cartella e Apache
# risponde 403, perche' l'elenco dei file e' disattivato.
DirectoryIndex index.php

# Il back office non va mai indicizzato, in nessun ambiente.
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Cache-Control "no-store, must-revalidate"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Indispensabile su IONOS, e in generale su ogni hosting dove la DOCUMENT_ROOT
    # vista da Apache non coincide con il percorso fisico (qui /kunden/homepages/...
    # contro /homepages/...). Senza, la riscrittura verso index.php viene risolta
    # sul filesystem, non trova nulla e la richiesta cade nel 404 del sito.
    #
    # DEVE corrispondere a 'base_path' in config.php, con lo slash finale.
    RewriteBase /admin/

    # Blocco dei file derivati PRIMA di ogni altra cosa.
    #
    # Deve stare in mod_rewrite e non in un <FilesMatch>: le sezioni <If>
    # (quella della basic auth, in radice) sono valutate per ultime e hanno
    # la precedenza sull autorizzazione dei <Files>, quindi un "Require all
    # denied" piu in basso verrebbe scavalcato. [F] di mod_rewrite no.
    #
    # Serve a non servire come TESTO un file che non e piu PHP:
    # config.php.bak-20261014 conterrebbe le credenziali del database.
    RewriteRule "(^|/)\.env|\.bak|\.php\.|\.(sql|log|orig|old|save|ini|sh)$" - [F,L]

    # Su CGI e FastCGI Apache NON passa l'header Authorization a PHP, per
    # non esporre le credenziali a ogni script. Ma a api/export.php quel
    # bearer token serve: lo ricopiamo in una variabile d'ambiente, che lo
    # script legge come REDIRECT_HTTP_AUTHORIZATION.
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Cartelle che non devono essere raggiungibili dal web: la
    # configurazione, le classi, i template, gli script CLI e lo schema.
    RewriteRule ^(src|views|bin|sql|storage)(/|$) - [F,L]

    # File esistenti (gli endpoint in api/, eventuali asset) serviti così come sono.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tutto il resto al front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Doppia sicurezza se mod_rewrite non è attivo, e soprattutto blocco dei
# file derivati: un config.php.bak-20261014 non e' piu' PHP per Apache, che
# lo servirebbe come testo con dentro le credenziali del database.
<FilesMatch "(^\.env|^config.*\.php$|\.bak|\.(sql|log|orig|old|save|ini|sh)$|\.php\.)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Gli upload del back office possono essere grandi: foto da fotografo.
<IfModule mod_php.c>
    php_value upload_max_filesize 16M
    php_value post_max_size 20M
    php_value memory_limit 256M
</IfModule>
