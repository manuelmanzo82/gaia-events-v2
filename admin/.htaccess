# ---------------------------------------------------------------------
# Back office — Apache
#
# Due compiti: mandare tutto a index.php e impedire l'accesso diretto a
# configurazione, codice e template.
# ---------------------------------------------------------------------

Options -Indexes -MultiViews

# Il back office non va mai indicizzato, in nessun ambiente.
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Cache-Control "no-store, must-revalidate"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Cartelle che non devono essere raggiungibili dal web: la
    # configurazione, le classi, i template, gli script CLI e lo schema.
    RewriteRule ^(src|views|bin|sql|storage)(/|$) - [F,L]

    # File esistenti (gli endpoint in api/, eventuali asset) serviti così come sono.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tutto il resto al front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Doppia sicurezza se mod_rewrite non è attivo.
<FilesMatch "^(config.*\.php|.*\.sql|.*\.log|composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Gli upload del back office possono essere grandi: foto da fotografo.
<IfModule mod_php.c>
    php_value upload_max_filesize 16M
    php_value post_max_size 20M
    php_value memory_limit 256M
</IfModule>
